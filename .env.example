# Z9Client configuration
# Copy this file to .env (git-ignored) and fill in the values.

# IP address or hostname of the Z9 on the network
Z9_HOST=192.168.1.50

# Admin password (shown on the Z9 screen:
# Menu -> Connectivity -> EWS configuration -> show password).
# Required for protected endpoints: admin settings (PIWS) AND the print-job
# queue / job previews. Leave empty if you don't need those features
# (status, paper, printing and profiling work without it).
Z9_ADMIN_PWD=

# Default network timeout, in seconds (optional)
Z9_TIMEOUT=10
