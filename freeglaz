                print(f"    medium_list_version remote: {m.get('remote_version')}")
            print(f"    last_sync_at  : {m.get('last_sync_at') or '— (never synced)'}")
            print(f"    papers        : {m['n_papers']}")
            print(f"    profiles      : {n_tot} ({n_fac} factory, {n_cus} custom)")
            print(f"    state         : {sync_str}")
            if m.get("remote_error"):
                print(f"    {C.DIM}remote note : {m['remote_error']}{C.R}")
        print()
    else:
        print(f"{C.DIM}No mirror synced yet.{C.R}")
        print(f"{C.DIM}→ Run: freeglaz store sync (Z9 must be reachable){C.R}")
