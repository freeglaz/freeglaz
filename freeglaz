            pass_number=args.pass_number,
            output_ti1=output_ti1,
            output_sidecar=output_sidecar,
            paper=args.paper,
            hp_skintones_csv=hp_csv,
        )
    except (ValueError, RuntimeError) as e:
        err(f"Generation failed: {type(e).__name__}: {e}")
        return 1

    print(f"{C.GREEN}✅ Multipass chart generated{C.R}")
    print(f"   • Patches : {result['n_patches']} "
          f"({result['n_cube']} cube + {result['n_extras']} extras)")
