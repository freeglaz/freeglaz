# Restore default UNIX behavior for SIGPIPE: when a downstream pipe is
# closed (e.g. ./freeglaz paper raw | head), Python terminates silently
# instead of raising BrokenPipeError. This is what cat, grep, curl, etc. do.
# Without this, we get an ugly stacktrace as soon as we pipe to head/less/etc.
try:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError):
    # Windows has no SIGPIPE, and some contexts refuse to set it
    pass

