def cmd_paper_create(args, client):
    """
    Create a custom paper by cloning an existing donor.

    Usage:
        freeglaz paper create "Name" --donor <id|hex|name>
        freeglaz paper create "Test" --donor 2090
        freeglaz paper create "Test" --donor 9E489F02AE027F9DD93191D872728C1D
        freeglaz paper create "Test" --donor "Photo Gloss"
    """
    name = args.name.strip()
    if not name:
        err("The paper name cannot be empty")
        return 1

    # Pre-validation: does a custom paper already exist with this name?
    try:
        existing = client.paper.get_by_name(name, exact=True)
        if existing:
            existing_paper = existing[0]
            err(f"A paper with this exact name already exists:")
            print(f"  {existing_paper['id']} : {existing_paper['name']}",
                  file=sys.stderr)
            if not args.force:
                print(f"\n  Use --force to create anyway.",
                      file=sys.stderr)
                return 1
    except Z9Error as e:
        err(f"Verification failed: {e}")
        return 1

    # Resolve the donor before asking for confirmation
    # (interactive handling if the name is ambiguous, e.g. "Photo")
    donor_paper = resolve_paper_interactive(client, args.donor)
    if not donor_paper:
        return 1

    # User confirmation (unless --yes)
    print(f"{C.BOLD}Creating a custom paper{C.R}")
    print(f"  Name       : {C.GREEN}{name}{C.R}")
    print(f"  Donor      : {donor_paper['name']}")
    print(f"               {C.DIM}{donor_paper['id']} ({donor_paper['category_id']}){C.R}")
    print(f"  Language   : {args.language}")
    print()

    if not args.yes:
        if not sys.stdin.isatty():
            err("Non-interactive (no tty), use --yes to confirm")
            return 1
        try:
            confirm = input("Confirm? [y/N]: ").strip().lower()
        except EOFError:
            return 1
        if confirm not in ("y", "yes", "o", "oui"):
            warn("Cancelled")
            return 0

    # Creation (we pass the resolved ID to avoid re-resolution / ambiguity)
    try:
        result = client.paper.create(
            name=name,
            donor=donor_paper["id"],
            language=args.language,
        )
    except Z9Error as e:
        err(f"Creation failed: {e}")
        return 1

    print()
    ok(f"Paper created: {result['name']}")
    print(f"  New MediumId     : {C.GREEN}{result['id'] or '(not parsed in response)'}{C.R}")
    print(f"  Donor used       : {result['donor_name']} ({result['donor_id']})")
    print()
    print(f"  Next steps:")
    print(f"    {C.DIM}freeglaz paper calibrate {result['id'] or '<id>'}{C.R}")
    print(f"    {C.DIM}freeglaz paper scan-only {result['id'] or '<id>'} -o profile.icc{C.R}")
    return 0


def cmd_paper_delete(args, client):
    """
    Delete a custom paper from the Z9.

    Usage:
        freeglaz paper delete <id|hex|name>
        freeglaz paper delete freeglaz_TEST_xxx
        freeglaz paper delete 4F83CB69A17FE6CCB314B51AEC38DCF1
    """
    # Resolve the reference (interactive handling of ambiguities)
    paper = resolve_paper_interactive(client, args.id_or_name)
    if not paper:
        return 1
    print()

    # Guard: factory
    if paper.get("is_factory", False):
        err(f"Refusing to delete a factory paper: '{paper['name']}'")
        return 1

    # Check that it is not loaded
    try:
        loaded_id = client.device.loaded_media_id()
        if loaded_id == paper["id"]:
            err(f"'{paper['name']}' is currently loaded on the roll, "
                f"unload it before deleting it")
            return 1
    except Exception:
        pass

    # Confirmation
    print(f"{C.BOLD}Deleting a custom paper{C.R}")
    print(f"  Name       : {C.RED}{paper['name']}{C.R}")
    print(f"  Id         : {C.DIM}{paper['id']}{C.R}")
    print(f"  Category   : {paper['category_id']}")
    print()
    print(f"  {C.YELLOW}⚠️  This action is IRREVERSIBLE.{C.R}")
    print(f"     The associated ICC profile will also be deleted.")
    print()

    if not args.yes:
        if not sys.stdin.isatty():
            err("Non-interactive (no tty), use --yes to confirm")
            return 1
        try:
            confirm = input(f"Type the exact name to confirm (or ⏎ to cancel): ").strip()
        except EOFError:
            return 1
        if confirm != paper["name"]:
            warn("Cancelled (name not confirmed)")
            return 0

    # Deletion
    try:
        result = client.paper.delete(paper["id"])
    except Z9Error as e:
        err(f"Deletion failed: {e}")
        return 1

    print()
    ok(f"Paper deleted: {result['name']}")
    # Sync-on-event (#1): the medium was deleted on the Z9 → forget the
    # paper in the mirror (purge + removal from index). Best-effort.
    try:
        from lib.z9_client import store as _store
        _store.forget_paper(client, result.get("name") or paper.get("name"))
    except Exception as _e:  # noqa: BLE001
        warn(f"Mirror not cleaned (targeted forget failed): {_e}")
    return 0


# Friendly labels for the CLC workflow states
_CALIBRATION_PHASES = {
    "PREPARING-TO-PRINT":   ("preparing print",       C.DIM),
    "PRINTING":             ("printing",              C.CYAN),
    "DRYING":               ("drying",                C.YELLOW),
    "PREPARING-TO-SCAN":    ("preparing scan",        C.DIM),
    "SCANNING":             ("spectro scan",          C.CYAN),
    "CALCULATING":          ("computing curves",      C.YELLOW),
    "DONE":                 ("done",                  C.GREEN),
    "FAILED":               ("failed",                C.RED),
}


def cmd_paper_calibrate(args, client):
    """
    Run a CLC (Color Linearization Calibration) on a paper.

    Blocking: the CLI waits for the end of the workflow (~5-10 min depending
    on paper). Sequential log: 1 line per poll.

    Usage:
        freeglaz paper calibrate <id|hex|name>
        freeglaz paper calibrate "Hahnemühle Baryta"
        freeglaz paper calibrate 355783D031D38CD4F1D8B8426FE3C51A
    """
    # Resolve the reference (interactive handling of ambiguities)
    paper = resolve_paper_interactive(client, args.id_or_name)
    if not paper:
        return 1
    print()  # Line break after interactive menu if present

    # Header
    print(f"{C.BOLD}🔧 Calibration (CLC){C.R}")
    print(f"  Paper        : {paper.get('name', '?')}")
    print(f"  MediumId     : {C.DIM}{paper['id']}{C.R}")
    if paper.get("category_id"):
        print(f"  Category     : {paper['category_id']}")
    print(f"  {C.YELLOW}⏱  ~5-10 min, ties up the printer, non-interruptible once started.{C.R}")
    print()

    # User confirmation (unless --yes): a CLC is a long machine op → no silent
    # launch (parity with the webapp CLC confirmation).
    if not args.yes:
        if not sys.stdin.isatty():
            err("Non-interactive (no tty), use --yes to confirm")
            return 1
        try:
            confirm = input("Launch the CLC? [y/N]: ").strip().lower()
        except EOFError:
            return 1
        if confirm not in ("y", "yes", "o", "oui"):
            warn("Cancelled")
            return 0
    print()

    # Launch
    print(f"  {C.DIM}Launching newCalibration...{C.R}")

    # Callback to display progress
    last_print_state = {"process": None, "percent": None}

    def on_progress(status):
        """One line per state change OR per poll."""
        import datetime as _dt
        ts = _dt.datetime.now().strftime("%H:%M:%S")
        process = status["process"]
        percent = status["percent"]
        label, color = _CALIBRATION_PHASES.get(process, (process, C.R))

        pct_str = f"{percent:3d}%" if percent >= 0 else "  - "
        # Display: 1 line per poll
        print(f"  {C.DIM}{ts}{C.R}  {color}{process:<22s}{C.R}  {pct_str}  "
              f"{C.DIM}({label}){C.R}")

    # Execution
    try:
        result = client.paper.calibrate(
            ref=paper["id"],  # resolved ID (avoids re-resolution / ambiguity)
            on_progress=on_progress,
            poll_interval=args.interval,
            timeout=args.timeout,
        )
    except Z9CalibrationTimeout as e:
        print()
        err_structured("Calibration: timeout", [
            ("Code", e.code or "TIMEOUT"),
            ("Reason", str(e)),
            ("Next", f"The calibration probably continues on the Z9.\n"
                     f"Check the state with: freeglaz paper show {paper['id']}"),
        ])
        return 2
    except Z9CalibrationError as e:
        print()
        fields = [
            ("Code", e.code or "?", C.YELLOW),
            ("Reason", e.description or str(e)),
        ]
        if e.context:
            ctx_paper_name = e.context.get("paper_name") or "?"
            ctx_paper_id = e.context.get("paper_id") or "?"
            ctx_phase = e.context.get("phase")
            fields.append(("Paper", f"{ctx_paper_name}\n{C.DIM}{ctx_paper_id}{C.R}"))
            if ctx_phase:
                fields.append(("Phase", ctx_phase))
        err_structured("Calibration refused", fields)
        return 1
    except KeyboardInterrupt:
        print()
        warn("Keyboard interrupt")
        print(f"  {C.DIM}The calibration continues on the Z9 and cannot be")
        print(f"  cancelled remotely. Come back and check with:")
        print(f"    freeglaz paper show {paper['id']}{C.R}")
        return 130
    except Z9Error as e:
        err(f"Error: {e}")
        return 1

    # Final recap
    elapsed = result["elapsed"]
    m, s = divmod(int(elapsed), 60)
    print()
    ok(f"Calibration succeeded in {m}m{s:02d}s")
    print(f"  Operation ID : {result['operation_id']}")
    print(f"  Stored date  : {C.GREEN}{result['calibration_date']}{C.R}")
    state_color = C.GREEN if result["calibration_valid"] else C.YELLOW
    state_label = "VALID" if result["calibration_valid"] else "OBSOLETE"
    print(f"  State        : {state_color}{state_label}{C.R}")
    # Sync-on-event (#1): the CLC changed the paper state → forced refetch
    # of the paper in the mirror (best-effort).
    try:
        from lib.z9_client import store as _store
        _store.refetch_paper(client, paper["id"])
    except Exception as _e:  # noqa: BLE001
        warn(f"Mirror not refreshed (targeted sync failed): {_e}")
    return 0


def cmd_paper_inspect_icc(args, client):
    """Inspect an ICC profile (local file or extracted from the Z9)."""
    from lib.z9_client.inspect import InspectOps
    from pathlib import Path as _Path

    target = args.icc_input
    icc_path = _Path(target)

    if not icc_path.exists():
        if client:
            try:
                import tempfile
                paper = resolve_paper_interactive(client, target)
                if not paper:
                    return 1
                ge_state = "on" if args.ge_slot == "on" else "off"
                tmp = tempfile.NamedTemporaryFile(suffix=".icc", delete=False)
                tmp.close()
                icc_path = _Path(tmp.name)
                client.paper.export_icc(paper["id"], ge_state, str(icc_path))
                info(f"ICC extracted from Z9: {paper['name']} (GE {ge_state.upper()})")
            except Exception as e:
                err(f"ICC extraction from Z9 failed: {e}")
                return 1
        else:
            err(f"File not found: {target}")
            return 1

    ops = InspectOps()
    try:
        insp = ops.inspect_icc_file(icc_path)
    except Exception as e:
        err(f"Inspection failed: {e}")
        return 1

    if args.json:
        print(json.dumps(ops.to_dict(insp), indent=2, ensure_ascii=False))
    elif args.dump_hp91:
        if insp.hp91_raw:
            _Path(args.dump_hp91).write_text(insp.hp91_raw, encoding='utf-8')
            ok(f"Decompressed HP91 written to {args.dump_hp91}")
        else:
            warn("No HP91 tag in this profile")
    else:
        print(ops.format_console(insp, short=args.short))

    return 0


def cmd_paper_profile(args, client):
    """
    Run a full ICC profiling workflow (PRINT_AND_SCAN).

    Blocking ~10 min. Reproduces the Z9's native profiling workflow.

    Usage:
        freeglaz paper profile <id|hex|name>
        freeglaz paper profile "Hahnemühle Baryta" --gloss-enhancer OFF
        freeglaz paper profile <id> --quality NORMAL --max-detail ON
    """
    # Resolve the reference (interactive handling if ambiguous)
    paper = resolve_paper_interactive(client, args.id_or_name)
    if not paper:
        return 1
    print()

    # Load the full details via SOAP (to check the paper's capabilities)
    try:
        paper_details = client.paper.details(paper["id"])
    except Z9Error as e:
        err(f"Cannot read the paper details: {e}")
        return 1

    if not paper_details:
        err(f"Paper {paper['id']} not found in getMediumList SOAP")
        return 1

    # Check whether the paper supports the Gloss Enhancer
    capabilities = paper_details.get("capabilities") or {}
    ge_supported = capabilities.get("GlossEnhancerSupported") == "1"

    # If Gloss Enhancer not specified, ask interactively (filtered by capabilities)
    gloss_enhancer = args.gloss_enhancer
    if gloss_enhancer is None:
        if not sys.stdin.isatty():
            err("--gloss-enhancer required in non-interactive mode "
                "(values: FULLPAGE | OFF)")
            return 1
        print(f"{C.BOLD}Gloss Enhancer?{C.R}")
        if ge_supported:
            print(f"  {C.GREEN}1{C.R}. FULLPAGE  (HP default, full-page varnish)")
            print(f"  {C.GREEN}2{C.R}. OFF       (no varnish)")
            try:
                choice = input("Choice [1/2] (default: 1): ").strip() or "1"
            except EOFError:
                return 1
            if choice == "1":
                gloss_enhancer = "FULLPAGE"
            elif choice == "2":
                gloss_enhancer = "OFF"
            else:
                err(f"Invalid choice: {choice}")
                return 1
        else:
            print(f"  {C.DIM}This paper does not support the Gloss Enhancer "
                  f"(GlossEnhancerSupported=0).{C.R}")
            print(f"  {C.DIM}Forced to: OFF{C.R}")
            gloss_enhancer = "OFF"
        print()
    else:
        # GE specified on CLI: check that it is compatible
        if gloss_enhancer == "FULLPAGE" and not ge_supported:
            err(f"The paper '{paper['name']}' does not support "
                f"the Gloss Enhancer (GlossEnhancerSupported=0).")
            print(f"  {C.DIM}Use --gloss-enhancer OFF "
                  f"or choose another paper.{C.R}",
                  file=sys.stderr)
            return 1

    # Build / resolve the profile_name
    profile_name = args.profile_name
    if profile_name is None:
        paper_no_spaces = paper["name"].replace(" ", "")
        if gloss_enhancer == "FULLPAGE":
            profile_name = f"HP_{paper_no_spaces}_GEON, GE ON"
        else:
            profile_name = f"HP_{paper_no_spaces}_GEOFF, GE OFF"

    workflow = args.workflow

    # Header
    print(f"{C.BOLD}🎨 ICC Profiling ({workflow}){C.R}")
    print(f"  Paper          : {paper['name']}")
    print(f"  MediumId       : {C.DIM}{paper['id']}{C.R}")
    print()
    print(f"  {C.CYAN}Parameters:{C.R}")
    print(f"    Workflow       : {workflow}")
    print(f"    Quality        : {args.quality}")
    print(f"    Gloss Enhancer : {gloss_enhancer}")
    print(f"    Maximum Detail : {args.max_detail}")
    print(f"    Color Space    : {args.color_space}")
    print(f"    Profile name   : {profile_name}")
    print()
    _WORKFLOW_ETA = {
        "PRINT_AND_SCAN": "~10 minutes (print + drying + scan + compute)",
        "PRINT_ONLY": "~2 minutes (chart print only)",
        "SCAN_ONLY": "~7 minutes (scan + ICC compute)",
    }
    print(f"  {C.YELLOW}⏱  Estimated time: {_WORKFLOW_ETA.get(workflow, '?')}{C.R}")
    if args.export:
        print(f"  {C.CYAN}ICC export     : {args.export}{C.R}")
    print()

    # User confirmation (unless --yes)
    if not args.yes:
        if not sys.stdin.isatty():
            err("Non-interactive (no tty), use --yes to confirm")
            return 1
        try:
            confirm = input("Confirm? [y/N]: ").strip().lower()
        except EOFError:
            return 1
        if confirm not in ("y", "yes", "o", "oui"):
            warn("Cancelled")
            return 0
        print()

    # Progress callback (sequential log like calibrate)
    def on_progress(status):
        import datetime as _dt
        ts = _dt.datetime.now().strftime("%H:%M:%S")
        process = status["process"]
        percent = status["percent"]
        label, color = _CALIBRATION_PHASES.get(process, (process, C.R))
        pct_str = f"{percent:3d}%" if percent >= 0 else "  - "
        print(f"  {C.DIM}{ts}{C.R}  {color}{process:<22s}{C.R}  {pct_str}  "
              f"{C.DIM}({label}){C.R}")

    print(f"  {C.DIM}Launching newProfile (workflow {workflow})...{C.R}")

    # Execution
    try:
        result = client.paper.profile(
            ref=paper["id"],
            gloss_enhancer=gloss_enhancer,
            quality=args.quality,
            max_detail=args.max_detail,
            color_space=args.color_space,
            profile_name=profile_name,
            workflow_kind=workflow,
            on_progress=on_progress,
            poll_interval=args.interval,
            timeout=args.timeout,
        )
    except Z9CalibrationTimeout as e:
        print()
        err_structured("Profiling: timeout", [
            ("Code", e.code or "TIMEOUT"),
            ("Reason", e.description or str(e)),
            ("Next", f"The workflow probably continues on the Z9.\n"
                     f"Check the state with: freeglaz paper show {paper['id']}"),
        ])
        return 2
    except Z9CalibrationError as e:
        print()
        fields = [
            ("Code", e.code or "?", C.YELLOW),
            ("Reason", e.description or str(e)),
        ]
        if e.context:
            ctx_paper_name = e.context.get("paper_name") or "?"
            ctx_paper_id = e.context.get("paper_id") or "?"
            ctx_phase = e.context.get("phase")
            fields.append(("Paper", f"{ctx_paper_name}\n{C.DIM}{ctx_paper_id}{C.R}"))
            if ctx_phase:
                fields.append(("Phase", ctx_phase))
        err_structured("Profiling refused", fields)
        return 1
    except KeyboardInterrupt:
        print()
        warn("Keyboard interrupt")
        print(f"  {C.DIM}The profiling continues on the Z9 and cannot be")
        print(f"  cancelled remotely. Come back and check with:")
        print(f"    freeglaz paper show {paper['id']}{C.R}")
        return 130
    except Z9Error as e:
        err(f"Error: {e}")
        return 1

    # Final recap
    elapsed = result["elapsed"]
    m, s = divmod(int(elapsed), 60)
    print()
    ok(f"Profiling succeeded in {m}m{s:02d}s")
    print(f"  Operation ID   : {result['operation_id']}")
    print(f"  Profile name   : {C.GREEN}{result['profile_name']}{C.R}")
    print(f"  Internal ICC   : {result.get('profile_icc_name') or '?'}")
    print(f"  UUID           : {C.DIM}{result.get('profile_uuid') or '?'}{C.R}")
    print(f"  Date           : {result.get('profile_date') or '?'}")

    # Local export if requested
    if args.export:
        print()
        print(f"  {C.DIM}Exporting ICC to {args.export}...{C.R}")
        try:
            export_result = client.paper.export_icc(
                ref=paper["id"],
                output_path=args.export,
                gloss_enhancer=gloss_enhancer,
                quality=args.quality,
                color_space=args.color_space,
            )
        except Z9Error as e:
            err(f"ICC export failed: {e}")
            print(f"  {C.DIM}The profile remains available on the Z9. "
                  f"You can retry with:{C.R}")
            print(f"    {C.DIM}freeglaz paper export-icc \"{paper['name']}\" "
                  f"-o {args.export}{C.R}")
            return 1
        size_kb = export_result["size_bytes"] / 1024
        ok(f"ICC exported: {export_result['output_path']} ({size_kb:.1f} KB)")
        print(f"  MD5           : {C.DIM}{export_result.get('md5')}{C.R}")

    # Sync-on-event (#1): the profiling changed the slot's profile →
    # forced refetch of the paper in the mirror (best-effort, does not fail the cmd).
    try:
        from lib.z9_client import store as _store
        _store.refetch_paper(client, paper["id"])
    except Exception as _e:  # noqa: BLE001
        warn(f"Mirror not refreshed (targeted sync failed): {_e}")
    return 0


def cmd_paper_scan_only(args, client):
    """
    Run a SCAN_ONLY workflow: measure a pre-printed custom chart.

    Difference from `paper profile` (PRINT_AND_SCAN): the Z9 DOES NOT PRINT its
