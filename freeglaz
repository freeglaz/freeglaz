def _sanitize_copyright_ascii(s: str) -> tuple[str, bool]:
    """
    Sanitize a string for the ICC `cprt` tag (Argyll colprof compatible).

    Argyll writes the `cprt` tag as `descASCII` (strict ASCII encoding). Any
    non-ASCII character passed via `-C` is replaced with '?' on writing.
    To preserve the user's intent, we apply a reasonable mapping of common
    characters BEFORE the colprof call:
        © → (c)   ® → (R)   ™ → (TM)
        É → E     é → e     à → a     ç → c    (etc., French accents)
        — — – → -    "" "" « » → "    … → ...

    Characters not covered by the mapping and non-ASCII are replaced with
    '?' (Argyll default behavior, so neutral).

    Returns:
        (sanitized string, was_modified)
    """
    if s.isascii():
        return s, False

    replacements = {
        # Legal symbols
        "©": "(c)", "®": "(R)", "™": "(TM)", "℠": "(SM)",
        # Dashes, ellipsis
        "—": "-", "–": "-", "…": "...",
        # Quotation marks
        "« ": '"', " »": '"', "«": '"', "»": '"',
        "\u201C": '"', "\u201D": '"',
        "\u2018": "'", "\u2019": "'",
        # French accented vowels
        "à": "a", "â": "a", "ä": "a", "á": "a", "ã": "a",
        "é": "e", "è": "e", "ê": "e", "ë": "e",
        "ì": "i", "í": "i", "î": "i", "ï": "i",
        "ò": "o", "ó": "o", "ô": "o", "ö": "o", "õ": "o",
        "ù": "u", "ú": "u", "û": "u", "ü": "u",
        "ç": "c", "ñ": "n", "ÿ": "y",
        "À": "A", "Â": "A", "Ä": "A", "Á": "A",
        "É": "E", "È": "E", "Ê": "E", "Ë": "E",
        "Ì": "I", "Í": "I", "Î": "I", "Ï": "I",
        "Ò": "O", "Ó": "O", "Ô": "O", "Ö": "O",
        "Ù": "U", "Ú": "U", "Û": "U", "Ü": "U",
        "Ç": "C", "Ñ": "N",
        # Non-breaking space
        "\u00A0": " ",
    }

    result = s
    for old, new in replacements.items():
        result = result.replace(old, new)

    # Fallback: strip remaining non-ASCII characters
    if not result.isascii():
        result = result.encode("ascii", errors="replace").decode("ascii")

    return result, True


def _wrap_lines(text, width=68, indent=""):
    """
    Split a long text into readable lines, respecting word boundaries.
    Indents each line except the first.

    Preserves explicit line breaks (\\n) already present.
    """
    import textwrap
    out = []
    for paragraph in (text or "").split("\n"):
        if not paragraph:
            out.append("")
            continue
        wrapped = textwrap.wrap(paragraph, width=width) or [""]
        out.extend(wrapped)
    return f"\n{indent}".join(out)


def err_structured(title, fields):
    """
    Display a structured error with a title and hierarchical fields.

    :param title: short title (e.g. "Calibration refused")
    :param fields: list of (label, value, color_optional) tuples
                   value may contain \\n and will be wrapped cleanly

    Displays on stderr:
        ❌ Calibration refused
           Code     : NO-MEDIUM-LOADED
           Reason   : No paper loaded in the Z9.
                      Load a sheet...
           Paper    : Hahnemühle Fine Art Baryta Satin
    """
    print(f"{C.RED}❌ {title}{C.R}", file=sys.stderr)
    # Alignment calculation
    label_width = max((len(label) for label, _, *_ in fields), default=0)
    indent = "   " + " " * (label_width + 3)
    for entry in fields:
        if len(entry) == 3:
            label, value, color = entry
        else:
            label, value = entry
            color = ""
        wrapped = _wrap_lines(str(value), width=68, indent=indent)
        print(f"   {C.DIM}{label:<{label_width}}{C.R} : "
              f"{color}{wrapped}{C.R if color else ''}",
              file=sys.stderr)


