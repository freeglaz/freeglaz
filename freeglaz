def cmd_jobs_cleanup_previews(args, client):
    """Manages freeglaz thumbnails.

    Without options: displays stats (file count, total size, oldest /
    newest). Deletes nothing.

    With ``--older-than DAYS``: deletes thumbs created more than DAYS days
    ago **and** purges the job_mapping entries that pointed to them.
    ``--dry-run`` shows what would be deleted without acting.

    ``client`` (Z9Client) is ignored: pure local filesystem operation.
    """
    import datetime as _dt
    from webapp.backend.services import job_mapping, job_preview

    thumbs = job_preview.list_thumbnails()
    now = _dt.datetime.now()

    if not thumbs:
        print(f"{C.DIM}No thumbnail in {job_preview.PREVIEWS_DIR}{C.R}")
        print(f"{C.DIM}(The folder will be created on the 1st submit via the webapp.){C.R}")
        return 0

    # Global stats
    total_bytes = sum(p.stat().st_size for p in thumbs)
    mtimes = [p.stat().st_mtime for p in thumbs]
    oldest = _dt.datetime.fromtimestamp(min(mtimes))
    newest = _dt.datetime.fromtimestamp(max(mtimes))
    mapping_size = len(job_mapping.all_entries())

    print(f"{C.BOLD}freeglaz thumbnails{C.R}")
    print(f"  Folder          : {job_preview.PREVIEWS_DIR}")
    print(f"  Files           : {len(thumbs)}")
    print(f"  Total size      : {_fmt_bytes(total_bytes)}")
    print(f"  Oldest          : {oldest.strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"  Newest          : {newest.strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"  Mapping entries : {mapping_size}")

    if args.older_than is None:
        print()
        print(f"{C.DIM}To clean up: freeglaz jobs cleanup-previews "
              f"--older-than DAYS [--dry-run]{C.R}")
        return 0

    if args.older_than < 0:
        err("--older-than must be >= 0")
        return 2

    cutoff = now - _dt.timedelta(days=args.older_than)
    to_delete = [
        p for p in thumbs
        if _dt.datetime.fromtimestamp(p.stat().st_mtime) < cutoff
    ]

    print()
    print(
        f"{C.BOLD}Deleting thumbs > {args.older_than} day"
        f"{'s' if args.older_than > 1 else ''}{C.R}"
    )
    print(f"  Threshold   : {cutoff.strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"  To delete   : {len(to_delete)} file(s)")

    if not to_delete:
        return 0

    if args.dry_run:
        print(f"\n{C.YELLOW}[DRY-RUN] no file deleted.{C.R}\n")
        for p in to_delete[:20]:
            mtime = _dt.datetime.fromtimestamp(p.stat().st_mtime)
            print(
                f"  · {p.name} ({_fmt_bytes(p.stat().st_size)}, "
                f"{mtime.strftime('%Y-%m-%d')})"
            )
        if len(to_delete) > 20:
            print(f"  ... and {len(to_delete) - 20} more.")
        return 0

    deleted_files = 0
    deleted_mapping = 0
    freed_bytes = 0
    for p in to_delete:
        jobacct5 = p.stem
        size = p.stat().st_size
        try:
            p.unlink()
            deleted_files += 1
            freed_bytes += size
        except OSError as e:
            err(f"Deletion of {p.name} failed: {e}")
            continue
        deleted_mapping += job_mapping.remove_jobacct5(jobacct5)

    print()
    print(
        f"{C.GREEN}Deleted: {deleted_files} thumb(s) "
        f"({_fmt_bytes(freed_bytes)}), {deleted_mapping} mapping entry(ies).{C.R}"
    )
    return 0


def _fmt_bytes(n: int) -> str:
    """Readable format: 1024 → '1.0 KB', 1048576 → '1.0 MB'."""
    n_f = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if n_f < 1024:
            return f"{n_f:.1f} {unit}"
        n_f /= 1024
    return f"{n_f:.1f} TB"


