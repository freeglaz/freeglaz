def cmd_store_status(args, client):
    """Show the state of the local store (mirror, repo, backups, sessions).

    If the Z9 is reachable, also compares the local mirror version to
    the remote version (getMediumListVersion). If the Z9 is not
    reachable, the status stays consultable offline — that is the whole
    point of the mirror.
    """
    from lib.z9_client import store

    # `client` may be None (Z9 absent or asleep) — local status OK.
    try:
        status = store.store_status(client=client)
    except Z9Error as e:
        # Z9 reachable but SOAP failed → fall back to local status.
        warn(f"Z9 reachable but remote version unavailable ({e}).")
        status = store.store_status(client=None)

    if args.json:
        print(json.dumps(status, indent=2, ensure_ascii=False, sort_keys=True))
