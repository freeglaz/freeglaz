def cmd_ping(args, client):
    """Quick connectivity test."""
    if client.ping():
        ok(f"Z9 responds on {client.host}")
        return 0
    else:
        err(f"Z9 does not respond on {client.host}")
        return 1


def cmd_info(args, client):
    """Display machine identification."""
    try:
        info_data = client.identification()
    except Z9Error as e:
        err(f"Retrieval failed: {e}")
        return 1

    if args.json:
        print(json.dumps(info_data, indent=2, ensure_ascii=False))
        return 0

    print(f"{C.BOLD}=== Identification HP DesignJet Z9 ==={C.R}")
    print(f"  Host         : {client.host}")
    for key in ("ModelName", "ModelNumber", "PartNumber", "SerialNumber", "FWVersion"):
        if key in info_data:
            print(f"  {C.DIM}{key:13s}{C.R}: {info_data[key]}")
    return 0


def cmd_status(args, client):
    """Overview: loaded paper, ink, alerts."""
    try:
        status = client.status()
    except Z9Error as e:
        err(f"Failed: {e}")
        return 1

    if args.json:
        print(json.dumps(status, indent=2, ensure_ascii=False))
        return 0

    print(f"{C.BOLD}=== Z9 Status ({client.host}) ==={C.R}\n")

    # Identification
    ident = status.get("identification", {})
    print(f"  {C.CYAN}Machine{C.R}      : {ident.get('ModelName', '?')} "
          f"(S/N {ident.get('SerialNumber', '?')})")

    # Paper
    loaded_id = status.get("loaded_paper_id")
    loaded_name = status.get("loaded_paper_name")
    source = status.get("loaded_paper_source")
    source_label = status.get("loaded_paper_source_label")
    if loaded_id:
        # Choose a clear label for the source
        if source == "ROLL":
            src_str = "roll"
        elif source == "MANUAL_FEED":
            src_str = "sheet (manual feed)"
        elif source:
            src_str = f"{source_label or source}"
        else:
            src_str = "?"
        print(f"  {C.CYAN}Paper{C.R}        : {loaded_name or '?'} {C.DIM}({src_str}){C.R}")
        # Dimensions if available
        w_mm = status.get("loaded_paper_width_mm")
        l_mm = status.get("loaded_paper_length_mm")
        if w_mm and l_mm:
            print(f"  {C.DIM}Dimensions   : {w_mm:.0f} × {l_mm:.0f} mm{C.R}")
        elif w_mm:
            print(f"  {C.DIM}Width        : {w_mm:.0f} mm{C.R}")
        print(f"  {C.DIM}MediumId     : {loaded_id}{C.R}")
    else:
        warn("No paper loaded (neither roll nor manual feed)")

    # Inks
    print(f"\n  {C.CYAN}Ink levels:{C.R}")
    ink = status.get("ink_levels", {})
    for color in sorted(ink.keys()):
        pct = ink[color]
        if pct < 20:
            color_str = f"{C.RED}{pct:5.1f}%{C.R}"
        elif pct < 50:
            color_str = f"{C.YELLOW}{pct:5.1f}%{C.R}"
        else:
            color_str = f"{C.GREEN}{pct:5.1f}%{C.R}"
        print(f"    {color:>16s} : {color_str}")

    # Ink warnings
    warnings = status.get("ink_warnings", [])
    if warnings:
        print(f"\n  {C.YELLOW}⚠️  Ink alerts:{C.R}")
        for w in warnings:
            print(f"    {w['color']:>16s} : {w['state']} ({w.get('status', '?')})")

    # Global status
    gs = status.get("global_status", "Unknown")
    color_status = C.GREEN if gs == "Ready" else C.YELLOW if gs == "WithAlerts" else C.RED
    print(f"\n  {C.CYAN}Global status{C.R} : {color_status}{gs}{C.R}")
    return 0


def cmd_logs(args, client):
    """Retrieve Z9 firmware logs (LEDM ProductLogsDyn)."""
    from datetime import datetime, timezone

    since = None
    if args.since:
        try:
            since = datetime.fromisoformat(args.since).replace(tzinfo=timezone.utc)
        except ValueError:
            err(f"Invalid date format: {args.since} (expected YYYY-MM-DD or ISO 8601)")
            return 1

    severity = None
    if args.severity:
        severity = args.severity

    try:
        events = client.logs.get_events(
            limit=min(args.limit, 100),
            severity=severity,
            since=since,
            event_code_prefix=args.event_code or None,
        )
    except Z9Error as e:
        err(f"Log retrieval failed: {e}")
        return 1

    if args.json:
        for ev in events:
            print(json.dumps(ev.to_dict(), ensure_ascii=False))
        return 0

    if not events:
        info("No firmware event found with these filters.")
        return 0

    if args.verbose:
        for ev in events:
            ts = _logs_format_ts(ev.timestamp, args.utc)
            sev = _logs_sev_color(ev.severity)
            print(f"{C.DIM}{ts}{C.R}  {sev}  {C.DIM}{ev.event_code}{C.R}   {ev.event_detail}")
            if ev.source_file:
                basename = ev.source_file.rsplit("/", 1)[-1] if "/" in ev.source_file else ev.source_file
                print(f"{'':>22s}{C.DIM}source: {basename}:{ev.source_line} (firmware {ev.firmware_revision}){C.R}")
    else:
        print(f"{C.BOLD}{'TIMESTAMP':>20s}  {'SEV':>7s}  {'EVENT_CODE':>16s}   DETAIL{C.R}")
        for ev in events:
            ts = _logs_format_ts(ev.timestamp, args.utc)
            sev = _logs_sev_color(ev.severity)
            print(f"{C.DIM}{ts}{C.R}  {sev}  {C.DIM}{ev.event_code}{C.R}   {ev.event_detail}")

    return 0


def _logs_format_ts(iso_ts, utc=False):
    from datetime import datetime, timezone
    if not iso_ts:
        return " " * 19
    try:
        dt = datetime.fromisoformat(iso_ts.replace("Z", "+00:00"))
        if not utc:
            dt = dt.astimezone()
        return dt.strftime("%Y-%m-%d %H:%M:%S")
    except ValueError:
        return iso_ts[:19]


def _logs_sev_color(sev):
    s = (sev or "").upper()
    if s == "ERROR" or s == "FATAL":
        return f"{C.RED}{sev:>7s}{C.R}"
    if s == "WARNING":
        return f"{C.YELLOW}{sev:>7s}{C.R}"
    return f"{C.DIM}{sev:>7s}{C.R}"


def resolve_paper_interactive(client, ref):
    """
    Resolve a paper reference to a dict, with interactive handling of
    ambiguous matches if the terminal is interactive.

    Strategy:
      1. Try by direct ID (32-char hex or short numeric)
      2. Otherwise, search by name (substring then multi-word)
      3. If multiple matches:
         - Interactive mode (tty): numbered menu
         - Non-interactive mode: return None + error message

    :param client: Z9Client instance
    :param ref: str — id, hex, or partial name
    :return: dict of the selected paper, or None if cancelled / not found.
             On error, the message has already been emitted on stderr.
    """
    # 1. Try by direct ID
    try:
        paper = client.paper.get(ref)
        if paper:
            return paper
    except Z9Error as e:
        err(f"Lookup failed: {e}")
        return None

    # 2. Search by name (substring then multi-word)
    try:
        matches = client.paper.get_by_name(ref, exact=False)
    except Z9Error as e:
        err(f"Search failed: {e}")
        return None

    if not matches:
        err(f"No paper found for '{ref}'")
        return None

    if len(matches) == 1:
        return matches[0]

    # Multiple matches: interactive or error
    if not sys.stdin.isatty():
        err(f"{len(matches)} papers match '{ref}'. "
            f"Specify the ID or a more specific name:")
        for m in matches:
            print(f"  {m['id']} : {m['name']}", file=sys.stderr)
        return None

    # Interactive mode: numbered menu
    print(f"{C.YELLOW}{len(matches)} papers match '{ref}':{C.R}\n")
    for i, m in enumerate(matches, 1):
        type_str = "[C]" if m.get("is_custom") else "[F]"
        print(f"  {C.BOLD}{i}{C.R}. {type_str} {m['name']}")
        print(f"     {C.DIM}{m['id']}{C.R}")
    print()
    try:
        choice = input("Choice (number, or ⏎ to cancel): ").strip()
    except EOFError:
        return None
    if not choice:
        return None
    try:
        idx = int(choice) - 1
        if idx < 0 or idx >= len(matches):
            err(f"Invalid choice: {choice}")
            return None
        selected = matches[idx]
    except ValueError:
        err(f"Invalid number: {choice}")
        return None

    # Visual confirmation of the choice
    type_str = "[C]" if selected.get("is_custom") else "[F]"
    print(f"\n{C.GREEN}→ Paper selected:{C.R} {type_str} {C.BOLD}{selected['name']}{C.R}")
    return selected


def cmd_paper_list(args, client):
    """List papers known to the Z9."""
    try:
        papers = client.paper.list()
        if args.with_calibration:
            cal_status = client.paper.calibration_status()
        else:
            cal_status = {}
    except Z9Error as e:
        err(f"Failed: {e}")
        return 1

    # Filtering
    if args.custom:
        papers = [p for p in papers if p["is_custom"]]
    if args.factory:
        papers = [p for p in papers if p["is_factory"]]
    if args.category:
        papers = [p for p in papers if p["category_id"].upper() == args.category.upper()]

    if args.json:
        # Add CLC status if requested
        if args.with_calibration:
            for p in papers:
                cs = cal_status.get(p["id"], {})
                p["clc_status"] = cs.get("clc_status")
                p["clc_timestamp"] = cs.get("timestamp")
        print(json.dumps(papers, indent=2, ensure_ascii=False))
        return 0

    # Table display
    if not papers:
        warn("No paper matches the filters")
        return 0

    # Pre-build the columns
    print(f"{C.BOLD}{'Type':>4s} {'Id':<32s} {'Cat':<18s} "
          f"{'Donor':>5s} {'Rev':>7s}  {'Name':<45s}", end="")
    if args.with_calibration:
        print(f"  {'CLC':>10s}", end="")
    print(C.R)
    print("-" * (4 + 1 + 32 + 1 + 18 + 1 + 5 + 1 + 7 + 2 + 45 + (2 + 10 if args.with_calibration else 0)))

    for p in papers:
        ptype = "[C]" if p["is_custom"] else "[F]"
        pid = p["id"][:32]
        cat = p["category_id"][:18]
        donor = p["donor_id"] or "-"
        rev = p["revision"]
        name = (p["name"] or "?")[:45]
        line = f"{ptype:>4s} {pid:<32s} {cat:<18s} {donor:>5s} {rev:>7s}  {name:<45s}"

        if args.with_calibration:
            cs = cal_status.get(p["id"], {})
            clc = cs.get("clc_status") or "-"
            if clc == "VALID":
                clc_str = f"{C.GREEN}{clc:>10s}{C.R}"
            elif clc == "OBSOLETE":
                clc_str = f"{C.YELLOW}{clc:>10s}{C.R}"
            elif clc == "PENDING":
                clc_str = f"{C.DIM}{clc:>10s}{C.R}"
            else:
                clc_str = f"{clc:>10s}"
            line += f"  {clc_str}"
        print(line)

    print(f"\n  Total: {len(papers)} paper(s)")
    return 0


def cmd_paper_show(args, client):
    """Display the full details of a paper (via SOAP getMediumList).

    Enriched display: calibration, ICC profiles, capabilities,
    physical settings (StarWheel, PenToRib, DryTime), weight, etc.
    """
    # Step 1: resolve the reference (interactive handling of ambiguities)
    paper = resolve_paper_interactive(client, args.id_or_name)
    if not paper:
        return 1
    print()  # Line break after interactive menu if present

    # Step 2: retrieve the full details via SOAP (rich fields)
    try:
        details = client.paper.details(paper["id"])
    except Z9Error as e:
        err(f"SOAP details retrieval failed: {e}")
        return 1

    if details is None:
        err(f"Paper {paper['id']} not found in getMediumList SOAP")
        return 1

    # JSON mode
    if args.json:
        print(json.dumps(details, indent=2, ensure_ascii=False))
        return 0

    # Enriched display
    _print_paper_details(details, client, brief=args.brief)
    return 0


def _print_paper_details(p, client, brief=False):
    """Formatted display of the full details of a paper."""
    # Title
    print(f"{C.BOLD}=== {p['name'] or '?'} ==={C.R}")
    if p.get("short_name") and p["short_name"] != p["name"]:
        print(f"  {C.DIM}Short name   : {p['short_name']}{C.R}")
    print(f"  Id           : {p['id']}")
    type_label = "Custom (user)" if p.get("is_user_custom") else "Factory (HP)"
    print(f"  Type         : {type_label}")
    print(f"  Category     : {p['category_id']}"
          f"{f' ({p['category_name']})' if p.get('category_name') else ''}")
    if p.get("billing_type_id"):
        print(f"  BillingType  : {p['billing_type_id']}")

    # Donor (resolved to name if we can)
    if p.get("donor_id"):
        donor = client.paper.get(p["donor_id"])
        donor_name = donor["name"] if donor else "?"
        print(f"  Donor        : {p['donor_id']} ({donor_name})")

    print(f"  Revision     : {p.get('revision', '?')}"
          f"  {C.DIM}(wsRev {p.get('ws_revision', '?')}){C.R}")
    print(f"  Visible      : {'yes' if p.get('is_visible') else 'no'}")
    print(f"  Protected    : {'yes' if p.get('is_protected') else 'no'}")
    print(f"  Locked       : {'yes' if p.get('is_locked') else 'no'}")

    # Calibration
    cal = p.get("calibration") or {}
    if cal.get("date"):
        cal_label = "OBSOLETE" if cal.get("obsolete") else "VALID"
        cal_color = C.YELLOW if cal.get("obsolete") else C.GREEN
        print(f"\n  {C.CYAN}Calibration (CLC):{C.R}")
        print(f"    Date         : {cal['date']}")
        print(f"    State        : {cal_color}{cal_label}{C.R}")

    # Paper details (weight, inks)
    # Note: the firmware's "Grammage (g/sqm)" field is NOT a real weight —
    # it's an opaque internal identifier (nearly all papers carry the value
    # "70-90", including a Plain Paper 80g/m² and a Hahnemühle Photo Rag
    # 308g/m²). We hide it by default so as not to mislead. Always
    # accessible via --json or --debug.
    if p.get("details"):
        # Filter the useful details (the ink booleans + Created from)
        useful_details = {
            k: v for k, v in p["details"].items()
            if k != "Grammage (g/sqm)"
        }
        if useful_details:
            print(f"\n  {C.CYAN}Paper details:{C.R}")
            for k, v in useful_details.items():
                if isinstance(v, bool):
                    vstr = "yes" if v else "no"
                else:
                    vstr = str(v)
                print(f"    {C.DIM}{k:30s}{C.R} {vstr}")

    # ICC profiles (very useful, shows the UUIDs and parameters)
    profiles = p.get("profiles") or []
    if profiles:
        print(f"\n  {C.CYAN}ICC profiles ({len(profiles)}):{C.R}")
        for i, prof in enumerate(profiles, 1):
            origin = f"{C.GREEN}custom{C.R}" if prof.get("custom") else f"{C.DIM}factory{C.R}"
            ge = prof.get("gloss_enhancer") or "?"
            cs = prof.get("color_space") or "?"
            print(f"    {i}. {origin}  GE={ge:<8s}  ColorSpace={cs}")
            print(f"       Name : {prof.get('icc_name') or '?'}")
            # Date: normalized + full timestamp for customs
            date_display = prof.get("date") or "?"
            date_raw = prof.get("date_raw")
            if prof.get("custom") and date_raw and date_raw != date_display:
                # custom: show YYYY-MM-DD + (detailed timestamp)
                print(f"       Date : {date_display}  {C.DIM}({date_raw}){C.R}")
            else:
                print(f"       Date : {date_display}")
