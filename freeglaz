def cmd_web(args, client):
    """Starts the freeglaz webapp (FastAPI backend + browser opening).

    The ``client`` received as an argument is ignored: the webapp
    instantiates its own Z9Client in its FastAPI lifespan. This allows
    ``freeglaz web --mock`` to run even without Z9_HOST configured.

    If ``--build`` is passed, runs ``npm run build`` in
    ``webapp/frontend/`` before starting the backend. Handy to ship a
    usable version in a single process (the backend serves the Vite
    bundle via StaticFiles, cf. webapp/backend/main.py).
    """
    import subprocess
    import threading
    import webbrowser
    from pathlib import Path

    if args.build:
        repo_root = Path(__file__).resolve().parent
        frontend_dir = repo_root / "webapp" / "frontend"
        if not (frontend_dir / "package.json").exists():
            err(f"Frontend not found: {frontend_dir}")
            return 2
        info("Building the frontend (npm run build)…")
        try:
            subprocess.run(
                ["npm", "run", "build"],
                cwd=frontend_dir,
                check=True,
            )
        except FileNotFoundError:
            err("npm not found in PATH. Install Node.js first.")
            return 2
        except subprocess.CalledProcessError as e:
            err(f"Frontend build failed (exit {e.returncode})")
            return 2
        info("Build OK ✓")

    if args.mock:
        os.environ["FREEGLAZ_MOCK_PRINT"] = "1"
        info("Mock mode enabled: no sending to the Z9 (useful for demos).")

    url = f"http://{args.host}:{args.port}/"

    if not args.no_browser:
        # Open the browser once the server ACTUALLY answers (health), not on a
        # fixed timer: a slow first launch (uv sync, slow machine) used to open
        # the browser on an error page before uvicorn was listening. We reuse the
        # same readiness wait as `freeglaz open` and the desktop app
        # (wait_until_up → polls /api/health). daemon=True so it never blocks
        # Ctrl+C.
        def _open_when_ready():
            from webapp.backend.main import wait_until_up
            if wait_until_up(args.host, args.port):
                webbrowser.open(url)
            else:
                warn(f"Server not reachable at {url} after waiting — "
                     f"open the URL manually.")
        threading.Thread(target=_open_when_ready, daemon=True).start()

    # Lazy import: FastAPI/Pydantic loaded only for the web command,
    # not for `freeglaz ping/status/etc.`
    from webapp.backend.main import run as run_backend

    info(f"Starting the backend at {url}")
    try:
        run_backend(host=args.host, port=args.port, reload=args.reload)
    except KeyboardInterrupt:
        warn("Backend stopped by the user")
    return 0


def _ensure_server_up(host, port, mock=False, timeout=20.0):
    """Ensures a freeglaz backend responds on ``host:port``.

    SHARED "server up or to be started" logic (cf. ``cmd_open``; and
    reusable by any future caller). Policy:
      - if a server already responds (``/api/health``) → we REUSE it
        (returns ``None``, nothing started);
      - otherwise → we start it in the BACKGROUND (``run_background``) and wait
        for it to respond; returns ``(server, thread)`` that the caller must keep
        alive (foreground).

    ``cmd_web`` does NOT use this helper: it IS the server (blocking
    foreground via ``run()``), unchanged behavior.

    Raises ``RuntimeError`` if the port is occupied by something else, or if the
    started server does not respond in time.
    """
    from webapp.backend.main import is_up, run_background, wait_until_up

    if is_up(host, port):
        return None  # already running → reuse
    if mock:
        os.environ["FREEGLAZ_MOCK_PRINT"] = "1"
    handle = run_background(host=host, port=port)  # (server, thread) or RuntimeError
    if not wait_until_up(host, port, timeout=timeout):
        raise RuntimeError(
            f"the started server did not respond at http://{host}:{port}/api/health "
            f"within {timeout:.0f}s"
        )
    return handle


def cmd_open(args, client):
    """``freeglaz open <file>``: opens the GUI print screen with the image
    already loaded.

    The received ``client`` is ignored (like ``cmd_web``): the backend
    instantiates its own Z9Client. Flow: server health (REUSE if already
    running / start otherwise, via ``_ensure_server_up`` — never 2 concurrent
    backends) → upload via the SAME endpoint as drag-and-drop (``POST
    /api/files``, no from-path variant) → opening a NATIVE pywebview WINDOW
    (fallback ``webbrowser`` if pywebview unavailable) on ``/print?file_id=…``
    (the frontend boots from this file_id, cf. commit 3b434d3).
    """
    import webbrowser
    from pathlib import Path
    from urllib.parse import quote

    import requests

    src = Path(args.file).expanduser()
    if not src.is_file():
        err(f"File not found: {src}")
        return 2
    ext = src.suffix.lower()
    if ext not in (".tif", ".tiff"):
        err(f"Unsupported extension: {ext or '(none)'} (TIFF expected)")
        return 2

    host, port = args.host, args.port
    base = f"http://{host}:{port}"

    # ─── Server: reuse if running, start otherwise ───────────
    info(f"Target: {base}")
    try:
        started = _ensure_server_up(host, port, mock=args.mock)
    except RuntimeError as e:
        err(str(e))
        return 1
    info("Server already running (reused)." if started is None else "Server started ✓")

    # ─── Upload: SAME endpoint as drag/file explorer ────────────────
    try:
        with open(src, "rb") as fh:
            resp = requests.post(
                f"{base}/api/files",
                files={"file": (src.name, fh)},
                timeout=120,
            )
    except requests.RequestException as e:
        err(f"Upload failed: {e}")
        return 1
    if resp.status_code != 200:
        err(f"Upload refused ({resp.status_code}): {resp.text[:200]}")
        return 1
    file_id = (resp.json() or {}).get("file_id")
    if not file_id:
        err("Upload response without file_id.")
        return 1
    info(f"File loaded: {src.name} (file_id {file_id})")

    # ─── Print screen, image pre-selected ───────────────────────
    # name=…: the internal store names the file "source.<ext>"; we pass the
    # original name so the frontend displays it (the PJL JOB NAME is already
    # correct on the server via .original_name set by the upload).
    url = f"{base}/print?file_id={file_id}&name={quote(src.name)}"

    def _keep_foreground():
        """If `open` STARTED the server → keeps it in the foreground
        (Ctrl+C = stop). If it REUSED an instance → returns immediately
        (we never kill someone else's server)."""
        if started is None:
            return
        server, thread = started
        info("Server in foreground — Ctrl+C to stop.")
        try:
            while thread.is_alive():
                thread.join(0.5)
        except KeyboardInterrupt:
            warn("Stopping the server…")
            server.should_exit = True
            thread.join(timeout=5)

    def _stop_if_started():
        """Stops the server ONLY if `open` started it (window closed)."""
        if started is None:
            return
        server, thread = started
        info("Window closed — stopping the server.")
        server.should_exit = True
        thread.join(timeout=5)

    # --no-browser: no UI, just the URL (scripts / debug).
    if args.no_browser:
        info(f"URL: {url}")
        _keep_foreground()
        return 0

    # pywebview by DEFAULT (native window). webview.start() is BLOCKING and
    # MUST run on the main thread (Cocoa/GTK) — which is the case here (the
    # CLI dispatches on the main thread). uvicorn lives in a daemon thread
    # (cf. _ensure_server_up/run_background) → proven webapp.desktop architecture.
    try:
        import webview
    except ImportError:
        webview = None

    if webview is not None:
        try:
            info("Opening the native window (pywebview)…")
            # Dock icon + app name (macOS): reuse webapp.desktop's guarded PyObjC
            # helpers (explicit coupling — no duplication) so `freeglaz open`
            # matches `python -m webapp.desktop`. Best-effort; on import failure
            # func=None = pywebview default → launch unaffected. The app NAME must
            # be set BEFORE start() (Cocoa builds the app menu at launch); the
            # ICON via func= (after NSApplication is live).
            try:
                from webapp.desktop import (
                    _DesktopFileApi,
                    _set_macos_app_name as _app_name,
                    _set_macos_dock_icon as _dock_icon,
                )
            except Exception:  # noqa: BLE001 — cosmetic, never blocks the launch
                _app_name = _dock_icon = _DesktopFileApi = None
            if _app_name is not None:
                _app_name()
            # js_api = native file I/O (save/open dialogs) — the SAME object as
            # `python -m webapp.desktop`, so exports in this native window don't
            # navigate the webview (the app-freezing bug #22). This path (freeglaz
            # open) opens its OWN window → it must wire the js_api itself.
            _fileapi = _DesktopFileApi() if _DesktopFileApi is not None else None
            _win = webview.create_window("freeglaz Print", url,
                                         width=1600, height=1000,
                                         min_size=(1024, 700), maximized=True,
                                         js_api=_fileapi)
            if _fileapi is not None:
                _fileapi._window = _win
            webview.start(func=_dock_icon)   # blocking GUI loop, main thread
            _stop_if_started()        # window closed → stop if we started it
            return 0
        except Exception as e:  # noqa: BLE001 — no display, GUI backend absent…
            warn(f"pywebview unavailable ({e}) — falling back to the browser.")

    # Browser fallback (pywebview absent or failed to open).
    webbrowser.open(url)
    info("Browser opened on the print screen.")
    _keep_foreground()
    return 0


