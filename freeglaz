    try:
        xml = client.paper.get_raw_xml(language=args.language)
    except Z9Error as e:
        err(f"Failed: {e}")
        return 1

    if args.output:
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(xml)
        ok(f"Saved to {args.output} ({len(xml)} characters)")
    else:
        # Output: pretty-print if the output is a tty, otherwise raw
        if sys.stdout.isatty():
            try:
                from xml.dom import minidom
                pretty = minidom.parseString(xml).toprettyxml(indent="  ")
                # Remove blank lines from the pretty-print
                pretty = "\n".join(line for line in pretty.split("\n") if line.strip())
                print(pretty)
            except Exception:
                print(xml)
        else:
            print(xml)
    return 0


