    if brief:
        return

    # Capabilities (verbose mode)
    caps = p.get("capabilities") or {}
    if caps:
        print(f"\n  {C.CYAN}Capabilities:{C.R}")
        # Simple booleans/flags: we group them in 2 columns
        keys = sorted(caps.keys())
        for k in keys:
            v = caps[k]
            print(f"    {C.DIM}{k:35s}{C.R} {v}")

    # Settings (verbose mode)
    settings = p.get("settings") or {}
    if settings:
        print(f"\n  {C.CYAN}Physical settings:{C.R}")
        for k in sorted(settings.keys()):
            v = settings[k]
            print(f"    {C.DIM}{k:35s}{C.R} {v}")


