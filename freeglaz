            "if it does not exist. Note: saving may lose the "
            "original comments of a manually-edited file."
        ),
    )
    spconfset.add_argument("key", help="Dotted key (e.g. 'colprof.quality')")
    spconfset.add_argument("value", help="New value (will be coerced)")
    spconfset.set_defaults(func=cmd_config_set)

    # ── print : print pipeline ──────────────────────────────
    # ── print : print pipeline ──────────────────────────────
    # No subparsers to avoid the positional vs subcommand conflict.
    # The helpers (preview/send/inspect/preflight) are distinct
    # top-level "print-*" commands.

    def _add_common_print_args(p, with_source=True):
        if with_source:
            p.add_argument("source",
                           help="16-bit RGB TIFF with embedded ICC, or already-made PDF/X-4")
        p.add_argument("--paper", "-p", default="loaded",
                       help="'loaded' (loaded paper, default), A4/A3/A2, "
                            "or partial name/MediaID of the paper")
        p.add_argument("--sheet-width", type=float, default=None,
                       help="Sheet width in mm (overrides auto format)")
        p.add_argument("--sheet-height", type=float, default=None,
                       help="Sheet height in mm (overrides auto format)")
        p.add_argument("--image-width", type=float, default=None,
                       help="Image width in mm (default: from TIFF DPI)")
        p.add_argument("--image-height", type=float, default=None,
                       help="Image height in mm (default: from TIFF DPI)")
        p.add_argument("--offset-x", type=float, default=None, metavar="MM",
                       help="Left margin in mm (default: centered horizontally)")
        p.add_argument("--offset-y", type=float, default=None, metavar="MM",
                       help="Top margin in mm (default: centered vertically)")
        p.add_argument("--gloss", default="FULLPAGE",
                       choices=["FULLPAGE", "OFF"],
                       help="Gloss Enhancer (default: FULLPAGE)")
        p.add_argument("--quality", default="HIGH",
                       choices=["HIGH", "NORMAL", "FAST"],
                       help="Quality (default: HIGH)")
        p.add_argument("--rendermode", default="COLOR",
                       choices=["COLOR", "GRAYSCALE"],
                       help="Render mode (default: COLOR)")
        p.add_argument("--max-detail", default="OFF",
                       choices=["ON", "OFF"],
                       help="Maximum Detail = 1200dpi mode on glossy papers "
                            "(default: OFF). Auto-downgraded to OFF if paper not compatible.")
        p.add_argument("--mediasource", default="AUTO",
                       choices=["AUTO", "MANUALFEED", "ROLL"],
                       help="Paper source (default: AUTO = detect based on what is loaded)")
        p.add_argument("--drytime", default="NORMAL",
                       choices=["NORMAL", "EXTENDED"],
                       help="Drying time (default: NORMAL)")
        p.add_argument("--no-cut", action="store_true",
                       help="Disable the automatic cut at the end of the job. "
                            "WARNING: the 24\" Z9 firmware "
                            "silently ignores this flag — the cut "
                            "triggers anyway. The lever must go through "
                            "the 'Cutter' toggles of the front panel.")
        p.add_argument("--copies", type=int, default=1, help="Number of copies")
        p.add_argument("--username", default=None,
                       help="PJL user name (default: $USER)")
        p.add_argument("--work-dir", default=None,
                       help="Folder for intermediate PDF/PRN "
                            "(default: folder of the source TIFF)")

    # print — full pipeline (common case)
    sp_print = sub.add_parser(
        "print",
        help="Print a TIFF or PDF (full freeglaz pipeline)",
        description="Pipeline: TIFF/PDF → PDF/X-4 → preflight → PRN → port 9100. "
                    "Reproduces the validated reference print behavior.",
    )
    _add_common_print_args(sp_print)
    sp_print.add_argument("--skip-preflight", action="store_true",
                          help="Skip the preflight (not recommended)")
    sp_print.add_argument("--yes", "-y", action="store_true",
                          help="No confirmation before sending")
    sp_print.set_defaults(func=cmd_print)

    # print-preview — build PDF + PRN without sending
    spv = sub.add_parser(
        "print-preview",
        help="Build PDF + PRN without sending (for inspection)",
        description="Generate the PDF/X-4 and the PRN in the work folder, "
                    "run the preflight, but do not send to the printer.",
    )
    _add_common_print_args(spv)
    spv.set_defaults(func=cmd_print_preview)

    # print-send — send an already-built PRN
    sps = sub.add_parser(
        "print-send",
        help="Send an already-built PRN to port 9100",
    )
    sps.add_argument("prn_file", help=".prn file to send")
    sps.add_argument("--yes", "-y", action="store_true",
                     help="No confirmation")
    sps.set_defaults(func=cmd_print_send)

    # print-inspect — show the PJL header
    spi = sub.add_parser(
        "print-inspect",
        help="Inspect the PJL header of a .prn",
    )
    spi.add_argument("prn_file", help=".prn file")
    spi.add_argument("--json", action="store_true",
                     help="Raw JSON output")
    spi.set_defaults(func=cmd_print_inspect)

    # print-preflight — check a PDF/X-4
    spp = sub.add_parser(
        "print-preflight",
        help="Check that a PDF is a conformant freeglaz PDF/X-4",
    )
    spp.add_argument("pdf_file", help="PDF file to check")
    spp.set_defaults(func=cmd_print_preflight)

    # web — start the webapp (FastAPI backend + open browser)
    spw = sub.add_parser(
        "web",
        help="Start the webapp (FastAPI backend + open browser)",
        description="Start the webapp backend on http://127.0.0.1:8765 "
                    "and open the default browser. Ctrl+C to stop.",
    )
    spw.add_argument("--host", default="127.0.0.1",
                     help="Listen address (default 127.0.0.1, "
                          "'0.0.0.0' to expose on the LAN)")
    spw.add_argument("--port", type=int, default=8765,
                     help="Listen port (default 8765)")
    spw.add_argument("--no-browser", action="store_true",
                     help="Do not open the browser automatically")
    spw.add_argument("--mock", action="store_true",
                     help="Force FREEGLAZ_MOCK_PRINT=1 for the session "
                          "(mock worker, no sending to the Z9)")
    spw.add_argument("--reload", action="store_true",
                     help="Enable uvicorn --reload (auto-reload on change, dev)")
    spw.add_argument("--build", action="store_true",
                     help="Build the frontend (npm run build in webapp/frontend/) "
                          "before starting the backend")
    spw.set_defaults(func=cmd_web)

    # open — open the GUI print screen with an already-loaded file
    spo = sub.add_parser(
        "open",
        help="Open the GUI print screen with an already-loaded file",
        description="Start the server if needed (or reuse the one already "
                    "running), send the file via the same path as "
                    "drag-and-drop (POST /api/files), then open the "
                    "print screen with the image pre-loaded in a "
                    "native window (pywebview; browser fallback if unavailable). "
                    "Distinct from `print` (direct headless Z9 printing).",
    )
    spo.add_argument("file", help="TIFF file to load into the GUI")
    spo.add_argument("--host", default="127.0.0.1",
                     help="Address of the freeglaz server (default 127.0.0.1)")
    spo.add_argument("--port", type=int, default=8765,
                     help="Port of the freeglaz server (default 8765)")
    spo.add_argument("--no-browser", action="store_true",
                     help="Do not open the browser (just show the URL)")
    spo.add_argument("--mock", action="store_true",
                     help="Force FREEGLAZ_MOCK_PRINT=1 IF the server must be started")
    spo.set_defaults(func=cmd_open)

    # store (subcommands)
    sp_store = sub.add_parser(
        "store",
        help="Local freeglaz store (Z9 mirror + personal repo + sync)",
        description=(
            "Manage the local store: read-only mirror of the Z9 "
            "papers/profiles + personal repo (printers/displays/workingspaces). Allows "
            "offline consultation. HP model: sync via "
            "getMediumListVersion (lightweight check, targeted fetch on divergence)."
        ),
    )
    sub_store = sp_store.add_subparsers(dest="store_cmd", required=True)

    spstore_status = sub_store.add_parser(
        "status",
        help="Store state (local version, last syncs, zones, etc.)",
    )
    spstore_status.add_argument(
        "--json", action="store_true",
        help="Raw JSON output (parsable).",
    )
    spstore_status.set_defaults(func=cmd_store_status)

    spstore_sync = sub_store.add_parser(
        "sync",
        help="Z9 mirror sync (version check + targeted fetch on divergence)",
        description=(
            "Sync mirror/<serial>/ with the Z9. HP model: "
            "getMediumListVersion as a lightweight check, then getMediumList + "
            "targeted donor-export on the papers whose at least one profile "
            "UUID has moved. Never writes into repo/."
        ),
    )
    spstore_sync.add_argument(
        "--force", action="store_true",
        help="Ignore the local version and fully resync.",
    )
    spstore_sync.set_defaults(func=cmd_store_sync)

    # jobs (subcommands)
    sp_jobs = sub.add_parser("jobs", help="Manage freeglaz thumbnails / mapping")
    sub_jobs = sp_jobs.add_subparsers(dest="jobs_cmd", required=True)

    spjc = sub_jobs.add_parser(
        "cleanup-previews",
        help="Stats or purge of freeglaz thumbnails",
        description=(
            "Without option: show the stats of the local thumbs.\n"
            "With --older-than DAYS: delete thumbs > DAYS days\n"
            "and purge the associated orphan job_mapping entries."
        ),
    )
    spjc.add_argument(
        "--older-than", type=int, default=None,
        metavar="DAYS",
        help="Delete thumbs > DAYS days (mandatory to trigger "
             "a deletion — without this arg we just do a dry-stats).",
    )
    spjc.add_argument(
        "--dry-run", action="store_true",
        help="Show what would be deleted without acting.",
    )
    spjc.set_defaults(func=cmd_jobs_cleanup_previews)

    # check (Argyll availability — pure local diagnostic)
    spchk = sub.add_parser(
        "check",
        help="Diagnose Argyll CMS availability (binaries + reference data)",
        description=(
            "Check that the Argyll CMS dependency is fully available: the "
            "required binaries (targen, colprof, spec2cie, profcheck) and the "
            "reference-data directory (ref/). Reports what is missing and how "
            "to fix it. Exit code 0 if everything is available, 1 otherwise."
        ),
    )
    spchk.add_argument("--json", action="store_true", help="Machine-readable JSON output")
    spchk.set_defaults(func=cmd_check)

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    # `freeglaz web` does NOT need a Z9Client on the CLI side: the backend
    # instantiates one in its FastAPI lifespan. This allows `freeglaz web --mock`
    # to run without Z9_HOST configured (useful for demos / offline dev).
    # `freeglaz jobs cleanup-previews` is also a pure local
    # filesystem operation → no need for a Z9.
    # `chart list/profile/formats` are pure LOCAL operations (library,
    # colprof, table) → no Z9. `chart create` requires the Z9 (tag = RESIDENT
    # profile of the slot read live); `chart print/scan` = hardware actions.
    chart_local = (args.cmd == "chart"
                   and getattr(args, "chart_cmd", None) in ("list", "profile",
                                                            "formats"))
    # `freeglaz open`: like `web`, no Z9Client on the CLI side (the backend
    # instantiates one). Also its `--host`/`--port` designate the SERVER, not the
    # Z9 → must not pass them to Z9Client.
    # `freeglaz check` is a pure local Argyll diagnostic → no Z9 needed.
    if args.cmd in ("web", "open", "jobs", "check") or chart_local:
        client = None
    else:
        try:
            if args.host:
                client = Z9Client(host=args.host, admin_pwd=os.getenv("Z9_ADMIN_PWD"))
            else:
                client = Z9Client.from_env()
        except Z9Error as e:
            err(f"Configuration: {e}")
            return 2

    # Dispatch
    try:
        return args.func(args, client) or 0
    except KeyboardInterrupt:
        warn("Interrupted by the user")
        return 130
    except BrokenPipeError:
        # Pipe closed downstream (e.g. ./freeglaz paper raw | head). This is normal,
        # we close cleanly without printing a stacktrace.
        try:
            sys.stdout.close()
        except Exception:
            pass
        try:
            sys.stderr.close()
        except Exception:
            pass
        return 0
    except Z9Error as e:
        err(f"Z9 error: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())