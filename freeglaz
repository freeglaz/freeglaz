# Standard ColorSync location on macOS for user profiles.
# The system (and therefore your editing software) automatically loads the
# .icc/.icm files from this folder when applications start up.
_COLORSYNC_PROFILES_DIR = Path.home() / "Library" / "ColorSync" / "Profiles"


def cmd_profile_install(args, client):
    """
    Installs an ICC profile into ~/Library/ColorSync/Profiles/ (macOS).

    The profile automatically becomes available in all ColorSync-aware
    applications (your editing software, Preview, etc.). Applications
    already open must be relaunched to see it.

    Behavior:
      - Refuses to overwrite an existing profile (unless --force)
      - Verifies the destination is readable after copy
      - Reminder: relaunch applications already open

    Usage:
        freeglaz profile install baryta_multipass.icc
        freeglaz profile install baryta_multipass.icc --force  # overwrite if exists
    """
    import shutil

    src_path = Path(args.icc).resolve()
    if not src_path.exists():
        err(f"ICC profile not found: {src_path}")
        return 1
    if not src_path.suffix.lower() in ('.icc', '.icm'):
        err(f"Unexpected extension: {src_path.suffix} (expected .icc or .icm)")
        return 1

    # macOS check — this folder only exists on macOS
    if not _COLORSYNC_PROFILES_DIR.parent.exists():
        err(f"ColorSync folder not found: {_COLORSYNC_PROFILES_DIR.parent}")
        err(f"This command requires macOS (or adjust the path manually)")
        return 1

    _COLORSYNC_PROFILES_DIR.mkdir(parents=True, exist_ok=True)

    # File name inside ColorSync (can be customized via --as)
    target_name = args.as_name if args.as_name else src_path.name
    if not target_name.lower().endswith(('.icc', '.icm')):
        target_name = target_name + '.icc'
    dst_path = _COLORSYNC_PROFILES_DIR / target_name

    print(f"{C.BOLD}📦 Installing ICC profile into ColorSync{C.R}")
    print(f"  Source       : {src_path}")
    print(f"  Destination  : {dst_path}")
    print()

    # Check whether already present
    if dst_path.exists():
        if not args.force:
            err(f"Profile already present: {dst_path.name}")
            print(f"  Use --force to overwrite, or --as <new_name> "
                  f"to install under a different name.")
            return 1
        else:
            print(f"  {C.YELLOW}⚠ Overwriting (--force){C.R} the existing profile")

    # Copy
    try:
        shutil.copy2(src_path, dst_path)
    except (OSError, PermissionError) as e:
        err(f"Copy failed: {e}")
        return 1

    # Post-copy verification
    if not dst_path.exists() or os.path.getsize(dst_path) != os.path.getsize(src_path):
        err(f"Incomplete copy detected")
        return 1

    size_kb = os.path.getsize(dst_path) / 1024
    ok(f"Profile installed ({size_kb:.0f} KB)")
    print(f"  Available in : your editing software, Preview…")
    print()
    print(f"💡 {C.YELLOW}Relaunch applications already open for it to appear{C.R}")
    print(f"   in the ICC profile selection menus.")

    return 0


def cmd_profile_check(args, client):
    """
    Checks the quality and consistency of a freeglaz ICC profile.

    Runs 3 tests:
      1. Self-consistency via Argyll profcheck -k (CIEDE2000) if ti3 available
      2. Paper white Lab test (detects XYZ "warm-yellow shift" type bug)
      3. ICC metadata inspection (white point, black point, gamut)

    The paper white Lab test is the catch-all anti-regression check for the
    XYZ bug (buggy local _CIE_D50_20NM table).
    If Lab(white) drifts significantly from the D50 white expected for a
    quality photo paper (a*≈0±2, b*≈+1±3), it is suspect.

    Usage:
        freeglaz profile check baryta_multipass.icc
        freeglaz profile check baryta_multipass.icc --ti3 baryta_multipass.ti3
    """
    import subprocess
    import struct

    icc_path = Path(args.icc).resolve()
    if not icc_path.exists():
        err(f"ICC profile not found: {icc_path}")
        return 1

    print(f"{C.BOLD}🔍 ICC profile check{C.R}")
    print(f"  Profile : {icc_path}")
    print()

    # ─── Test 1: ICC metadata inspection ─────────────────────────
    print(f"  {C.BOLD}[1/3] ICC metadata inspection{C.R}")

    try:
        with open(icc_path, 'rb') as f:
            data = f.read()
    except OSError as e:
        err(f"Cannot read: {e}")
        return 1

    if len(data) < 132:
        err(f"ICC too small ({len(data)} bytes)")
        return 1

    # Parse tags + extract wtpt and bkpt
    wtpt_lab = None
    bkpt_lab = None
    n_tags = struct.unpack(">I", data[128:132])[0]
    offset = 132

    def xyz_to_lab(X, Y, Z, Xn=0.9642, Yn=1.0, Zn=0.8249):
        def f(t):
            return t ** (1/3) if t > (6/29)**3 else t / (3 * (6/29)**2) + 4/29
        fx, fy, fz = f(X/Xn), f(Y/Yn), f(Z/Zn)
        return (116*fy - 16, 500*(fx-fy), 200*(fy-fz))

    for _ in range(n_tags):
        if offset + 12 > len(data):
            break
        sig = data[offset:offset+4].decode('ascii', errors='replace')
        if sig in ('wtpt', 'bkpt'):
            tag_off = struct.unpack(">I", data[offset+4:offset+8])[0]
            if tag_off + 20 <= len(data):
                chunk = data[tag_off:tag_off+20]
                if chunk[0:4] == b'XYZ ':
                    X = struct.unpack(">i", chunk[8:12])[0] / 65536.0
                    Y = struct.unpack(">i", chunk[12:16])[0] / 65536.0
                    Z = struct.unpack(">i", chunk[16:20])[0] / 65536.0
                    lab = xyz_to_lab(X, Y, Z)
                    if sig == 'wtpt':
                        wtpt_lab = lab
                    else:
                        bkpt_lab = lab
        offset += 12

    print(f"    Profile size   : {len(data):,} bytes ({len(data)/1024:.0f} KB)")
    if wtpt_lab:
        L, a, b = wtpt_lab
        print(f"    White point    : Lab({L:.2f}, {a:+.2f}, {b:+.2f})")
    if bkpt_lab:
        L, a, b = bkpt_lab
        print(f"    Black point    : Lab({L:.2f}, {a:+.2f}, {b:+.2f})")

    # ─── Test 2: Paper white Lab consistency ──────────────────────
    print()
    print(f"  {C.BOLD}[2/3] Paper white Lab consistency{C.R}")

    if wtpt_lab is None:
        print(f"    {C.YELLOW}⚠ Not possible: wtpt absent from profile{C.R}")
    else:
        L, a, b = wtpt_lab
        # For a quality photo paper, the white should be close to D50
        # when measured honestly. a* should stay small (~neutral paper),
        # b* may be slightly positive (+1 to +3, very white papers)
        # or slightly negative with OBA (optical brighteners), but rarely beyond.
        # Detects the buggy XYZ bug: a* > +4 or b* > +5 (warm-yellow shift)
        suspect = abs(a) > 4 or b > 5 or b < -8
        if suspect:
            print(f"    {C.RED}❌ SUSPECT{C.R} : a*={a:+.2f} b*={b:+.2f}")
            print(f"       A normal paper white is typically at a*≈0±2, b*≈+1±3")
            print(f"       If a* ≈ +6 and b* ≈ +5 → probable XYZ bug "
                  f"(buggy local CIE table)")
            print(f"       → Rebuild the profile with the spec2cie fix:")
            print(f"         {C.DIM}freeglaz chart fix-xyz <ti3>{C.R}")
        else:
            print(f"    {C.GREEN}✓{C.R} Lab white consistent (a*={a:+.2f} b*={b:+.2f})")

    # ─── Test 3: profcheck if ti3 available ────────────────────────
    print()
    print(f"  {C.BOLD}[3/3] Self-consistency (profcheck CIEDE2000){C.R}")

    # Look for the ti3: explicit --ti3, or auto next to the icc
    if args.ti3:
        ti3_path = Path(args.ti3).resolve()
    else:
        # Auto-search: same basename, .ti3 extension
        candidate = icc_path.with_suffix('.ti3')
        ti3_path = candidate if candidate.exists() else None

    if ti3_path is None or not ti3_path.exists():
        print(f"    {C.YELLOW}⚠ Skip: ti3 not found{C.R}")
        if not args.ti3:
            print(f"       Looking for: {icc_path.with_suffix('.ti3')}")
            print(f"       Provide with --ti3 <ti3> if elsewhere")
    else:
        # Run profcheck
        from lib.z9_client.argyll import find_argyll_binary
        _profcheck = find_argyll_binary("profcheck")     # durable resolution (PATH + system paths)
        if _profcheck is None:
            print(f"    {C.YELLOW}⚠ profcheck not found (Argyll not installed?){C.R}")
        else:
            try:
                r = subprocess.run(
                    [_profcheck, "-k", str(ti3_path), str(icc_path)],
                    capture_output=True, text=True, timeout=120,
                )
                output = r.stdout + r.stderr
                # Parser "errors(CIEDE2000): max. = X, avg. = Y, RMS = Z"
                import re
                m = re.search(
                    r"errors\(CIEDE2000\):\s*max\.\s*=\s*([\d.]+),\s*"
                    r"avg\.\s*=\s*([\d.]+),\s*RMS\s*=\s*([\d.]+)",
                    output,
                )
                if m:
                    peak, avg, rms = float(m.group(1)), float(m.group(2)), float(m.group(3))
                    # In-house grid = SINGLE source (lib.z9_client.profile_compare).
                    # The color stays CLI presentation; the thresholds/labels
                    # are no longer duplicated here.
                    from lib.z9_client.profile_compare import _quality_label
                    label = _quality_label(avg, peak)
                    _qcolor = {"Excellent": C.GREEN, "Good": C.GREEN,
                               "Fair": C.YELLOW, "Poor": C.RED}
                    quality = f"{_qcolor.get(label, '')}{label}{C.R}"
                    print(f"    ti3       : {ti3_path.name}")
                    print(f"    Peak ΔE   : {peak:.2f}")
                    print(f"    Avg ΔE    : {avg:.2f}")
                    print(f"    RMS ΔE    : {rms:.2f}")
                    print(f"    Quality   : {quality}")
                else:
                    print(f"    {C.YELLOW}⚠ Unexpected profcheck format:{C.R}")
                    print(f"    {output[:200]}")
            except subprocess.TimeoutExpired:
                print(f"    {C.RED}❌ profcheck timeout (>120s){C.R}")
            except Exception as e:
                print(f"    {C.RED}❌ Error: {e}{C.R}")

    print()
    return 0


def cmd_profile_compare(args, client):
    """
    Compares 2+ ICC profiles side by side (profile-compare).

    Metrics (all via lib.z9_client.profile_compare):
      - ICC identity (header, description, type)
      - whitepoint / blackpoint Lab D50
      - gamut volumes (perceptual / relative / saturation, via lcms2)
      - A2B0 LUT structure (grid + Lab ranges) when mft2
      - ΔE CIEDE2000 profcheck (Argyll) if --ti3 provided
      - LUT curvature [EXPERIMENTAL] if --curvature

    ⚠ Curvature measures the REGULARITY of the LUT, NOT colorimetric
    accuracy. Metric not yet validated against an independent
    spectrophotometer — use only as a qualitative reading.

    Usage:
        freeglaz profile compare a.icc b.icc
        freeglaz profile compare a.icc b.icc c.icc --curvature
        freeglaz profile compare a.icc b.icc --ti3 a.ti3 --ti3 b.ti3
        freeglaz profile compare a.icc b.icc --json
    """
    from lib.z9_client.profile_compare import (
        CURVATURE_EXPERIMENTAL_NOTICE_FR,
        compare_profiles,
    )

    profiles = [Path(p).resolve() for p in args.profiles]
    if len(profiles) < 2:
        err("profile compare requires at least 2 profiles")
        return 1
    missing = [str(p) for p in profiles if not p.exists()]
    if missing:
        err("Profile(s) not found:")
        for m in missing:
            print(f"  {C.DIM}- {m}{C.R}", file=sys.stderr)
        return 1

    ti3_list = None
    if args.ti3:
        if len(args.ti3) != len(profiles):
            err(
                f"--ti3 provided {len(args.ti3)} times but {len(profiles)} "
                "profiles: one --ti3 per profile (or none)"
            )
            return 1
        ti3_list = args.ti3

    result = compare_profiles(
        profiles, ti3_paths=ti3_list, with_curvature=args.curvature,
    )

    if args.json:
        import json as _json
        print(_json.dumps(result, indent=2, ensure_ascii=False))
        return 0

    # ─── Formatted console output ────────────────────────────────
    entries = result["profiles"]
    n = len(entries)
    labels = [f"[{i + 1}] {Path(e['path']).name}" for i, e in enumerate(entries)]

    print(f"{C.BOLD}🆚 Comparison of {n} ICC profiles{C.R}")
    for i, e in enumerate(entries):
        print(f"  {C.BOLD}[{i + 1}]{C.R} {e['path']}")
    print()

    def _row(label, values, width=24):
        cells = []
        for v in values:
            s = "—" if v in (None, "", []) else str(v)
            cells.append(s[:width].ljust(width))
        print(f"  {label:<22} {' '.join(cells)}")

    print(f"  {C.BOLD}ICC identity{C.R}")
    _row("Version", [e["icc_version"] for e in entries])
    _row("Class", [e["device_class_label"] or e["device_class"] for e in entries])
    _row("Color space", [e["color_space"] for e in entries])
    _row("PCS", [e["pcs"] for e in entries])
    _row("Guessed type", [e["profile_type_guess"] for e in entries])
    _row("Size (bytes)", [f"{e['file_size']:,}" for e in entries])
    _row("Description", [e["description"] or "—" for e in entries], width=32)
    print()

    print(f"  {C.BOLD}Whitepoint / Blackpoint Lab D50{C.R}")
    def _lab(v):
        if not v or len(v) != 3:
            return "—"
        return f"L*{v[0]:.1f} a{v[1]:+.1f} b{v[2]:+.1f}"
    _row("WP Lab", [_lab(e["whitepoint_lab"]) for e in entries])
    _row("BP Lab", [_lab(e["blackpoint_lab"]) for e in entries])
    print()

    print(f"  {C.BOLD}Gamut volumes (lcms2 convex-hull 33³){C.R}")
    for k in ("perceptual", "relative", "saturation"):
        def _vol(e, kk=k):
            v = e["gamut"].get(kk)
            return f"{v:,.0f}" if isinstance(v, (int, float)) else "—"
        _row(k.capitalize(), [_vol(e) for e in entries])
    print()

    print(f"  {C.BOLD}A2B0 LUT structure{C.R}")
    def _grid(e):
        return str(e["lut"]["grid_size"]) if e["lut"] else "—"
    def _range(e, k):
        if not e["lut"]:
            return "—"
        v = e["lut"][k]
        return f"[{v[0]:.1f}..{v[1]:.1f}]"
    _row("Grid (n³)", [_grid(e) for e in entries])
    _row("L* range", [_range(e, "lab_l_range") for e in entries])
    _row("a* range", [_range(e, "lab_a_range") for e in entries])
    _row("b* range", [_range(e, "lab_b_range") for e in entries])
    print()

    if args.ti3:
        print(f"  {C.BOLD}profcheck CIEDE2000 self-consistency{C.R}")
        def _pc(e, key):
            pc = e.get("profcheck")
            if not pc or pc.get("status") != "ok":
                return f"{C.DIM}{(pc or {}).get('status', '—')}{C.R}"
            return f"{pc[key]:.2f}"
        _row("Peak ΔE", [_pc(e, "peak_de2000") for e in entries])
        _row("Avg ΔE", [_pc(e, "avg_de2000") for e in entries])
        _row("RMS ΔE", [_pc(e, "rms_de2000") for e in entries])
        _row("Quality", [(e.get("profcheck") or {}).get("quality", "—")
                         for e in entries])
        print()

    if args.curvature:
        print(f"  {C.YELLOW}{C.BOLD}⚠ CURVATURE — EXPERIMENTAL METRIC{C.R}")
        print(f"  {C.DIM}{CURVATURE_EXPERIMENTAL_NOTICE_FR}{C.R}")
        print()
        def _cv(e, k):
            c = e.get("curvature")
            if not c or c.get("status") != "ok":
                return f"{C.DIM}{(c or {}).get('status', '—')}{C.R}"
            return f"{c[k]:.3f}"
        _row("Native grid", [
            str((e.get("curvature") or {}).get("grid_native", "—"))
            for e in entries
        ])
        _row("Curvature avg", [_cv(e, "moy") for e in entries])
        _row("Curvature median", [_cv(e, "med") for e in entries])
        _row("Curvature p95", [_cv(e, "p95") for e in entries])
        _row("Curvature max", [_cv(e, "max") for e in entries])
        print()
        print(f"  {C.DIM}Legend: 3D Laplacian weighted L*×2 (Morovič). "
              f"The lower the value, the smoother the LUT — not more "
              f"accurate for that. Read as a COMPARISON, not in absolute terms.{C.R}")
        print()

    return 0


