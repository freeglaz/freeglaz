          f"levels={result['cube_levels']}")
    print(f"   • Extras  : {result['extras']}")
    print(f"   • Pass    : {result['pass_number']}")
    if args.paper:
        print(f"   • Paper   : {args.paper}")
    print()
    print(f"   • ti1     : {result['output_ti1_path']}")
    print(f"   • sidecar : {result['output_sidecar_path']}")

    if result.get("notes"):
        print()
        print(f"{C.DIM}Notes:{C.R}")
        for note in result["notes"]:
            print(f"  {C.DIM}• {note}{C.R}")

    print()
    print(f"{C.DIM}Next step: generate the TIFF raster for printing:{C.R}")
    paper_display = args.paper or "<paper>"
    print(f"   {C.DIM}freeglaz chart generate --paper \"{paper_display}\" \\{C.R}")
    print(f"   {C.DIM}    --ti1 {result['output_ti1_path']}{C.R}")
    return 0


def cmd_chart_build_profile(args, client):
    """
    Build the final freeglaz ICC profile from a firmware ICC + JSON sidecar.

    Internal pipeline (via ProfilingOps.run_pipeline):
      1. CGATS extraction from the firmware ICC's CIED tag
      2. RGB remap according to the custom chart's sidecar
      3. Argyll colprof → final freeglaz ICC

    Purely local operation (no Z9 communication). Auto-searches for the
    sidecar next to the firmware ICC if --sidecar is absent.

    Usage:
        freeglaz chart build-profile --firmware-icc scan.icc
        freeglaz chart build-profile --firmware-icc scan.icc --sidecar chart.json
        freeglaz chart build-profile --firmware-icc scan.icc -o final.icc
        freeglaz chart build-profile --firmware-icc scan.icc \\
            --colprof-flags "-v -qh -nc -V -Z r33 -r 50"
    """
    import shlex
    from lib.z9_client.profiling import ProfilingOps
    from lib.z9_client.strategies import StrategyOps, resolve_flags

    if getattr(args, 'list_strategies', False):
        ops = StrategyOps()
        strategies = ops.list_strategies()
        print(f"{C.BOLD}Available colprof presets:{C.R}\n")
        for s in strategies:
            tag = f"{C.DIM}(builtin){C.R}" if s.builtin else f"{C.CYAN}(user){C.R}"
            print(f"  {C.GREEN}{s.name:14s}{C.R} {C.BOLD}{s.label or s.name}{C.R}")
            print(f"  {'':14s} {C.DIM}{s.flags}{C.R}  {tag}")
            if s.recommended_for:
                print(f"  {'':14s} → {s.recommended_for}")
            print()
        return 0

    if getattr(args, 'strategy_info', None):
        ops = StrategyOps()
        s = ops.get_strategy(args.strategy_info)
        if not s:
            err(f"Unknown strategy: {args.strategy_info}")
            return 1
        tag = "builtin" if s.builtin else "user"
        resolved = resolve_flags(s)
        print(f"{C.BOLD}{s.label or s.name}{C.R}  {C.DIM}({tag}){C.R}")
        print(f"  Slug          : {s.name}")
        print(f"  Flags         : {C.CYAN}{s.flags}{C.R}")
        if resolved != s.flags:
            print(f"  Resolved flags: {C.DIM}{resolved}{C.R}")
        if s.recommended_for:
            print(f"  Recommended for: {s.recommended_for}")
        if s.tags:
            print(f"  Tags          : {', '.join(s.tags)}")
        if s.description:
            print()
            print(s.description)
        return 0

    if getattr(args, 'strategy', None) and getattr(args, 'colprof_flags', None):
        err("--strategy and --colprof-flags are mutually exclusive.")
        return 1

    if not args.firmware_icc:
        err("--firmware-icc is required (except with --list-strategies / --strategy-info)")
        return 1
    firmware_icc = Path(args.firmware_icc).resolve()
    if not firmware_icc.exists():
        err(f"firmware ICC not found: {firmware_icc}")
        return 1

    # Auto-search for sidecar next to the firmware if not specified
    if args.sidecar:
        sidecar_path = Path(args.sidecar).resolve()
    else:
        candidate = firmware_icc.parent / "chart_sidecar.json"
        if not candidate.exists():
            err(f"JSON sidecar not found.")
            print(f"  Searched: {candidate}")
            print(f"  Hint    : specify via --sidecar <path>", file=sys.stderr)
            return 1
        sidecar_path = candidate
        print(f"{C.DIM}Sidecar auto-found: {sidecar_path}{C.R}")

    if not sidecar_path.exists():
        err(f"JSON sidecar not found: {sidecar_path}")
        return 1

    # Default output: <firmware>_freeglaz.icc alongside
    if args.output:
        output_icc = Path(args.output).resolve()
    else:
        output_icc = firmware_icc.parent / (firmware_icc.stem + "_freeglaz.icc")

    # Default descriptor = stem of the output file (project rule, cf. webapp
    # charts.py build). explicit --descriptor honored (conscious override).
    descriptor = args.descriptor or output_icc.stem

    # ─── Load the config + resolve the colprof parameters ─────────────
    # Hierarchy: explicit CLI flag > user config > hardcoded defaults
    from lib.z9_client.config import get_config, build_colprof_command

    config = get_config()
    cp_config = config.get("colprof", {})

    # Parameter resolution: CLI flag or config
    manufacturer = args.manufacturer or cp_config.get("manufacturer", "HP")
    model = args.model or cp_config.get("model", "DesignJet Z9")
    copyright_str = args.copyright_str or cp_config.get("copyright", "No copyright, use freely")
    # Sanitize ASCII for Argyll (ICC `cprt` tag does not accept multi-byte UTF-8)
    copyright_str, _cp_was_sanitized = _sanitize_copyright_ascii(copyright_str)
    if _cp_was_sanitized:
        warn(f"Copyright sanitized for Argyll (ASCII-safe): {copyright_str!r}")

    # For colprof_flags: we build from the config if no explicit flag
    # (cf. extra_flags + quality + source_gamut in the config).
    # If --colprof-flags is given, we honor it as-is (total override).
    if getattr(args, 'strategy', None):
        ops = StrategyOps()
        strat = ops.get_strategy(args.strategy)
        if not strat:
            err(f"Unknown strategy: {args.strategy}")
            print(f"  See: freeglaz chart build-profile --list-strategies", file=sys.stderr)
            return 1
        resolved = resolve_flags(strat)
        colprof_flags = shlex.split(resolved)
        info(f"Strategy: {strat.name} → {resolved}")
    elif args.colprof_flags:
        colprof_flags = shlex.split(args.colprof_flags)
    else:
        # We build from the config: -qX -S <gamut> + extra_flags
        # But we cannot pass the full command to run_pipeline()
        # which builds -A -M -C -D itself. So we prepare the list of
        # "additional" flags: -qX -S <gamut> + extra_flags.
        import shlex as _shlex
        quality = cp_config.get("quality", "h")
        source_gamut_alias = cp_config.get("source_gamut", "AdobeRGB1998")
        extra_flags_str = cp_config.get("extra_flags", "")

        # Resolve source_gamut alias → path
        try:
            from lib.z9_client.config import resolve_source_gamut
            source_gamut_path = resolve_source_gamut(source_gamut_alias)
        except FileNotFoundError as e:
            err(str(e))
            return 1

        colprof_flags = ["-qh" if quality == "h" else f"-q{quality}",
                         "-S", source_gamut_path]
        if extra_flags_str:
            colprof_flags.extend(_shlex.split(extra_flags_str))

    # Display parameters
    print(f"{C.BOLD}🧪 freeglaz ICC profile build{C.R}")
    print(f"  Firmware ICC : {firmware_icc}")
    print(f"  Sidecar      : {sidecar_path}")
    print(f"  ICC output   : {output_icc}")
    print(f"  Descriptor   : {descriptor!r}")
    print(f"  Manufacturer : {manufacturer}")
    print(f"  Model        : {model}")
    print(f"  Copyright    : {copyright_str}")
    print(f"  colprof flags: {' '.join(colprof_flags)}")
    print()

    # Tracing callback
    def on_step(n, total, label, **details):
        stage = details.pop("stage", None)
        prefix_color = {
            "extract": C.GREEN,
            "remap":   C.YELLOW,
            "build":   C.BOLD,
        }.get(stage, C.R)
        stage_label = stage.capitalize() if stage else "Step"

        if label == "read-icc":
            size_kb = details.get("size_bytes", 0) / 1024
            print(f"  [{prefix_color}{stage_label}{C.R} {n}/{total}] "
                  f"Reading firmware ICC ({size_kb:.0f} KB) ...")
        elif label == "cied-found":
            cied_size = details.get("cied_size", 0)
            n_tags = details.get("n_tags", "?")
            print(f"  [{prefix_color}{stage_label}{C.R} {n}/{total}] "
                  f"CIED tag: {cied_size:,} bytes ({n_tags} ICC tags total)")
        elif label == "cgats-parsed":
            n_patches = details.get("n_patches", "?")
            n_bands = details.get("n_spectral_bands", "?")
            r = details.get("spectral_range_nm", (None, None))
            print(f"  [{prefix_color}{stage_label}{C.R} {n}/{total}] "
                  f"CGATS parsed: {n_patches} patches, {n_bands} bands "
                  f"({r[0]}–{r[1]} nm)")
        elif label == "ti3-written":
            size_kb = details.get("size_bytes", 0) / 1024
            print(f"  [{prefix_color}{stage_label}{C.R} {n}/{total}] "
                  f"raw ti3 written: {size_kb:.0f} KB")
        elif label == "read-ti3":
            print(f"  [{prefix_color}{stage_label}{C.R} {n}/{total}] "
                  f"Reading raw ti3 ({details.get('n_patches', '?')} patches) ...")
        elif label == "read-sidecar":
            print(f"  [{prefix_color}{stage_label}{C.R} {n}/{total}] "
                  f"Reading sidecar ({details.get('n_patches', '?')} patches) ...")
        elif label == "remap":
            n_mod = details.get("n_modified", "?")
            n_same = details.get("n_unchanged", "?")
            n_miss = details.get("n_missing_in_sidecar", "?")
            extra = (f", {C.YELLOW}{n_miss} missing in sidecar{C.R}"
                     if n_miss else "")
            print(f"  [{prefix_color}{stage_label}{C.R} {n}/{total}] "
                  f"RGB substitution: {n_mod} modified, {n_same} unchanged"
                  f"{extra}")
        elif label == "written":
            size_kb = details.get("size_bytes", 0) / 1024
            print(f"  [{prefix_color}{stage_label}{C.R} {n}/{total}] "
                  f"remapped ti3 written: {size_kb:.0f} KB")
        elif label == "colprof-launch":
            cmd = details.get("command", "?")
            if args.verbose:
                print(f"  [{prefix_color}{stage_label}{C.R} {n}/{total}] "
                      f"Launching Argyll colprof...")
                print(f"      {C.DIM}{cmd}{C.R}")
            else:
                print(f"  [{prefix_color}{stage_label}{C.R} {n}/{total}] "
                      f"Launching Argyll colprof...")
        elif label == "colprof-done":
            # Robustness: the lib may send the size under several keys
            # depending on the version. Final fallback = read the produced file.
            icc_size = (
                details.get("icc_size_bytes")
                or details.get("output_icc_size_bytes")
                or details.get("size_bytes")
                or 0
            )
            if not icc_size and output_icc and Path(output_icc).is_file():
                icc_size = Path(output_icc).stat().st_size
            rc = details.get("returncode", "?")
            print(f"  [{prefix_color}{stage_label}{C.R} {n}/{total}] "
                  f"colprof OK (returncode={rc}, ICC produit : "
                  f"{icc_size:,} bytes)")

    # Launch the pipeline
    ops = ProfilingOps(z9_client=client)
    try:
        result = ops.run_pipeline(
            firmware_icc_path=firmware_icc,
            sidecar_path=sidecar_path,
            output_icc_path=output_icc,
            descriptor=descriptor,
            manufacturer=manufacturer,
            model=model,
            copyright_str=copyright_str,
            colprof_flags=colprof_flags,
            colprof_path=args.colprof_path,
            ti3_raw_path=Path(args.ti3_raw).resolve() if args.ti3_raw else None,
            ti3_remapped_path=Path(args.ti3_remapped).resolve() if args.ti3_remapped else None,
            on_step=on_step,
        )
    except FileNotFoundError as e:
        print()
        err(str(e))
        return 1
    except RuntimeError as e:
        print()
        err(str(e))
        return 1
    except Exception as e:
        print()
        err(f"{type(e).__name__}: {e}")
        return 1

    # Summary
    print()
    ok(f"freeglaz ICC profile built successfully")
    print(f"  Output             : {result.output_icc_path}")
    size_kb = result.icc_size_bytes / 1024
    print(f"  ICC size           : {result.icc_size_bytes:,} bytes ({size_kb:.1f} KB)")
    print(f"  Patches used       : {result.n_patches}")
    print(f"  Descriptor         : {descriptor!r}")
    print(f"  Intermediate ti3   :")
    print(f"    raw      : {C.DIM}{result.ti3_raw_path}{C.R}")
    print(f"    remapped : {C.DIM}{result.ti3_remapped_path}{C.R}")
    print()

    # Next-step tips
    print(f"💡 Possible next steps:")
    print(f"   • Inspect the profile: {C.DIM}iccdump -v 2 {result.output_icc_path}{C.R}")
    print(f"   • Import into the Z9 (auto backup before overwrite):")
    print(f"     {C.DIM}freeglaz paper import-icc <paper> {result.output_icc_path}{C.R}")
    return 0


# ─── FREE chart (sovereign pipeline: create / list / print / scan) ─────

def cmd_chart_create(args, client):
    """Generate a FREE chart (any N patches / N columns) from a .ti1.

    Composition = upstream user choice (targen, homemade, concat…). Produces
    charts/<chart_id>/: chart.tif (16-bit + conformant marks + ID in footer) +
    chart.json (descriptor: consistent scanLayout, patches, metadata).

    ⚠️ COLOR: the chart is tagged with the slot's RESIDENT profile, read LIVE
    (export_icc), like `chart generate` — the Z9 firmware consumes the source profile,
    so source=OutputIntent=RESIDENT is the only path to "raw device values".
    Requires --paper + --gloss-enhancer + reachable Z9. NO sRGB.
    """
    import tempfile
    from lib.z9_client.sol_chart import orchestrate_free_chart

    ti1 = Path(args.ti1)
    if not ti1.exists():
        err(f".ti1 not found: {ti1}")
        return 1

    # 1. Resolve the slot (paper) + GE → RESIDENT profile read LIVE (export_icc),
    #    EXACTLY like `chart generate --tag-mode resident`. Never the cache.
    if not args.gloss_enhancer:
        err("--gloss-enhancer (-g) required: the GE ON/OFF slot determines the "
            "resident profile that tags the chart (source=OutputIntent=resident).\n"
            f"  E.g.: freeglaz chart create {args.ti1!r} --paper <paper> "
            f"-f {args.format} -c {args.columns} -g OFF")
        return 1
    try:
        paper = resolve_paper_interactive(client, args.paper)
    except Z9PaperError as e:
        err(str(e))
        return 1

    ge_target = args.gloss_enhancer
    _fd, _tmp = tempfile.mkstemp(suffix=".icc", prefix="freeglaz_chart_tag_")
    os.close(_fd)
    resident_icc = Path(_tmp)
    try:
        client.paper.export_icc(
            ref=paper["id"], output_path=str(resident_icc),
            gloss_enhancer=ge_target, quality="BEST", color_space="RGB",
            _pre_resolved=paper,
        )
    except Z9Error as e:
        resident_icc.unlink(missing_ok=True)
        err(f"LIVE read of the GE={ge_target} slot resident profile "
            f"failed ({e}).\n"
            f"  The profiling chart MUST be tagged with the REAL slot profile "
            f"(no cache, no sRGB). Check that the Z9 is reachable/awake.")
        return 1

    # 2. SERIAL = per-serial HOME of the chart (charts/<serial>/<chart_id>/) + profile
    #    storage key. SINGLE bridge store.get_serial (memoized live) — the Z9 just
    #    responded to export_icc, so reliable here.
    from lib.z9_client.store import get_serial
    try:
        serial = get_serial(client)
    except Z9Error as e:
        resident_icc.unlink(missing_ok=True)
        err(f"Reading the Z9 serial number failed ({e}).")
        return 1

    # 3. Generate, embedding the resident as source ICC
    try:
        res = orchestrate_free_chart(
            ti1, media_key=args.format, columns=args.columns,
            reference_icc_path=resident_icc, gloss_enhancer=ge_target,
            tag_source="resident-live",
            source=args.source, dpi=args.dpi,
            paper={"name": paper.get("name"), "media_id": paper.get("id"),
                   "gloss_enhancer": ge_target, "serial": serial},
        )
    except (ValueError, FileNotFoundError) as e:
        err(str(e))
        return 1
    finally:
        resident_icc.unlink(missing_ok=True)   # the resident is embedded in the TIFF

    feas = res.feasibility
    import json as _json
    desc = _json.loads(Path(res.descriptor_path).read_text())
    cm = desc["color_management"]
    print(f"{C.BOLD}🎯 Free chart generated{C.R}")
    print(f"  chart_id   : {C.BOLD}{res.chart_id}{C.R}")
    print(f"  patches    : {res.n_patches}  ({res.cols} col × {res.nrows} rows)")
    gap_col = C.GREEN if feas.gap_mm > 1.0 else C.YELLOW
    print(f"  feasibility: {gap_col}mark↔patch gap {feas.gap_mm:.2f} mm{C.R}")
    print(f"  color tag  : {C.GREEN}resident live{C.R} GE={ge_target}  "
          f"{C.DIM}({cm['icc_name']}){C.R}")
    print(f"  paper      : {paper.get('name')}")
    print(f"  folder     : {res.chart_dir}")
    print(f"  TIFF       : {Path(res.tiff_path).name}")
    pid = desc["printed_id"]
    foot = (f"{C.GREEN}rendered in footer{C.R}" if pid["rendered_on_tiff"]
            else f"{C.YELLOW}NOT rendered (insufficient bottom margin){C.R}")
    print(f"  printed ID : {foot}  {C.DIM}{pid['text']}{C.R}")
    print(f"\n💡 Print (consistent GE) then scan:")
    print(f"   {C.DIM}freeglaz chart print {res.chart_id} --gloss "
          f"{'FULLPAGE' if ge_target == 'FULLPAGE' else 'OFF'}{C.R}")
    print(f"   {C.DIM}freeglaz chart scan {res.chart_id}{C.R}")
    return 0


