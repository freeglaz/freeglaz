def cmd_chart_extract_cgats(args, client):
    """
    Extract the CGATS measurements embedded in a Z9 firmware ICC profile
    (CIED tag) into a native Argyll .ti3 file.

    Purely local operation (no Z9 communication). Useful for:
      - Recovering the HP factory measurements of a firmware profile
      - Pre-processing for `freeglaz chart concat-ti3` (multi-pass)
      - Inspecting the spectral measurements of an ICC

    Usage:
        freeglaz chart extract-cgats <firmware.icc> -o <output.ti3>
        freeglaz chart extract-cgats hp_factory.icc -o hp.ti3 \\
            --descriptor "HP factory Baryta 2026-02-16"
    """
    from lib.z9_client.profiling import ProfilingOps

    icc_path = Path(args.icc).resolve()
    if not icc_path.exists():
        err(f"ICC not found: {icc_path}")
        return 1

    # Default output: <icc_basename>.ti3 in the ICC's folder
    if args.output:
        output_path = Path(args.output).resolve()
    else:
        output_path = icc_path.parent / (icc_path.stem + ".ti3")

    # Default descriptor
    descriptor = args.descriptor or f"freeglaz from {icc_path.stem}"

    print(f"{C.BOLD}📥 CGATS extraction from ICC{C.R}")
    print(f"  ICC source   : {icc_path}")
    print(f"  ti3 output   : {output_path}")
    print(f"  Descriptor   : {descriptor!r}")
    print()

    def on_step(n, total, label, **details):
        if label == 'read-icc':
            size_kb = os.path.getsize(icc_path) / 1024
            print(f"  [{C.GREEN}Extract{C.R} {n}/{total}] ICC read ({size_kb:.0f} KB)")
        elif label == 'cied-found':
            cied_size = details.get('cied_size', 0)
            n_tags = details.get('n_tags', 0)
            print(f"  [{C.GREEN}Extract{C.R} {n}/{total}] CIED tag found: "
                  f"{cied_size:,} bytes ({n_tags} ICC tags total)")
        elif label == 'cgats-parsed':
            n_patches = details.get('n_patches', 0)
            n_bands = details.get('n_spectral_bands', 0)
            spec_range = details.get('spectral_range', (0, 0))
            print(f"  [{C.GREEN}Extract{C.R} {n}/{total}] CGATS parsed: "
                  f"{n_patches} patches, {n_bands} spectral bands "
                  f"({spec_range[0]}–{spec_range[1]} nm)")
        elif label == 'ti3-written':
            size_kb = details.get('ti3_size_bytes', 0) / 1024
            print(f"  [{C.GREEN}Extract{C.R} {n}/{total}] ti3 written: {size_kb:.0f} KB")
        elif label == 'xyz-corrected':
            size_kb = details.get('ti3_size_bytes', 0) / 1024
            method = details.get('method', 'Argyll spec2cie')
            print(f"  [{C.GREEN}Extract{C.R} {n}/{total}] XYZ corrected via "
                  f"{C.BOLD}{method}{C.R} → ti3 = {size_kb:.0f} KB")
        elif label == 'xyz-correction-skipped':
            reason = details.get('reason', 'spec2cie unavailable')
            print(f"  [{C.YELLOW}Extract{C.R} {n}/{total}] ⚠ XYZ correction "
                  f"skipped: {reason}")
            print(f"  {C.YELLOW}↳ XYZ will have a bias (Δa*≈+6, Δb*≈+4 on "
                  f"paper white). Install Argyll to fix.{C.R}")

    ops = ProfilingOps(z9_client=client)
    try:
        result = ops.extract_cgats_from_icc(
            icc_path,
            output_path=output_path,
            descriptor=descriptor,
            on_step=on_step,
        )
    except FileNotFoundError as e:
        print()
        err(str(e))
        return 1
    except ValueError as e:
        print()
        err(str(e))
        return 1

    print()
    ok(f"ti3 extracted successfully")
    print(f"  Output              : {result.output_path}")
    print(f"  Patches             : {result.n_patches}")
    print(f"  Spectral bands      : {result.n_spectral_bands} "
          f"({result.spectral_range_nm[0]}–{result.spectral_range_nm[1]} nm)")
    print(f"  Original descriptor : {result.original_descriptor!r}")
    if result.original_created:
        print(f"  Original created    : {result.original_created}")
    print(f"  ti3 size            : {result.ti3_size_bytes:,} bytes")
    print()
    print(f"💡 Possible next steps:")
    print(f"   • Inspect the ti3: {C.DIM}head -20 {result.output_path}{C.R}")
    print(f"   • Concatenate multi-pass: {C.DIM}freeglaz chart concat-ti3 "
          f"--ti3 {result.output_path} --ti3 <other.ti3> -o multipass.ti3{C.R}")

    return 0


def cmd_chart_concat_ti3(args, client):
    """
    Concatenate several Argyll ti3 files into one (multi-pass).

    Strategic pivot of the freeglaz project: combine the measurements of several
    charts (typically HP factory + freeglaz shifted cubes) into a single
    unified ti3 that is passed to colprof to produce an enriched ICC profile.

    Required consistency (checked automatically):
      - Identical spectral bands (wavelengths and count)
      - Same RGB columns
      - Same physical paper, same printmode, same cartridges, same CLC
      - Ideally: same day (limits spectro drift)

    Duplicates (8 device cube corners typically present in both HP and freeglaz):
        --dedup keep   : keeps duplicates (default, Argyll averages implicitly)
        --dedup first  : keeps only the first occurrence
        --dedup last   : override by the following sources
        --dedup mean   : explicit mean of the measurements

    Usage:
        freeglaz chart concat-ti3 --ti3 pass1.ti3 --ti3 pass2.ti3 -o multipass.ti3
        freeglaz chart concat-ti3 \\
            --ti3 pass1.ti3 --ti3 pass2.ti3 --ti3 pass3.ti3 \\
            --label "pass1" --label "skytones" --label "grayramp" \\
            -o multipass_3passes.ti3 \\
            --dedup mean
    """
    from lib.z9_client.multipass import concat_ti3 as _concat_ti3

    if len(args.ti3) < 2:
        err("At least 2 --ti3 sources required for a concatenation")
        return 1

    if args.label and len(args.label) != len(args.ti3):
        err(f"Number of --label ({len(args.label)}) ≠ number of --ti3 ({len(args.ti3)})")
        return 1

    output_path = Path(args.output).resolve()

    print(f"{C.BOLD}🔀 freeglaz multi-pass concatenation{C.R}")
    print(f"  Sources     : {len(args.ti3)}")
    for i, path in enumerate(args.ti3, 1):
        lbl = args.label[i - 1] if args.label else Path(path).stem
        print(f"    [{i}] {lbl} — {path}")
    print(f"  ti3 output  : {output_path}")
    print(f"  Descriptor  : {args.descriptor!r}" if args.descriptor else
          f"  Descriptor  : (auto-generated)")
    print(f"  Dedup       : {args.dedup}")
    print()

    def on_step(stage, label, n=0, total=0, **details):
        icon = {'load': '📥', 'check': '🔍', 'merge': '🔀', 'write': '💾'}.get(stage, '•')
        stage_color = {
            'load':  C.GREEN,
            'check': C.YELLOW,
            'merge': C.BOLD,
            'write': C.DIM,
        }.get(stage, C.R)
        prefix = f"  {icon} [{stage_color}{stage.capitalize()}{C.R}]"
        if n and total:
            print(f"{prefix} [{n}/{total}] {label}")
        else:
            print(f"{prefix} {label}")

    try:
        result = _concat_ti3(
            source_paths=[Path(p).resolve() for p in args.ti3],
            output_path=output_path,
            labels=args.label,
            descriptor=args.descriptor,
            dedup_strategy=args.dedup,
            on_step=on_step,
        )
    except FileNotFoundError as e:
        print()
        err(str(e))
        return 1
    except ValueError as e:
        print()
        err(str(e))
        return 1

    print()
    ok(f"Concatenation succeeded")
    print(f"  Output               : {result.output_path}")
    print(f"  Input patches        : {result.n_patches_input}")
    print(f"  Output patches       : {result.n_patches_total}")
    print(f"  Duplicates dropped   : {result.n_duplicates_dropped} "
          f"(strategy: {result.dedup_strategy})")
    if result.spectral_bands:
        print(f"  Spectral bands       : {len(result.spectral_bands)} "
              f"({result.spectral_bands[0]}–{result.spectral_bands[-1]} nm)")
    if result.dropped_columns:
        print(f"  Columns dropped      : {result.dropped_columns}")
        print(f"                         (Argyll will recompute them from the spectra)")
    print()
    print(f"💡 Next step:")
    base = str(result.output_path).rsplit('.', 1)[0]
    print(f"   {C.DIM}colprof -v -qh \\")
    print(f"     -S /System/Library/ColorSync/Profiles/AdobeRGB1998.icc \\")
    print(f"     -cmt -dpp \\")
    print(f"     -A \"HP\" -M \"DesignJet Z9\" -C \"(c) ...\" \\")
    print(f"     -D \"freeglaz multipass\" \\")
    print(f"     {base}{C.R}")

    return 0


def cmd_chart_fix_xyz(args, client):
    """
    Recompute the XYZ of a ti3 via Argyll spec2cie (official CIE × D50 table).

    Useful for correcting old ti3 files (produced before the XYZ fix).
    ti3 files produced by `chart extract-cgats` today already have correct XYZ
    (automatic post-extraction correction).

    The fix corrects the Δa*≈+6 Δb*≈+4 bias of the local _CIE_D50_20NM table
    which produced a paper white shifted toward warm (cool/blue shift in
    soft proof on the derived ICC profiles).

    2-step pipeline:
      1. spec2cie -i D50 -o 1931_2 input.ti3 → tmp.ti3 (XYZ in 0-1)
      2. Multiply XYZ × 100 → output.ti3 (XYZ in 0-100 pct Argyll)

    Usage:
        freeglaz chart fix-xyz <input.ti3>                  # in-place
        freeglaz chart fix-xyz <input.ti3> -o <output.ti3>  # new file
    """
    from lib.z9_client.profiling import apply_spec2cie_xyz_correction

    input_path = Path(args.input).resolve()
    if not input_path.exists():
        err(f"ti3 not found: {input_path}")
        return 1

    if args.output:
        output_path = Path(args.output).resolve()
        in_place = False
    else:
        output_path = input_path
        in_place = True

    print(f"{C.BOLD}🔧 XYZ correction via Argyll spec2cie{C.R}")
    print(f"  Input        : {input_path}")
    if in_place:
        print(f"  Output       : {C.YELLOW}in-place{C.R} (overwrites the input)")
    else:
        print(f"  Output       : {output_path}")
    print(f"  Illuminant   : {args.illuminant}")
    print(f"  Observer     : {args.observer}")
    print()

    try:
        result_path = apply_spec2cie_xyz_correction(
            input_path,
            output_path=output_path,
            illuminant=args.illuminant,
            observer=args.observer,
        )
    except FileNotFoundError as e:
        print()
        err(str(e))
        return 1
    except RuntimeError as e:
        print()
        err(str(e))
        return 1

    size_kb = os.path.getsize(result_path) / 1024
    ok(f"XYZ corrected via Argyll spec2cie -i {args.illuminant} -o {args.observer}")
    print(f"  Output     : {result_path}")
    print(f"  Size       : {size_kb:.0f} KB")
    print()
    print(f"💡 Next step: colprof to produce the final ICC profile")

    return 0


def cmd_chart_build_multipass_profile(args, client):
    """
    Build a multi-pass ICC profile from N sources (firmware ICC or ti3).

    All-in-one pipeline that chains:
      1. For each --source .icc: extract-cgats → intermediate ti3
      2. Concat all ti3 files (direct sources + extracted) into 1 multipass ti3
      3. colprof from the freeglaz config → final ICC

    Automatic input-type detection by extension (.icc/.icm = ICC to
    extract, .ti3 = already ready). The colprof parameters (quality, source
    gamut, manufacturer, model, copyright) come from the config
    (~/.freeglazrc.toml or defaults). Partial override via CLI flags.

    Usage:
        # 2 sources, ICC + ti3 mixed
        freeglaz chart build-multipass-profile \\
            --source pass1.icc \\
            --source pass2.ti3 \\
            -o baryta_multipass.icc

        # 3 sources with custom labels
        freeglaz chart build-multipass-profile \\
            --source pass1.icc --label "pass1" \\
            --source pass2.icc --label "cube_decale" \\
            --source pass3.icc --label "skytones" \\
            -o multipass_3passes.icc \\
            -D "freeglaz Baryta multipass 3 passes AdobeRGB"

    ⚠️ DEPRECATED as the default multipass flow (firmware cube-shift assembly).
    Free-chart enrichment (webapp: slot → Enrich; automatic base+pass concat)
    replaces it. Command kept (manual assembly of N ti3 files remains
    possible via `concat-ti3` + `chart build-profile`).
    """
    warn("`chart build-multipass-profile` is DEPRECATED (cube-shift flow). Prefer "
         "free-chart enrichment (webapp: slot → Enrich). Command "
         "kept for compatibility.")
    import shutil
    from lib.z9_client.profiling import ProfilingOps
    from lib.z9_client.multipass import concat_ti3
    from lib.z9_client.config import get_config, resolve_source_gamut

    sources = args.source or []
    if len(sources) < 2:
        err(f"At least 2 --source sources required (received: {len(sources)})")
        return 1

    if args.label and len(args.label) != len(sources):
        err(f"Number of --label ({len(args.label)}) ≠ "
            f"number of --source ({len(sources)})")
        return 1

    # Resolve absolute paths + check existence
    source_paths = []
    for s in sources:
        p = Path(s).resolve()
        if not p.exists():
            err(f"Source not found: {p}")
            return 1
        if p.suffix.lower() not in ('.icc', '.icm', '.ti3'):
            err(f"Unsupported extension: {p.suffix} (expected .icc/.icm/.ti3)")
            return 1
        source_paths.append(p)

    # Output ICC
    output_icc = Path(args.output).resolve()
    output_stem = output_icc.with_suffix('')
    output_dir = output_icc.parent
    output_dir.mkdir(parents=True, exist_ok=True)

    multipass_ti3 = output_stem.with_suffix('.ti3')

    # ─── Config ───────────────────────────────────────────────────────
    config = get_config()
    cp_config = config.get("colprof", {})
    mp_config = config.get("multipass", {})

    # colprof parameters (CLI flags > config)
    manufacturer = args.manufacturer or cp_config.get("manufacturer", "HP")
    model = args.model or cp_config.get("model", "DesignJet Z9")
    copyright_str = args.copyright_str or cp_config.get("copyright", "No copyright, use freely")
    # Sanitize ASCII for Argyll (ICC `cprt` tag does not accept multi-byte UTF-8)
    copyright_str, _cp_was_sanitized = _sanitize_copyright_ascii(copyright_str)
    if _cp_was_sanitized:
        warn(f"Copyright sanitized for Argyll (ASCII-safe): {copyright_str!r}")
    quality = args.quality or cp_config.get("quality", "h")
    source_gamut_alias = args.source_gamut or cp_config.get("source_gamut", "AdobeRGB1998")
    extra_flags_str = cp_config.get("extra_flags", "-cmt -dpp")

    try:
        source_gamut_path = resolve_source_gamut(source_gamut_alias)
    except FileNotFoundError as e:
        err(str(e))
        return 1

    dedup_strategy = args.dedup or mp_config.get("dedup", "keep")
    keep_intermediates = args.keep_intermediates or mp_config.get("keep_intermediates", False)

    # desc = stem of the output file (project rule, cf. webapp charts.py build).
    # explicit --descriptor honored (conscious override).
    descriptor = args.descriptor or output_icc.stem

    # ─── Display parameters ───────────────────────────────────────────
    print(f"{C.BOLD}🚀 freeglaz multipass ICC profile build{C.R}")
    print(f"  Sources       : {len(source_paths)}")
    for i, sp in enumerate(source_paths, start=1):
        lbl = (args.label[i - 1] if args.label else sp.stem)
        kind = ".icc" if sp.suffix.lower() in ('.icc', '.icm') else ".ti3"
        print(f"    [{i}] {lbl} ({kind}) — {sp}")
    print(f"  ICC output    : {output_icc}")
    print(f"  ti3 multipass : {multipass_ti3}")
    print(f"  Descriptor    : {descriptor!r}")
    print(f"  colprof config:")
    print(f"    Quality     : {quality}")
    print(f"    Source gamut: {source_gamut_alias} → {source_gamut_path}")
    print(f"    Mfr/Model   : {manufacturer} / {model}")
    print(f"    Copyright   : {copyright_str}")
    print(f"    Extra flags : {extra_flags_str}")
    print(f"  Multipass     :")
    print(f"    Dedup       : {dedup_strategy}")
    print(f"    Keep interm.: {keep_intermediates}")
    print()

    # ─── Step 1: extract the .icc files into intermediate ti3 ─────────
    ops = ProfilingOps(z9_client=client)
    intermediate_ti3s = []
    ti3_paths_for_concat = []
    labels_for_concat = []

    for i, sp in enumerate(source_paths, start=1):
        lbl = (args.label[i - 1] if args.label else sp.stem)
        labels_for_concat.append(lbl)

        if sp.suffix.lower() in ('.icc', '.icm'):
            ti3_intermediate = output_dir / f"{output_stem.name}_pass{i}.ti3"
            print(f"  {C.GREEN}[Extract {i}]{C.R} {lbl}: extract-cgats {sp.name}")
            try:
                result_ext = ops.extract_cgats_from_icc(
                    sp,
                    output_path=ti3_intermediate,
                    descriptor=f"Pass {i} from {sp.stem}",
                    xyz_correction=True,
                )
            except (FileNotFoundError, ValueError) as e:
                err(f"extract-cgats failed on {sp.name}: {e}")
                for p in intermediate_ti3s:
                    p.unlink(missing_ok=True)
                return 1
            print(f"             → {ti3_intermediate.name} "
                  f"({result_ext.n_patches} patches)")
            intermediate_ti3s.append(ti3_intermediate)
            ti3_paths_for_concat.append(ti3_intermediate)
        else:
            print(f"  {C.GREEN}[Ti3 {i}]{C.R} {lbl}: {sp.name} (used as-is)")
            ti3_paths_for_concat.append(sp)

    print()

    # ─── Step 2: concatenation ────────────────────────────────────────
    print(f"  {C.BOLD}[Concat]{C.R} Merging {len(ti3_paths_for_concat)} sources "
          f"(dedup={dedup_strategy})")

    def on_concat_step(stage, label, n=0, total=0, **details):
        if stage == 'merge' and 'ajout' in label:
            print(f"             ↳ {label}")

    try:
        concat_result = concat_ti3(
            source_paths=ti3_paths_for_concat,
            output_path=multipass_ti3,
            labels=labels_for_concat,
            descriptor=descriptor,
            dedup_strategy=dedup_strategy,
            on_step=on_concat_step,
        )
    except (FileNotFoundError, ValueError) as e:
        err(f"concatenation failed: {e}")
        for p in intermediate_ti3s:
            p.unlink(missing_ok=True)
        return 1

    print(f"             → {multipass_ti3.name} ({concat_result.n_patches_total} patches "
          f"= {concat_result.n_patches_input} input − {concat_result.n_duplicates_dropped} dup)")

    # ─── Step 3: colprof ──────────────────────────────────────────────
    import shlex as _shlex
    import subprocess

    from lib.z9_client.argyll import find_argyll_binary
    colprof_path = find_argyll_binary("colprof")     # durable resolution (PATH + system paths)
    if colprof_path is None:
        err("colprof not found (Argyll-CMS not installed?)")
        if not keep_intermediates:
            for p in intermediate_ti3s:
                p.unlink(missing_ok=True)
        return 1

    quality_flag = f"-q{quality}"
    extra_flags_list = _shlex.split(extra_flags_str) if extra_flags_str else []

    cmd = [colprof_path, "-v", quality_flag, "-S", source_gamut_path]
    cmd.extend(extra_flags_list)
    cmd.extend([
        "-A", manufacturer,
        "-M", model,
        "-C", copyright_str,
        "-D", descriptor,
        str(output_stem),
    ])

    print()
    print(f"  {C.BOLD}[Colprof]{C.R} Building the ICC profile ...")
    if args.verbose:
        print(f"             {C.DIM}{' '.join(cmd)}{C.R}")

    try:
        cp_result = subprocess.run(
            cmd, capture_output=True, text=True, timeout=600,
        )
    except subprocess.TimeoutExpired:
        err("colprof timeout (>10 min)")
        return 1
    except FileNotFoundError:
        err(f"colprof not found: {colprof_path}")
        return 1

    if cp_result.returncode != 0:
        err(f"colprof failed (returncode={cp_result.returncode})")
        if cp_result.stderr:
            print(f"  stderr (last 10 lines):")
            for line in cp_result.stderr.split('\n')[-10:]:
                print(f"    {line}")
        return 1

    if not output_icc.exists():
        err(f"colprof finished but ICC not found: {output_icc}")
        return 1

    icc_size = os.path.getsize(output_icc)
    print(f"             → {output_icc.name} ({icc_size:,} bytes / "
          f"{icc_size/1024:.1f} KB)")

    # ─── Step 4: Cleanup ──────────────────────────────────────────────
    if not keep_intermediates and intermediate_ti3s:
        print()
        print(f"  {C.DIM}[Cleanup]{C.R} Removing the {len(intermediate_ti3s)} "
              f"intermediate ti3 files (use --keep-intermediates to keep them)")
        for p in intermediate_ti3s:
            p.unlink(missing_ok=True)

    # ─── Summary ──────────────────────────────────────────────────────
    print()
    ok(f"Multipass ICC profile built")
    print(f"  Output         : {output_icc}")
    print(f"  ti3 multipass  : {multipass_ti3}")
    print(f"  Sources        : {len(source_paths)} "
          f"({concat_result.n_patches_total} patches)")
    print(f"  ICC size       : {icc_size:,} bytes ({icc_size/1024:.1f} KB)")
    if intermediate_ti3s and keep_intermediates:
        print(f"  Intermediates  :")
        for p in intermediate_ti3s:
            print(f"    {p}")
    print()
    print(f"💡 Possible next steps:")
    print(f"   • Check quality: {C.DIM}freeglaz profile check {output_icc}{C.R}")
    print(f"   • Install in ColorSync: {C.DIM}freeglaz profile install {output_icc}{C.R}")
    print(f"   • Import into the Z9:")
    print(f"     {C.DIM}freeglaz paper import-icc <paper> {output_icc}{C.R}")

    return 0


def cmd_chart_generate_multipass(args, client):
    """
    Generate a multipass chart (.ti1 + JSON sidecar).

    Combines 3 cube_shift modes × 3 extras modes = 9 strategies.

    The produced .ti1 is directly consumable by:
      freeglaz chart generate --paper <paper> --ti1 <out.ti1>

    ⚠️ DEPRECATED — the shifted cube (343+121 fixed 464) worked around the inability
    to generate free patches. The free-chart track (free targen + native SOL scan +
    concat enrichment) replaces it. See `chart create` / Papers → Enrich.
    """
    warn("`chart generate-multipass` is DEPRECATED (firmware cube-shift). Prefer the "
         "free chart (`chart create`) + enrichment (webapp: slot → Enrich). "
         "Command kept for compatibility.")
    from lib.z9_client.multipass_chart import MultipassChartOps

    output_ti1 = Path(args.output).resolve()
    if output_ti1.exists() and not args.force:
        err(f"Output already exists: {output_ti1}")
