# Standard paper formats for the --paper shortcut
_PAPER_STANDARD = {
    "A4": (210.0, 297.0),
    "A3": (297.0, 420.0),
    "A2": (420.0, 594.0),
}


def _resolve_print_paper(client, paper_arg, sheet_w_arg, sheet_h_arg):
    """
    Resolves the --paper argument to (paper_id, paper_name, sheet_w, sheet_h, media_source).

    media_source is "ROLL" or "MANUALFEED" — determined by what is
    loaded on the Z9 (IdForPrinting field in MediaSystem.json).

    Resolution logic (by priority):
      1. paper_arg = "loaded" / "current" → paper loaded on the Z9
         + its dimensions from MediaSystem.json
      2. paper_arg = "A4"/"A3"/"A2" → standard format (MANUAL_FEED only),
         the paper_id stays that of the loaded paper (otherwise error)
      3. paper_arg = partial name or MediaID → resolution via paper.get/get_by_name,
         media_source MANUALFEED by default

    For ROLL: sheet_h_mm is None on output if not specified by
    --sheet-height; the caller must compute it = image_h + 10mm.
    """
    if not paper_arg:
        # Default: loaded paper
        paper_arg = "loaded"

    arg_lower = paper_arg.lower().strip()

    # Case 1: loaded paper
    if arg_lower in ("loaded", "current"):
        media_info = client.device.loaded_media_info()
        if media_info is None:
            raise Z9PaperError(
                "No loaded paper detected — specify --paper with a name or a format"
            )
        paper = client.paper.get(media_info["media_id"])
        if paper is None:
            raise Z9PaperError(
                f"Loaded paper (id={media_info['media_id']}) not found in the list"
            )

        # Determine media_source from the Z9 JSON
        # IdForPrinting is "ROLL" for a roll or "MANUALFEED"/"SHEET" for a sheet
        source_raw = (media_info.get("source") or "").upper().strip()
        if "ROLL" in source_raw:
            media_source = "ROLL"
        else:
            media_source = "MANUALFEED"

        width_mm = media_info.get("width_mm")
        if width_mm is None:
            width_mm = sheet_w_arg

        # For ROLL: Z9 returns RemainingLength (remaining roll length),
        # which has nothing to do with the job height. We ignore it and leave
        # sheet_h_mm = None or sheet_h_arg → the caller computes it from the image.
        # For MANUALFEED: Z9 returns the measured sheet height.
        if media_source == "ROLL":
            length_mm = sheet_h_arg  # may be None
        else:
            length_mm = media_info.get("length_mm")
            if length_mm is None:
                length_mm = sheet_h_arg

            # Standard format inference for MANUAL_FEED if nothing provided
            if length_mm is None and width_mm is not None:
                for fmt_name, (fw, fh) in _PAPER_STANDARD.items():
                    if abs(width_mm - fw) < 2.0:  # 2mm tolerance
                        length_mm = fh
                        break

            if width_mm is None or length_mm is None:
                raise Z9PaperError(
                    f"Incomplete sheet dimensions (w={width_mm}, h={length_mm}). "
                    f"The Z9 does not give the length of a MANUAL_FEED sheet. "
                    f"Specify --paper A4/A3/A2 or --sheet-width X --sheet-height Y"
                )

        if width_mm is None:
            raise Z9PaperError(
                f"Loaded paper width unknown. "
                f"Specify --sheet-width X"
            )

        return (
            media_info["media_id"],
            paper.get("name", "Loaded paper"),
            width_mm, length_mm,
            media_source,
        )

    # Case 2: standard format (A4/A3/A2) — MANUALFEED logic only
    upper = paper_arg.upper().strip()
    if upper in _PAPER_STANDARD:
        # Standard format: we take the loaded paper for the MediaID
        media_info = client.device.loaded_media_info()
        if media_info is None:
            raise Z9PaperError(
                f"--paper {upper} requires a loaded paper (for the MediaID). "
                "Pass a paper name explicitly instead."
            )
        paper = client.paper.get(media_info["media_id"])
        w, h = _PAPER_STANDARD[upper]
        return (
            media_info["media_id"],
            f"{upper} ({paper.get('name', '?')})",
            w, h,
            "MANUALFEED",
        )

    # Case 3: partial name or hex MediaID
    # If the named paper matches the paper currently loaded on the Z9,
    # we use the real dimensions and media_source (roll or manual feed).
    # Otherwise fall back to MANUALFEED + A3 (= historical behavior).
    # Attempt 1: direct MediaID (32 hex chars)
    if len(paper_arg) == 32 and all(c in "0123456789ABCDEFabcdef" for c in paper_arg):
        paper = client.paper.get(paper_arg.upper())
        if paper:
            return _build_paper_result(paper, sheet_w_arg, sheet_h_arg, client)

    # Attempt 2: partial name
    matches = client.paper.get_by_name(paper_arg)
    if len(matches) == 0:
        raise Z9PaperError(f"No paper matches '{paper_arg}'")
    if len(matches) > 1:
        names = ", ".join(m.get("name", "?") for m in matches[:5])
        raise Z9PaperError(
            f"Several papers match '{paper_arg}': {names} — be more specific"
        )
    return _build_paper_result(matches[0], sheet_w_arg, sheet_h_arg, client)


def _build_paper_result(paper, sheet_w_arg, sheet_h_arg, client=None):
    """Builds the result tuple with auto-detection of the loaded paper.

    If the named paper matches the paper currently loaded on the Z9 and
    no dimension is forced by CLI, we retrieve the real dimensions and
    media_source (roll or manual feed). Otherwise, fall back to
    MANUALFEED + A3.

    :param paper: paper dict from paper.get / get_by_name
    :param sheet_w_arg: sheet width forced by CLI (None = auto)
    :param sheet_h_arg: sheet height forced by CLI (None = auto)
    :param client: Z9Client for looking up the loaded paper (optional)
    """
    detected_source = None
    detected_w = None
    detected_h = None

    if client is not None:
        try:
            media_info = client.device.loaded_media_info()
            if media_info and media_info["media_id"].upper() == paper["id"].upper():
                # Match: we retrieve the real source and dimensions
                source_raw = (media_info.get("source") or "").upper().strip()
                if "ROLL" in source_raw:
                    detected_source = "ROLL"
                else:
                    detected_source = "MANUALFEED"
                detected_w = media_info.get("width_mm")
                # For ROLL, length_mm = RemainingLength which has nothing
                # to do with the job height → leave None so the caller
                # computes it (image_h + 10mm). For MANUALFEED, keep the
                # measured length if available.
                if detected_source == "MANUALFEED":
                    detected_h = media_info.get("length_mm")
        except Exception:
            # Any network or parsing error → silent fallback
            pass

    # Priority: explicit CLI > auto-detection > A3 fallback
    if sheet_w_arg is not None:
        sheet_w = sheet_w_arg
    elif detected_w is not None:
        sheet_w = detected_w
    else:
        sheet_w = 297.0  # A3 fallback

    if sheet_h_arg is not None:
        sheet_h = sheet_h_arg
    elif detected_h is not None:
        sheet_h = detected_h
    elif detected_source == "ROLL":
        # ROLL without a provided height → leave None, the caller will
        # compute it from image_h
        sheet_h = None
    else:
        sheet_h = 420.0  # A3 fallback

    media_source = detected_source if detected_source is not None else "MANUALFEED"

    return (paper["id"], paper.get("name", "?"), sheet_w, sheet_h, media_source)


def _print_progress(stage, data):
    """Progress callback for PrintOps.send()."""
    labels = {
        "validate": "Validating parameters",
        "pdf": "Building PDF/X-4",
        "preflight": "Preflight PDF/X-4",
        "prn": "Building PRN (PJL header)",
        "send": "Transmitting to port 9100",
        "done": "Job transmitted to the Z9",
    }
    label = labels.get(stage, stage)
    if stage == "done":
        result = data.get("result")
        if result and result.sent:
            ok(f"{label} — {result.duration_seconds:.1f}s (printing in progress on the Z9)")
        else:
            warn(f"{label} (not sent)")
    elif stage == "validate":
        info(f"{label}…")
    else:
        info(f"{label}…")


def _resolve_max_detail(client, paper_id, requested):
    """
    Resolves the --max-detail argument according to the paper capabilities.

    Returns (value, warning_msg).

    If the paper does not support MaxDetail and ON is requested, we
    downgrade to OFF with a warning. If the capability is unknown (the
    parser did not find the right field name), we let it through as requested.
    """
    if requested == "OFF":
        return ("OFF", None)

    try:
        caps = client.paper.capabilities(paper_id)
    except Exception:
        # If we can't read the caps, let it through
        return (requested, None)

    if caps is None:
        return (requested, None)

    supports = caps.get("supports_max_detail")
    if supports is False:
        return (
            "OFF",
            f"This paper does not support Maximum Detail (1200dpi) — "
            f"--max-detail ON ignored, forced to OFF",
        )
    if supports is None:
        # Unknown capability — let it through but note it
        return (requested, "MaxDetail capability unknown for this paper — toggle ON applied as-is")
    return ("ON", None)


def _resolve_gloss(client, paper_id, requested):
    """Same for Gloss Enhancer."""
    if requested == "OFF":
        return ("OFF", None)

    try:
        caps = client.paper.capabilities(paper_id)
    except Exception:
        return (requested, None)

    if caps is None:
        return (requested, None)

    supports = caps.get("supports_gloss_enhancer")
    if supports is False:
        return (
            "OFF",
            "This paper does not support the Gloss Enhancer — forced to OFF",
        )
    return (requested, None)


def cmd_print(args, client):
    """Full print pipeline: TIFF/PDF → PDF/X-4 → PRN → Z9."""
    source_path = Path(args.source)
    if not source_path.exists():
        err(f"File not found: {source_path}")
        return 1

    is_pdf = source_path.suffix.lower() == ".pdf"
    is_tiff = source_path.suffix.lower() in (".tif", ".tiff")
    if not (is_pdf or is_tiff):
        err(f"Unsupported format: {source_path.suffix} (expected .tif/.tiff/.pdf)")
        return 1

    # Paper resolution + sheet dimensions + media_source detection
    try:
        paper_id, paper_name, sheet_w, sheet_h, detected_source = _resolve_print_paper(
            client, args.paper, args.sheet_width, args.sheet_height,
        )
    except Z9PaperError as e:
        err(str(e))
        return 1

    # media_source: explicit CLI takes precedence, otherwise auto-detection
    if args.mediasource and args.mediasource != "AUTO":
        media_source = args.mediasource
        if media_source != detected_source:
            warn(
                f"--mediasource {media_source} requested but loaded paper "
                f"detected as {detected_source}. Following your request."
            )
    else:
        media_source = detected_source

    # Image dimensions (from TIFF or args)
    if is_tiff:
        try:
            tiff_info = TiffInfo.from_path(source_path)
            image_w = args.image_width or tiff_info.width_mm
            image_h = args.image_height or tiff_info.height_mm
        except Z9PrintError as e:
            err(str(e))
            return 1
    else:
        # PDF: we need explicit --image-width/--image-height
        if not args.image_width or not args.image_height:
            err("For a PDF source, --image-width and --image-height are required")
            return 1
        image_w = args.image_width
        image_h = args.image_height

    # For ROLL: if sheet_h not specified, compute = top margin (offset_y) +
    # image + bottom margin (5mm). This is the freeglaz "economical" mode (which
    # avoids forcing a minimum format). An explicit offset_y (top-anchored chart
    # placement) MUST be included, otherwise the image overflows the computed
    # sheet and validate() wrongly rejects it (ROLL+offset bug: roll24 strip
    # top-anchored offset_y=27.5).
    # offset_y=5 (ROLL default) → 5+image_h+5 = image_h+10 (historical behavior).
    if media_source == "ROLL" and sheet_h is None:
        _roll_top = args.offset_y if args.offset_y is not None else 5.0
        sheet_h = _roll_top + image_h + 5.0

    # Final dimensions check
    if sheet_w is None or sheet_h is None:
        err(f"Undetermined sheet dimensions (w={sheet_w}, h={sheet_h})")
        return 1

    # Default placement by media_source:
    # - MANUAL_FEED: horizontal and vertical centering
    # - ROLL: image stuck to the top-left corner (5mm margins) since the sheet
    #   hugs the image in economical mode
    if args.offset_x is None:
        if media_source == "ROLL":
            offset_x = 5.0   # fixed left margin in ROLL
        else:
            offset_x = (sheet_w - image_w) / 2  # MANUAL_FEED centering
    else:
        offset_x = args.offset_x

    if args.offset_y is None:
        if media_source == "ROLL":
            offset_y = 5.0   # fixed top margin in ROLL
        else:
            offset_y = (sheet_h - image_h) / 2  # MANUAL_FEED centering
    else:
        offset_y = args.offset_y

    # Paper capabilities resolution
    gloss, gloss_warn = _resolve_gloss(client, paper_id, args.gloss)
    max_detail, md_warn = _resolve_max_detail(client, paper_id, args.max_detail)

    # Job construction
    job = PrintJob(
        tiff_path=source_path if is_tiff else None,
        pdf_path=source_path if is_pdf else None,
        paper_id=paper_id,
        paper_name=paper_name,
        media_source=media_source,
        sheet_w_mm=sheet_w,
        sheet_h_mm=sheet_h,
        image_w_mm=image_w,
        image_h_mm=image_h,
        offset_x_mm=offset_x,
        offset_y_mm=offset_y,
        gloss=gloss,
        quality=args.quality,
        rendermode=args.rendermode,
        max_detail=max_detail,
        drytime=args.drytime,
        cutter="OFF" if getattr(args, "no_cut", False) else "ON",
        copies=args.copies,
        username=args.username or os.environ.get("USER", "freeglaz"),
    )

    # Validation
    try:
        job.validate()
    except Z9GeometryError as e:
        err(str(e))
        for d in e.details:
            print(f"   {C.RED}•{C.R} {d}", file=sys.stderr)
        return 1

    # ── Embed the RESIDENT profile, read FRESH at the print go ───────────
    # freeglaz never converts values: embed the loaded slot's resident (read
    # live HERE) so source == what the firmware decodes with → the already-
    # converted RGB reach the inks untouched (L == F). Only when we build the
    # PDF from a TIFF (a pre-built pdf_path skips build_pdfx4). No silent
    # fallback to the file's ICC — a failed fetch blocks the print. Applies to
    # every TIFF print, photo AND chart (charts refetch too — L == F everywhere).
    if job.tiff_path is not None:
        try:
            job.icc_override = fetch_resident_icc(
                client, job.paper_id, job.gloss, job.rendermode)
        except Z9Error as e:
            err(f"LIVE read of the resident profile failed ({e}). The print must "
                "embed the real slot profile — no fallback. Check the Z9 is "
                "reachable/awake and the slot exists, then retry.")
            return 1

    # Recap
    print()
    print(f"{C.BOLD}Summary{C.R}")
    print(f"  Source       : {source_path.name}")
    print(f"  Paper        : {paper_name}")
    if media_source == "ROLL":
        print(f"  Source       : Roll (width {sheet_w:.0f} mm)")
        print(f"  Document     : {sheet_w:.0f} × {sheet_h:.0f} mm (computed to hug the image)")
    else:
        print(f"  Sheet        : {sheet_w:.0f} × {sheet_h:.0f} mm ({media_source})")
    print(f"  Image        : {image_w:.1f} × {image_h:.1f} mm")
    print(f"  Offset       : X={offset_x:.1f}  Y={offset_y:.1f} mm")
    print(f"  Quality      : {job.quality}")
    print(f"  Render mode  : {job.rendermode}")
    print(f"  Gloss        : {job.gloss}")
    print(f"  Max Detail   : {job.max_detail}")
    print(f"  Copies       : {job.copies}")
    print(f"  Target       : {client.host}:9100")

    if gloss_warn:
        warn(gloss_warn)
    if md_warn:
        warn(md_warn)

    # Confirmation (unless --yes)
    if not args.yes:
        print()
        print(f"{C.YELLOW}⚠  The Z9 will print as soon as it receives the job.{C.R}")
        if media_source == "MANUALFEED":
            print(f"{C.YELLOW}   Check that the sheet is loaded in MANUAL FEED.{C.R}")
        elif media_source == "ROLL":
            print(f"{C.YELLOW}   The roll will be cut after the print.{C.R}")
        try:
            r = input("Confirm sending? [y/N] ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            print()
            err("Cancelled")
            return 130
        if r not in ("y", "yes", "o", "oui"):
            warn("Cancelled")
            return 0

    # Pipeline execution
    print()
    try:
        result = client.print.send(
            job,
            work_dir=args.work_dir,
            on_progress=_print_progress,
            skip_preflight=args.skip_preflight,
        )
    except Z9GeometryError as e:
        err(f"Invalid geometry: {e}")
        for d in e.details:
            print(f"   {C.RED}•{C.R} {d}", file=sys.stderr)
        return 1
    except Z9PreflightError as e:
        err(f"Non-conformant PDF: {e}")
        if e.report:
            print(format_preflight_report(e.report, use_color=bool(C.GREEN)))
        return 1
    except Z9SendError as e:
        err(f"Send failed: {e}")
        return 1
    except Z9PrintError as e:
        err(f"Pipeline error: {e}")
        return 1

    print()
    for _w in result.warnings:
        warn(_w)
    ok(f"Job transmitted in {result.duration_seconds:.1f}s — {result.prn_size_bytes / 1024:.0f} KB sent to the Z9")
    info(f"The printer is now processing and printing (may take several minutes)")
    info(f"PDF : {result.pdf_path}")
    info(f"PRN : {result.prn_path}")
    return 0


def cmd_print_preview(args, client):
    """Builds the PDF + PRN without sending (for inspection/debug)."""
    # We force --yes and skip sending by delegating to cmd_print via an internal flag
    # But cleaner: we duplicate the minimum.
    source_path = Path(args.source)
    if not source_path.exists():
        err(f"File not found: {source_path}")
        return 1

    is_pdf = source_path.suffix.lower() == ".pdf"
    is_tiff = source_path.suffix.lower() in (".tif", ".tiff")
    if not (is_pdf or is_tiff):
        err(f"Unsupported format: {source_path.suffix}")
        return 1

    try:
        paper_id, paper_name, sheet_w, sheet_h, detected_source = _resolve_print_paper(
            client, args.paper, args.sheet_width, args.sheet_height,
        )
    except Z9PaperError as e:
        err(str(e))
        return 1

    # media_source: explicit CLI takes precedence, otherwise detection
    if args.mediasource and args.mediasource != "AUTO":
        media_source = args.mediasource
    else:
        media_source = detected_source

    if is_tiff:
        info_tiff = TiffInfo.from_path(source_path)
        image_w = args.image_width or info_tiff.width_mm
        image_h = args.image_height or info_tiff.height_mm
    else:
        if not args.image_width or not args.image_height:
            err("For a PDF source, --image-width and --image-height required")
            return 1
        image_w = args.image_width
        image_h = args.image_height

    # ROLL: if sheet_h not specified, compute = image_h + 10mm
    if media_source == "ROLL" and sheet_h is None:
        sheet_h = image_h + 10.0

    if sheet_w is None or sheet_h is None:
        err(f"Undetermined sheet dimensions (w={sheet_w}, h={sheet_h})")
        return 1

    # Default placement: MANUAL_FEED centering, stuck in ROLL
    if args.offset_x is not None:
        offset_x = args.offset_x
    elif media_source == "ROLL":
        offset_x = 5.0
    else:
        offset_x = (sheet_w - image_w) / 2

    if args.offset_y is not None:
        offset_y = args.offset_y
    elif media_source == "ROLL":
        offset_y = 5.0
    else:
        offset_y = (sheet_h - image_h) / 2

    job = PrintJob(
        tiff_path=source_path if is_tiff else None,
        pdf_path=source_path if is_pdf else None,
        paper_id=paper_id, paper_name=paper_name,
        media_source=media_source,
        sheet_w_mm=sheet_w, sheet_h_mm=sheet_h,
        image_w_mm=image_w, image_h_mm=image_h,
        offset_x_mm=offset_x, offset_y_mm=offset_y,
        gloss=args.gloss, quality=args.quality,
        rendermode=args.rendermode, max_detail=args.max_detail,
        cutter="OFF" if getattr(args, "no_cut", False) else "ON",
        copies=args.copies,
        username=args.username or os.environ.get("USER", "freeglaz"),
    )

    try:
        job.validate()
    except Z9GeometryError as e:
        err(str(e))
        for d in e.details:
            print(f"   • {d}")
        return 1

    work_dir = Path(args.work_dir) if args.work_dir else source_path.parent
    work_dir.mkdir(parents=True, exist_ok=True)
    base = source_path.stem
    pdf_path = work_dir / f"{base}.pdf"
    prn_path = work_dir / f"{base}.prn"

    print(f"{C.BOLD}Preview{C.R}")
    print(f"  Paper        : {paper_name} (id={paper_id[:8]}…)")
