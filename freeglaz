        print(f"{C.YELLOW}⚠ Note: --hp-skintones-csv combined with cube_shift="
              f"{args.cube_shift}{C.R}")
        print(f"  The HP CSV is designed for cube_shift=hp_canonical.")
        print(f"  cube↔extras collisions may appear.")
