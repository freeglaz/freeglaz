def cmd_chart_generate(args, client):
    """
    Generate a 464-patch profiling chart for a custom paper.

    Internal pipeline:
      1. Resolve the paper (factory papers refused: only customs are profiled).
      2. Resolve the chart source ICC profile (= tag), one of:
         - ``--tag-mode resident`` (DEFAULT, resident-tag switch):
           reads the resident profile of the target slot (GE+colorspace) in the
           local mirror — guarantees content identity source=resident
           (raw RGB at RIP, factory AND custom slots, independently).
         - ``--tag-mode donor`` (historical fallback): paper factory donor
           (extracted via paper.donor_export if absent).
      3. Generation via ChartOps.generate() with this profile as tag.
      4. Write chart.tif + JSON sidecar to ~/Documents/freeglaz/sessions/
         (unless --output is specified).

    Roll mode (--num-cols 40): a warning signals the firmware limitation
    (the roll chart cannot be scanned via SCAN_ONLY).

    Usage:
        freeglaz chart generate "Canson Baryta" -g OFF
        freeglaz chart generate "Canson Baryta" -g FULLPAGE --num-cols 40
        freeglaz chart generate "Canson Baryta" -g OFF -o /tmp/chart.tif
        freeglaz chart generate "Canson Baryta" -g OFF --ti1 my_chart.ti1
        freeglaz chart generate "Canson Baryta" -g OFF --tag-mode donor    # fallback
    """
    from lib.z9_client import cache, store
    from lib.z9_client.chart import ChartOps, COLS_TO_PAPER_DEFAULT

    # 1. Resolve the paper
    paper = resolve_paper_interactive(client, args.id_or_name)
    if not paper:
        return 1
    print()

    if not paper.get("is_user_custom", False):
        err(f"{paper['name']!r} is a factory (HP) paper. "
            f"chart generate only applies to custom papers.")
        return 1

    paper_name = paper["name"]
    serial = store.get_serial(client)
    tag_mode = getattr(args, "tag_mode", "resident") or "resident"

    # 2. Resolve the source ICC profile (= chart tag)
    #
    # Resident-tag switch: by default, we tag with the exact resident
    # profile of the target slot (read from the local mirror). The donor
    # remains accessible via --tag-mode donor (safety net + A/B test).
    if tag_mode not in ("resident", "donor"):
        err(f"invalid --tag-mode: {tag_mode!r} (expected: resident|donor)")
        return 1

    reference_icc_path = None
    reference_meta = None       # dict of the chosen profile (for display)
    reference_label = None      # 'resident' or 'donor'

    if tag_mode == "resident":
        # 2a. The slot must be explicit (GE + colorspace).
        if args.gloss_enhancer is None:
            err("--gloss-enhancer (-g) required in resident-tag mode "
                "(default). The target slot determines which profile tags the "
                "chart.\n"
                "  Examples: freeglaz chart generate "
                f"{paper_name!r} -g OFF\n"
                "             freeglaz chart generate "
                f"{paper_name!r} -g FULLPAGE\n"
                "  To reuse the old behavior, add "
                "--tag-mode donor.")
            return 1

        ge_target = args.gloss_enhancer
        cs_target = "PRINTER_RGB"

        # 2b. SAFETY SHIELD: the tag MUST be the profile ACTUALLY
        #     present on the slot, read LIVE from the Z9 (getProfile) — NEVER
        #     the mirror/repo (potentially stale cache → wrong tag →
        #     faulty print, cf. red-badge incident). NO cache fallback:
        #     if the Z9 is unreachable or the slot unreadable,
        #     we BLOCK (an A3 sheet + a refinement are at stake).
        import tempfile
        _fd, _tmp = tempfile.mkstemp(suffix=".icc", prefix="freeglaz_tag_live_")
        os.close(_fd)
        reference_icc_path = Path(_tmp)
        try:
            client.paper.export_icc(
                ref=paper["id"], output_path=str(reference_icc_path),
                gloss_enhancer=ge_target, quality="BEST", color_space="RGB",
                _pre_resolved=paper,
            )
        except Z9Error as e:
            try:
                reference_icc_path.unlink()
            except OSError:
                pass
            err(
                f"LIVE read of the GE={ge_target} {cs_target} slot profile "
                f"failed on the Z9 ({e}).\n"
                f"  The resident-tag chart must be tagged with the REAL slot "
                f"profile — no cache fallback (risk of stale tag "
                f"→ faulty print).\n"
                f"  → Check that the Z9 is reachable/awake and that the slot "
                f"exists, then retry."
            )
            return 1
        reference_label = "resident (live Z9)"
        reference_meta = {
            "gloss_enhancer": ge_target,
            "color_space": cs_target,
            "source": "live Z9 slot (getProfile)",
        }

    else:  # tag_mode == "donor" — historical path kept as fallback
        needs_export = False
        refresh_reason = None
        if not cache.donor_exists(paper_name, serial):
            needs_export = True
            refresh_reason = "absent from mirror"
        elif args.refresh_donor:
            needs_export = True
            refresh_reason = "forced refresh (--refresh-donor)"
        else:
            # Check whether the firmware UUID has changed
            try:
                client.paper.details(paper["id"])
                donor_id = paper.get("donor_id")
                if donor_id:
                    donor_details = client.paper.details(donor_id)
                    current_uuid = None
                    for prof in donor_details.get("profiles", []):
                        if not prof.get("custom", True):
                            current_uuid = prof.get("uuid")
                            break
                    if current_uuid and cache.donor_needs_refresh(
                            paper_name, serial, current_uuid):
                        needs_export = True
                        refresh_reason = (
                            "firmware UUID ≠ mirror UUID "
                            "(firmware update likely)"
                        )
            except Z9Error:
                pass

        if needs_export:
            print(f"{C.YELLOW}⚠  Donor cache: {refresh_reason}{C.R}")
            print(f"  → Automatic R&D donor extraction ...")
            print()
            export_args = argparse.Namespace(
                id_or_name=paper["id"],
                color_space="RGB",
            )
            rc = cmd_paper_donor_export(export_args, client)
            if rc != 0:
                return rc
            print()

        try:
            reference_icc_path, _donor_bytes, reference_meta = cache.load_donor(
                paper_name, serial, verify_md5=True,
            )
        except FileNotFoundError as e:
            err(str(e))
            return 1
        except ValueError as e:
            err(str(e))
            return 1
        reference_label = "donor"

    # 4. Resolve the output path
    if args.output:
        output_path = Path(args.output).resolve()
        session_path = None
    else:
        session_name = cache.new_session_name(paper_name)
        session_path = cache.session_dir(session_name)
        output_path = session_path / "chart.tif"

    # 5. Prepare canonical PPM if in demo mode and 18 cols
    canonical_ppm_path = None
    if args.ti1 is None and args.num_cols == 18 and args.demo_mode in ("auto", "canonical"):
        ref_canonical = Path(__file__).resolve().parent / "reference" / \
            "chart_464_18cols_300dpi_canonical.ppm"
        if ref_canonical.exists():
            canonical_ppm_path = ref_canonical

    # 6. Display parameters
    paper_preset = COLS_TO_PAPER_DEFAULT.get(args.num_cols, 'native')
    print(f"{C.BOLD}🎯 Profiling chart generation{C.R}")
    print(f"  Paper       : {paper_name}")
    print(f"  MediumId    : {C.DIM}{paper['id']}{C.R}")
    # Clear display of what tags the chart (cf. resident-tag switch)
    if reference_label == "resident":
        z9_name = reference_meta.get("z9_icc_name") or reference_icc_path.name
        kind = "custom" if reference_meta.get("custom") else "factory"
        md5 = (reference_meta.get("md5") or "")[:12]
        print(f"  Tag mode    : {C.GREEN}resident{C.R}  "
              f"{C.DIM}(source=resident identity guaranteed){C.R}")
        print(f"  Tag profile : {z9_name}")
        print(f"               slot GE={args.gloss_enhancer} PRINTER_RGB · "
              f"{kind} · md5={C.DIM}{md5}…{C.R}")
        print(f"  ICC file    : {reference_icc_path.name}")
        print(f"               ({reference_icc_path.stat().st_size:,} bytes)")
    else:  # donor (fallback)
        kind = "custom" if reference_meta.get("custom") else "factory"
        print(f"  Tag mode    : {C.YELLOW}donor{C.R}  "
              f"{C.DIM}(fallback — see Note_Tag_Charte_Profil_Resident.md){C.R}")
        print(f"  Donor ICC   : {reference_icc_path.name}")
        print(f"               ({reference_icc_path.stat().st_size:,} bytes)")
    print(f"  Columns     : {args.num_cols}")
    print(f"  Preset      : {paper_preset}")
    if args.gloss_enhancer:
        print(f"  Target GE   : {args.gloss_enhancer}  "
              f"{C.DIM}(slot you plan to profile){C.R}")
    if args.ti1:
        print(f"  Source RGB  : {args.ti1}")
    else:
        if canonical_ppm_path:
            print(f"  Source RGB  : demo (cube 7³ + canonical sampled ramp)")
        else:
            print(f"  Source RGB  : demo (cube 7³ + synthetic ramp)")
    print(f"  Output      : {output_path}")
    print()

    # 7. Roll warning (firmware limitation)
    if args.num_cols == 40:
        print(f"  {C.YELLOW}⚠  Firmware limitation: the 24\" roll chart "
              f"cannot be scanned{C.R}")
        print(f"     (SCAN_ONLY refuses the roll source, and the Z9 24\" "
              f"manual feed is limited to A1=594mm)")
        print(f"     To profile this paper, either use --num-cols 18 (A3), "
              f"or cut an A3 sheet from the roll.")
        print()

    # 8. Tracing callback
    def on_step(n, total, label, **details):
        if label == "layout-computed":
            print(f"  [{n}/{total}] Layout computed: "
                  f"{details['width']} × {details['height']} px "
                  f"({details['nrows']} rows, "
                  f"{details['n_empty']} empty cells)")
        elif label == "ti1-loaded":
            print(f"  [{n}/{total}] .ti1 loaded: {details['n_patches']} patches "
                  f"from {Path(details['ti1_path']).name}")
        elif label == "demo-patches":
            if details.get("used_canonical"):
                src = "cube 7³ + canonical ramp"
            else:
                src = "cube 7³ + synthetic ramp"
            print(f"  [{n}/{total}] Demo patches generated ({src}) — "
                  f"{details['n_patches']} patches")
        elif label == "rendered":
            print(f"  [{n}/{total}] Raster rendered: {details['shape']}")
        elif label == "written":
            size_mb = details['size_bytes'] / 1024 / 1024
            print(f"  [{n}/{total}] File written ({size_mb:.1f} MB)")

    # 9. Launch generation
    ops = ChartOps(z9_client=client)
    try:
        result = ops.generate(
            ti1_path=args.ti1,
            output_path=output_path,
            reference_icc_path=reference_icc_path,
            num_cols=args.num_cols,
            paper_preset='auto',
            output_format=args.format,
            demo_mode=args.demo_mode,
            canonical_ppm_path=canonical_ppm_path,
            write_sidecar=not args.no_sidecar,
            also_ppm=args.also_ppm,
            on_step=on_step,
        )
    except FileNotFoundError as e:
        print()
        err(str(e))
        return 1
    except ValueError as e:
        print()
        err(str(e))
        return 1

    # 10. Final summary
    print()
    ok(f"Chart generated successfully")
    print(f"  TIFF        : {result.output_path}")
    print(f"  Dimensions  : {result.width_px} × {result.height_px} px "
          f"({result.width_mm:.1f} × {result.height_mm:.1f} mm)")
    print(f"  DPI         : X={result.dpi_x:.2f}, Y={result.dpi_y:.2f} "
          f"{C.DIM}(anisotropic if roll){C.R}")
    print(f"  Preset      : {result.paper_preset}")
    print(f"  ICC source  : {Path(result.icc_path).name} "
          f"({result.icc_size_bytes:,} bytes)")
    if result.sidecar_path:
        print(f"  Sidecar     : {Path(result.sidecar_path).name}")
    print()

    # 11. Next-step tip
    if args.num_cols == 18:
        print(f"💡 Next step: print this chart on the paper")
        if args.gloss_enhancer:
            # Explicit GE choice → a single command
            ge = args.gloss_enhancer
            print(f"   {C.DIM}freeglaz print {result.output_path!r} "
                  f"--paper {paper_name!r} --gloss {ge}{C.R}")
        else:
            # No GE choice → show both variants
            print(f"   Choose the target Gloss Enhancer slot (depending on which "
                  f"profile you want to generate):")
            print(f"   {C.DIM}freeglaz print {result.output_path!r} "
                  f"--paper {paper_name!r} --gloss FULLPAGE{C.R}")
            print(f"   or:")
            print(f"   {C.DIM}freeglaz print {result.output_path!r} "
                  f"--paper {paper_name!r} --gloss OFF{C.R}")
        print(f"   (the printer must be loaded with an A3+ sheet "
              f"via manual feed)")
    else:
        print(f"💡 Roll chart ready for visual test only.")
        print(f"   To profile this paper, regenerate as A3:")
        print(f"   {C.DIM}freeglaz chart generate {paper_name!r} --num-cols 18{C.R}")

