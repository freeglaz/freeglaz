    print(f"{C.DIM}backups   : {status['backups']['n_files']} file(s)  ({status['backups']['dir']}){C.R}")
    print(f"{C.DIM}sessions  : {status['sessions']['n_dirs']} folder(s)  ({status['sessions']['dir']}){C.R}")
    return 0


def cmd_store_sync(args, client):
    """Sync the local mirror with the Z9 (HP getMediumListVersion model).

    Lightweight check (version) then targeted fetch on divergence. No
    writes into `repo/`.
    """
    from lib.z9_client import store

    def on_step(label, **details):
        if label == "version_check":
            print(f"  Checking version (serial {details.get('serial')}) …")
        elif label == "version_known":
            loc, rem = details.get("local"), details.get("remote")
            forced = details.get("force")
            sch_l = details.get("local_schema", 0)
            sch_c = details.get("code_schema", 0)
            sch_out = bool(details.get("schema_outdated"))
            print(f"    local : {loc or '—'}    (sync schema : {sch_l})")
            print(f"    remote: {rem or '?'}    (code schema : {sch_c})")
            if sch_out:
                print(f"    {C.YELLOW}→ sync schema outdated (local={sch_l} < code={sch_c}) "
                      f"→ full purge + complete refetch{C.R}")
            elif forced:
                print(f"    {C.YELLOW}--force → full purge + complete refetch{C.R}")
            elif loc == rem and loc:
                print(f"    {C.GREEN}✓ identical — mirror up to date{C.R}")
            else:
                print(f"    {C.YELLOW}→ divergent, fetch per changed paper{C.R}")
        elif label == "full_purge_start":
            print(f"  {C.YELLOW}🗑  Full purge of serial "
                  f"({details.get('reason')}) …{C.R}")
        elif label == "full_purge_done":
            print(f"    {details.get('n_papers_purged')} paper folder(s) deleted")
        elif label == "fetch_paper_list":
            print(f"  Fetching the paper list …")
        elif label == "paper_list_received":
            print(f"    {details.get('n')} papers received")
        elif label == "paper_purge":
            print(f"  {C.DIM}🗑  {details.get('paper_name')} (UUID changed){C.R}")
        elif label == "fetch_profile":
            kind = "factory" if not details.get("custom") else "custom"
            print(f"  ↳ {details.get('paper_name')}  ·  GE={details.get('ge')} {details.get('color_space')}  [{kind}]")

    print(f"{C.BOLD}🔄 Z9 mirror sync{C.R}")
    try:
        result = store.sync_mirror(client, on_step=on_step, force=args.force)
    except Z9Error as e:
        err(f"Sync failed: {e}")
        return 1

    print()
    if not result["changed"]:
        print(f"{C.GREEN}✓ Mirror up to date, nothing to do.{C.R}")
        print(f"  serial          : {result['serial']}")
        print(f"  local version   : {result['local_version']}")
        print(f"  papers cached   : {result['n_papers_total']}")
        return 0

    print(f"{C.GREEN}✓ Sync complete.{C.R}")
    print(f"  serial              : {result['serial']}")
    print(f"  local version       : {result['local_version'] or '—'} → {result['remote_version']}")
    print(f"  sync schema         : {result.get('local_schema', 0)} → {result.get('code_schema', 0)}")
    print(f"  papers in mirror    : {result['n_papers_total']}")
    print(f"  papers updated      : {result['n_papers_updated']}")
    print(f"  profiles downloaded : {result['n_profiles_fetched']}")
    pinfo = result.get("purge")
    if pinfo:
        if pinfo["mode"] == "full":
            print(f"  purge               : full ({pinfo['reason']}, "
                  f"{pinfo['n_papers_purged']} folder(s))")
        else:
            print(f"  purge               : per paper "
                  f"({pinfo['n_papers_purged']} folder(s))")
    if result.get("errors"):
        print()
        print(f"{C.YELLOW}⚠  {len(result['errors'])} error(s):{C.R}")
        for e in result["errors"][:5]:
            slot = e.get("slot")
            slot_str = f" [{slot}]" if slot else ""
            print(f"    • {e.get('paper_name')}{slot_str}: {e.get('error')}")
    return 0



