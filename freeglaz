def cmd_chart_formats(args, client):
    """Capacity table per format (max columns × max rows = max patches)."""
    from lib.z9_client.sol_chart import format_capacity, smallest_format_for
    from lib.z9_client import chart_geometry_refonte as G

    if getattr(args, "patches", None):
        n = args.patches
        fmt = smallest_format_for(n)
        cap = format_capacity(fmt)
        print(f"{C.BOLD}{n} patches{C.R} → smallest format: "
              f"{C.GREEN}{fmt}{C.R}  (max {cap['max_patches'] or '∞'} ; "
              f"indicative grid {cap['max_cols']} col × "
              f"{-(-n // cap['max_cols'])} rows)")
        return 0

    print(f"{C.BOLD}{'format':8}{'dimensions':14}{'max_cols':>9}{'max_rows':>12}"
          f"{'max_patches':>13}  {'note'}{C.R}")
    print("-" * 74)
    for k in ("a4", "a3", "a2", "roll24", "roll44", "roll17"):
        m = G.MEDIA[k]
        cap = format_capacity(k)
        dims = (f"{int(m.width_mm)}×{int(m.height_mm)}" if m.height_mm
                else f"{int(m.width_mm)}×roll")
        if cap["is_roll"]:
            rows = f"~{cap['rows_per_m']}/m"
            mp = f"{cap['max_cols'] * cap['rows_per_m']}/m"
            note = f"{C.YELLOW}{cap['note']}{C.R}"
        else:
            rows, mp, note = str(cap["max_rows"]), str(cap["max_patches"]), ""
        print(f"{k:8}{dims:14}{cap['max_cols']:>9}{rows:>12}{mp:>13}  {note}")
    print(f"\n  {C.DIM}conformant max (centered, gap>0, scan height OK, ID footer rendered). "
          f"Roll: real limit = scannable length.{C.R}")
    print(f"  {C.DIM}Reverse help: freeglaz chart formats --patches N{C.R}")
    return 0


def cmd_chart_print(args, client):
    """Print a chart from the library (by chart_id), HONORING the
    descriptor placement (raster top at placement.offset, top-anchored — the
    ID footer occupies the bottom margin; cf. note 8c). Delegates to the validated
    `print` pipeline (PDF/X-4 → PRN → Z9, confirmation, gloss). ⚠️ HARDWARE ACTION."""
    from lib.z9_client.sol_chart import load_chart
    from lib.z9_client import cache

    try:
        desc = load_chart(args.chart_id)
    except FileNotFoundError as e:
        err(str(e))
        return 1
    chart_dir = cache.locate_chart_dir(args.chart_id)   # located by enumeration (per-serial)
    tiff = chart_dir / desc["files"]["tiff"]
    if not tiff.exists():
        err(f"TIFF missing: {tiff}")
        return 1

    # COLOR guard (hard): refuse a non-resident-tagged chart (e.g. sRGB from
    # earlier versions) — the firmware consumes the source profile → wrong profiling.
    cm = desc.get("color_management") or {}
    if cm.get("tag_source") != "resident-live":
        err(f"Chart {args.chart_id} NOT resident-tagged "
            f"(tag={cm.get('tag_source') or 'absent/sRGB'}) → invalid profiling "
            f"(the firmware consumes the source profile). REGENERATE it:\n"
            f"  freeglaz chart create <ti1> --paper <paper> -g <OFF|FULLPAGE> "
            f"-f {desc['media']['format_key']} -c {desc['geometry']['cols']}")
        return 1

    # GE: by default, the GE state of the tagged slot (tag↔print consistency). Explicit
    # override via --gloss possible, but we warn if it differs from the tag.
    tag_ge = cm.get("gloss_enhancer")
    gloss = args.gloss if args.gloss is not None else (tag_ge or "OFF")
    if args.gloss is not None and tag_ge and args.gloss != tag_ge:
        warn(f"--gloss {args.gloss} ≠ resident tag GE ({tag_ge}): the print "
             f"will not match the tagged slot (risk of inconsistent profiling).")

    pl = desc["scanLayout"]["placement"]
    geo, media = desc["geometry"], desc["media"]
    print(f"{C.BOLD}🖨  Printing chart {args.chart_id}{C.R}")
    print(f"  content   : {geo['patch_count']} patches / {geo['cols']} col  "
          f"(format {media['format_key']})")
    print(f"  color tag : {C.GREEN}resident{C.R} GE={tag_ge}  → print GE={gloss}")
    print(f"  placement : raster top at X={pl['offset_x_mm']:.1f} "
          f"Y={pl['offset_y_mm']:.1f} mm {C.DIM}(top-anchored, DO NOT recenter){C.R}")
    print(f"  {C.YELLOW}⚠  Load a matching {media['format_key']} paper.{C.R}")

    # Delegate to the existing print pipeline with offset = placement (top-anchored).
    # The chart refetches the resident FRESH at the go (L == F), like a photo:
    # cmd_print embeds it via job.icc_override. The chart TIFF still carries its
    # generation-time tag (descriptive only) — build_pdfx4 uses the fresh override.
    ns = argparse.Namespace(
        source=str(tiff), paper=args.paper, mediasource=args.mediasource,
        sheet_width=None, sheet_height=None, image_width=None, image_height=None,
        offset_x=pl["offset_x_mm"], offset_y=pl["offset_y_mm"],
        gloss=gloss, quality=args.quality, rendermode="COLOR",
        max_detail="OFF", drytime="NORMAL", copies=1, username="",
        skip_preflight=False, work_dir=None, yes=args.yes,
    )
    return cmd_print(ns, client)


def cmd_chart_scan(args, client):
    """Scan a chart from the library (by chart_id, ZERO coordinate input):
    loads the descriptor → scanLayout → NATIVE SOL channel (sol_native.measure) →
    CGATS → ti3 in charts/<id>/measurements/. ⚠️ HARDWARE ACTION."""
    from datetime import datetime
    from lib.z9_client.sol_chart import load_chart
    from lib.z9_client import sol_native, cache
    from lib.z9_client.sol_ti3 import build_ti3_from_native_cgats

    try:
        desc = load_chart(args.chart_id)
    except FileNotFoundError as e:
        err(str(e))
        return 1
    fields = list(desc["scanLayout"]["fields"].items())   # order preserved (JSON)
    geo = desc["geometry"]
    meas_dir = cache.locate_chart_dir(args.chart_id) / "measurements"   # per-serial (enumeration)
    meas_dir.mkdir(parents=True, exist_ok=True)

    print(f"{C.BOLD}🔬 Scanning chart {args.chart_id} (native SOL channel){C.R}")
    print(f"  content : {geo['patch_count']} patches / {geo['cols']} col")
    print(f"  target  : {client.host}:9100")
    print(f"  {C.YELLOW}⚠  Chart {args.chart_id} must be LOADED "
          f"(manual feed, dried).{C.R}")
    if not args.yes:
        try:
            r = input("Start the scan? [y/N] ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            print()
            err("Cancelled")
            return 130
        if r not in ("y", "yes", "o", "oui"):
            warn("Cancelled")
            return 0

    def _on_status(op, _f):
        info(f"  scan: {op}")

    try:
        cgats = sol_native.measure(client.host, fields=fields, on_status=_on_status)
    except (RuntimeError, OSError) as e:
        err(f"Scan failed: {e}")
        return 1

    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    cgats_path = meas_dir / f"{ts}.cgats"
    cgats_path.write_bytes(cgats)
    ti3_path = meas_dir / f"{ts}.ti3"
    try:
        res = build_ti3_from_native_cgats(cgats.decode("ascii", "replace"), desc,
                                          ti3_path)
    except (ValueError, FileNotFoundError) as e:
        err(f"ti3 conversion failed: {e}  (CGATS kept: {cgats_path})")
        return 1

    ok(f"Scan OK — {res.n_patches} patches, {res.n_spectral_bands} bands "
       f"({res.xyz_method})")
    print(f"  CGATS : {cgats_path}")
    print(f"  ti3   : {ti3_path}")
    print(f"\n💡 Profile: {C.DIM}freeglaz chart profile {args.chart_id}{C.R}")
    return 0


def cmd_chart_profile(args, client):
    """Build an ICC profile from the latest scanned ti3 of a chart (colprof).
    Default recipe -v -qh (override via --colprof-flags); for the full config
    recipe (-S gamut), see `freeglaz chart build-profile`. LOCAL (no Z9)."""
    import shlex
    from lib.z9_client import cache
    from lib.z9_client.profiling import ProfilingOps

    chart_dir = cache.locate_chart_dir(args.chart_id)   # per-serial (enumeration, client-free)
    if chart_dir is None:
        err(f"unknown chart: {args.chart_id}")
        return 1
    meas = chart_dir / "measurements"
    ti3s = sorted(meas.glob("*.ti3")) if meas.exists() else []
    if not ti3s:
        err(f"No ti3 in {meas}")
        print(f"  {C.DIM}Scan first: freeglaz chart scan {args.chart_id}{C.R}")
        return 1
    ti3 = ti3s[-1]   # the most recent (sorted by timestamp)

    flags = shlex.split(args.colprof_flags) if args.colprof_flags else ["-v", "-qh"]
    out_icc = chart_dir / f"{args.chart_id}.icc"
    label = out_icc.stem   # desc = stem of the output file (= chart_id), project rule

    print(f"{C.BOLD}🎨 Profiling chart {args.chart_id}{C.R}")
    print(f"  ti3   : {ti3.name}")
    print(f"  flags : colprof {' '.join(flags)}")
    try:
        result = ProfilingOps().build_profile(
            ti3.with_suffix(""), descriptor=label, output_icc_path=out_icc,
            colprof_flags=flags,
        )
    except (FileNotFoundError, RuntimeError) as e:
        err(f"colprof failed: {e}")
        return 1
    ok(f"ICC profile: {result.output_icc_path} "
       f"({result.output_icc_size_bytes / 1024:.0f} KB)")
    print(f"  {C.DIM}Full recipe (-S gamut): "
          f"freeglaz chart build-profile --ti {ti3}{C.R}")
    return 0


