def cmd_config_show(args, client):
    """
    Displays the effective freeglaz configuration (defaults + ~/.freeglazrc.toml).

    The config is the merge of:
      1. Hardcoded defaults (lib/z9_client/config.py)
      2. ~/.freeglazrc.toml (if present)

    Useful to check which parameters are used by colprof, multipass, etc.
    Explicit CLI flags always take precedence over these values at
    invocation time.

    Usage:
        freeglaz config show
        freeglaz config show --path  # prints only the file path
    """
    from lib.z9_client.config import (
        get_config, get_config_path, format_config_for_display,
    )

    config_path = get_config_path()

    if args.path:
        print(config_path)
        return 0

    print(f"{C.BOLD}⚙️  freeglaz configuration{C.R}")
    print(f"  File    : {config_path}")
    if config_path.exists():
        print(f"  Status  : {C.GREEN}present{C.R} (defaults + user)")
    else:
        print(f"  Status  : {C.YELLOW}absent{C.R} (defaults only)")
        print(f"            Create with: {C.DIM}freeglaz config init{C.R}")
    print()

    config = get_config()
    print(format_config_for_display(config))

    return 0


def cmd_config_init(args, client):
    """
    Creates the user config file ~/.freeglazrc.toml with the defaults.

    The generated file contains explanatory comments for each parameter.
    Refuses to overwrite an existing file (unless --force).

    Usage:
        freeglaz config init
        freeglaz config init --force  # overwrite an existing file if any
    """
    from lib.z9_client.config import write_default_config, get_config_path

    config_path = get_config_path()

    if config_path.exists() and not args.force:
        err(f"Config file already present: {config_path}")
        print(f"  Use --force to overwrite, or edit manually.")
        return 1

    if config_path.exists() and args.force:
        print(f"  {C.YELLOW}⚠ Overwriting (--force) the existing file{C.R}")
        config_path.unlink()

    try:
        path = write_default_config(config_path)
    except OSError as e:
        err(f"Cannot write: {e}")
        return 1

    size = os.path.getsize(path)
    ok(f"Config file created: {path} ({size} bytes)")
    print(f"  Edit with : {C.DIM}$EDITOR {path}{C.R}")
    print(f"  Check     : {C.DIM}freeglaz config show{C.R}")
    return 0


def cmd_config_get(args, client):
    """
    Displays a configuration value (dotted key).

    Usage:
        freeglaz config get colprof.quality
        freeglaz config get multipass.dedup
        freeglaz config get paths.sessions_root
    """
    from lib.z9_client.config import get_config, get_config_value

    config = get_config()
    try:
        value = get_config_value(config, args.key)
    except KeyError:
        err(f"Unknown key: {args.key}")
        print(f"  Available sections: {list(config.keys())}")
        return 1

    # Compact output: just the value (usable in scripts)
    if isinstance(value, bool):
        print("true" if value else "false")
    elif isinstance(value, str):
        print(value)
    elif isinstance(value, (int, float)):
        print(value)
    elif isinstance(value, dict):
        # If the user typed just "colprof" without a specific key
        from lib.z9_client.config import format_config_for_display
        print(format_config_for_display({args.key: value}))
    else:
        print(repr(value))

    return 0


def cmd_config_set(args, client):
    """
    Modifies a configuration value and saves it.

    Automatically converts types (true/false, integers, floats, otherwise
    string). Creates the config file if it does not exist.

    Usage:
        freeglaz config set colprof.quality m
        freeglaz config set multipass.keep_intermediates true
        freeglaz config set profile.check_lab_white_a_max 5.0
        freeglaz config set colprof.copyright "(c) user 2026"
    """
    from lib.z9_client.config import (
        get_config, get_config_path, set_config_value, save_config,
    )

    config_path = get_config_path()
    config = get_config()

    # Capture the current value for display
    from lib.z9_client.config import get_config_value
    try:
        old_value = get_config_value(config, args.key)
        old_str = repr(old_value)
    except KeyError:
        old_str = f"{C.DIM}(not set){C.R}"

    set_config_value(config, args.key, args.value)

    try:
        new_value = get_config_value(config, args.key)
    except KeyError:
        err(f"Internal write failed")
        return 1

    try:
        path = save_config(config, config_path)
    except (OSError, ImportError) as e:
        err(f"Cannot save: {e}")
        return 1

    ok(f"{args.key} : {old_str} → {new_value!r}")
    print(f"  File : {path}")
    if not config_path.exists() or os.path.getsize(config_path) < 10:
        print(f"  {C.YELLOW}⚠ Note: the saved file may have lost "
              f"the original comments{C.R}")
    return 0


