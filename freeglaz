            if choice == "1":
                gloss_enhancer = "FULLPAGE"
            elif choice == "2":
                gloss_enhancer = "OFF"
            else:
                err(f"Invalid choice: {choice}")
                return 1
        else:
            print(f"  {C.DIM}This paper does not support the Gloss Enhancer "
                  f"(GlossEnhancerSupported=0).{C.R}")
            print(f"  {C.DIM}Forced to: OFF{C.R}")
            gloss_enhancer = "OFF"
        print()
    else:
        # GE specified on CLI: check compatibility
        if gloss_enhancer == "FULLPAGE" and not ge_supported:
            err(f"The paper '{paper['name']}' does not support "
                f"the Gloss Enhancer (GlossEnhancerSupported=0).")
            return 1

    # Build / resolve the profile_name
    profile_name = args.profile_name
    if profile_name is None:
        paper_no_spaces = paper["name"].replace(" ", "")
        if gloss_enhancer == "FULLPAGE":
            profile_name = f"freeglaz_{paper_no_spaces}_GEON, GE ON"
        else:
            profile_name = f"freeglaz_{paper_no_spaces}_GEOFF, GE OFF"

    # Header
    print(f"{C.BOLD}🔬 Scan only (SCAN_ONLY){C.R}")
    print(f"  Paper          : {paper['name']}")
    print(f"  MediumId       : {C.DIM}{paper['id']}{C.R}")
    print()
    print(f"  {C.CYAN}Parameters:{C.R}")
    print(f"    Quality        : {args.quality}")
    print(f"    Gloss Enhancer : {gloss_enhancer}")
    print(f"    Maximum Detail : {args.max_detail}")
    print(f"    Color Space    : {args.color_space}")
    print(f"    Profile name   : {profile_name}")
    print()
    print(f"  {C.YELLOW}⚠  Check that the 464-patch chart is loaded in "
          f"MANUAL FEED{C.R}")
    print(f"  {C.YELLOW}⏱  Estimated time: ~7 minutes (scan + compute){C.R}")
    if args.export:
        print(f"  {C.CYAN}ICC export     : {args.export}{C.R}")
    print()

    # User confirmation (unless --yes)
    if not args.yes:
        if not sys.stdin.isatty():
            err("Non-interactive (no tty), use --yes to confirm")
            return 1
        try:
            confirm = input("Confirm? [y/N]: ").strip().lower()
        except EOFError:
            return 1
        if confirm not in ("y", "yes", "o", "oui"):
            warn("Cancelled")
            return 0
        print()

    # Progress callback (same phases as profile)
    def on_progress(status):
        import datetime as _dt
        ts = _dt.datetime.now().strftime("%H:%M:%S")
        process = status["process"]
        percent = status["percent"]
        label, color = _CALIBRATION_PHASES.get(process, (process, C.R))
        pct_str = f"{percent:3d}%" if percent >= 0 else "  - "
        print(f"  {C.DIM}{ts}{C.R}  {color}{process:<22s}{C.R}  {pct_str}  "
              f"{C.DIM}({label}){C.R}")

    print(f"  {C.DIM}Launching newProfile (workflow SCAN_ONLY)...{C.R}")

    # Execution — calls scan_only instead of profile
    try:
        result = client.paper.scan_only(
            ref=paper["id"],
            gloss_enhancer=gloss_enhancer,
            quality=args.quality,
            max_detail=args.max_detail,
            color_space=args.color_space,
            profile_name=profile_name,
            on_progress=on_progress,
            poll_interval=args.interval,
            timeout=args.timeout,
        )
    except Z9CalibrationTimeout as e:
        print()
        err_structured("Scan: timeout", [
            ("Code", e.code or "TIMEOUT"),
            ("Reason", e.description or str(e)),
            ("Next", f"The workflow probably continues on the Z9.\n"
                     f"Check the state with: freeglaz paper show {paper['id']}"),
        ])
        return 2
    except Z9CalibrationError as e:
        print()
        code = e.code or "?"
        reason = e.description or str(e)
        ctx_phase = (e.context or {}).get("phase")

        # Display consistency: if the firmware returns outcome=OK but
        # Phase=FAILED, the exception arrives with code="OK"/reason="Success"
        # and phase="FAILED" in the context. We override to avoid the
        # confusing message "Code: OK / Reason: Success / Phase: FAILED".
        if ctx_phase == "FAILED" and code in ("OK", "?", "", None):
            code = "WORKFLOW-FAILED"
            reason = (
                "The firmware workflow finished in Phase=FAILED. "
                "Possible causes: chart not recognized (7³ cube structure "
                "rejected, invalid 121-extras grammar), patches badly scanned "
                "(alignment, insufficient drying), CALCULATING interrupted."
            )

        fields = [
            ("Code", code, C.YELLOW),
            ("Reason", reason),
        ]
        if e.context:
            ctx_paper_name = e.context.get("paper_name") or "?"
            ctx_paper_id = e.context.get("paper_id") or "?"
            fields.append(("Paper", f"{ctx_paper_name}\n{C.DIM}{ctx_paper_id}{C.R}"))
            if ctx_phase:
                fields.append(("Phase", ctx_phase))
        # Specific hint for common SCAN_ONLY errors
        if e.code in ("INVALID-MEDIUM", "BADSIZE-MEDIUM"):
            fields.append((
                "Hint",
                "Load an A3 (or larger) sheet in MANUAL FEED "
                "(not the roll).\nThe sheet must already contain the "
                "464-patch chart printed."
            ))
        err_structured("Scan refused", fields)
        return 1
    except KeyboardInterrupt:
        print()
        warn("Keyboard interrupt")
        print(f"  {C.DIM}The scan continues on the Z9 and cannot be")
        print(f"  cancelled remotely. Come back and check with:")
        print(f"    freeglaz paper show {paper['id']}{C.R}")
        return 130
    except Z9Error as e:
        err(f"Error: {e}")
        return 1

    # Final recap
    elapsed = result["elapsed"]
    m, s = divmod(int(elapsed), 60)
    print()
    ok(f"Scan succeeded in {m}m{s:02d}s")
    print(f"  Operation ID   : {result['operation_id']}")
    print(f"  Profile name   : {C.GREEN}{result['profile_name']}{C.R}")
    print(f"  Internal ICC   : {result.get('profile_icc_name') or '?'}")
    print(f"  UUID           : {C.DIM}{result.get('profile_uuid') or '?'}{C.R}")
    print(f"  Date           : {result.get('profile_date') or '?'}")

    # Local export if requested
    if args.export:
        print()
        print(f"  {C.DIM}Exporting ICC to {args.export}...{C.R}")
        try:
            export_result = client.paper.export_icc(
                ref=paper["id"],
                output_path=args.export,
                gloss_enhancer=gloss_enhancer,
                quality=args.quality,
                color_space=args.color_space,
            )
        except Z9Error as e:
            err(f"ICC export failed: {e}")
            print(f"  {C.DIM}The profile remains available on the Z9. "
                  f"You can retry with:{C.R}")
            print(f"    {C.DIM}freeglaz paper export-icc \"{paper['name']}\" "
                  f"-o {args.export}{C.R}")
            return 1
        size_kb = export_result["size_bytes"] / 1024
        ok(f"ICC exported: {export_result['output_path']} ({size_kb:.1f} KB)")
        print(f"  MD5           : {C.DIM}{export_result.get('md5')}{C.R}")

    # Sync-on-event (#1): the scan created/changed the slot's profile →
    # forced refetch of the paper in the mirror (best-effort).
    try:
        from lib.z9_client import store as _store
        _store.refetch_paper(client, paper["id"])
    except Exception as _e:  # noqa: BLE001
        warn(f"Mirror not refreshed (targeted sync failed): {_e}")
    return 0


def cmd_paper_export_icc(args, client):
    """
    Export an ICC profile from the Z9 to a local file.

    Usage:
        freeglaz paper export-icc <paper> -o <path.icc>
        freeglaz paper export-icc "Hahnemühle Fine" -o /tmp/baryta.icc
        freeglaz paper export-icc <paper> -o file.icc --gloss-enhancer OFF
    """
    # Resolve the reference
    paper = resolve_paper_interactive(client, args.id_or_name)
    if not paper:
        return 1
    print()

    # Load the details to check the capabilities
    try:
        details = client.paper.details(paper["id"])
    except Z9Error as e:
        err(f"Cannot read the paper details: {e}")
        return 1

    capabilities = (details or {}).get("capabilities") or {}
    ge_supported = capabilities.get("GlossEnhancerSupported") == "1"

    # If the paper does not support GE and FULLPAGE is requested, force OFF
    gloss_enhancer = args.gloss_enhancer
    if not ge_supported and gloss_enhancer == "FULLPAGE":
        warn(f"The paper does not support the Gloss Enhancer. "
             f"--gloss-enhancer FULLPAGE → forced to OFF.")
        gloss_enhancer = "OFF"

    print(f"{C.BOLD}🎨 ICC Export{C.R}")
    print(f"  Paper          : {paper['name']}")
    print(f"  MediumId       : {C.DIM}{paper['id']}{C.R}")
    print(f"  Quality        : {args.quality}")
    print(f"  Gloss Enhancer : {gloss_enhancer}")
    print(f"  Color Space    : {args.color_space}")
    print(f"  Output         : {args.output}")
    print()

    try:
        result = client.paper.export_icc(
            ref=paper["id"],
            output_path=args.output,
            gloss_enhancer=gloss_enhancer,
            quality=args.quality,
            color_space=args.color_space,
        )
    except Z9Error as e:
        err(f"ICC export failed: {e}")
        return 1

    size_kb = result["size_bytes"] / 1024
    ok(f"ICC exported: {result['output_path']} ({size_kb:.1f} KB)")
    print(f"  Paper          : {result.get('paper_name')}")
    print(f"  GE             : {result.get('gloss_enhancer')}")
    print(f"  ColorSpace     : {result.get('color_space')}")
    print(f"  MD5            : {C.DIM}{result.get('md5')}{C.R}")
    return 0


def cmd_paper_import_icc(args, client):
    """
    Import an external ICC profile (X-Rite, Argyll, etc.) to the Z9.

    Uses SOAP setProfile (port 8085), not REST PIWS.

    Usage:
        freeglaz paper import-icc <paper> <path.icc>
        freeglaz paper import-icc "Photo Rag" ./HFA_HPZ9_MK_PhotoRag.icc
        freeglaz paper import-icc <paper> <path> --gloss-enhancer OFF
        freeglaz paper import-icc <paper> <path> --icc-name "My HQ Profile"
        freeglaz paper import-icc <paper> <path> -y  (skip confirmation)
    """
    import os

    # 1. Check the ICC file BEFORE any Z9 interaction
    icc_path = os.path.abspath(os.path.expanduser(args.icc_path))
    if not os.path.isfile(icc_path):
        err(f"ICC file not found: {icc_path}")
        return 1

    icc_size = os.path.getsize(icc_path)
    if icc_size < 128:
        err(f"File too small to be a valid ICC: {icc_size} bytes")
        return 1

    # Quick check of the ICC 'acsp' signature at offset 36
    with open(icc_path, "rb") as f:
        f.seek(36)
        sig = f.read(4)
    if sig != b"acsp":
        err(f"ICC 'acsp' signature missing at offset 36. "
            f"Found: {sig!r}. The file is probably not an ICC.")
        return 1

    # 2. Resolve the paper reference
    paper = resolve_paper_interactive(client, args.id_or_name)
    if not paper:
        return 1
    print()

    # 3. Load the details to check capabilities and existing profiles
    try:
        details = client.paper.details(paper["id"])
    except Z9Error as e:
        err(f"Cannot read the paper details: {e}")
        return 1

    capabilities = (details or {}).get("capabilities") or {}
    ge_supported = capabilities.get("GlossEnhancerSupported") == "1"

    # 4. Force OFF if GE not supported
    gloss_enhancer = args.gloss_enhancer
    if not ge_supported and gloss_enhancer == "FULLPAGE":
        warn(f"The paper does not support the Gloss Enhancer. "
             f"--gloss-enhancer FULLPAGE → forced to OFF.")
        gloss_enhancer = "OFF"

    # 5. Determine the profile name
    icc_name = args.icc_name
    if not icc_name:
        icc_name = os.path.splitext(os.path.basename(icc_path))[0]
        # Reasonable limit so it doesn't blow up in paper show
        if len(icc_name) > 80:
            icc_name = icc_name[:80]

    soap_cs = "PRINTER_RGB" if args.color_space == "RGB" else "PRINTER_GRAYSCALE"

    # 6. Visual recap
    print(f"{C.BOLD}📥 ICC Import{C.R}")
    print(f"  Paper          : {paper['name']}")
    print(f"  MediumId       : {C.DIM}{paper['id']}{C.R}")
    print(f"  Source         : {icc_path} ({icc_size / 1024:.1f} KB)")
    print(f"  ICC name       : {icc_name}")
    print(f"  Target GE      : {gloss_enhancer}")
    print(f"  Quality        : {args.quality}")
    print(f"  MaximumDetail  : {args.maximum_detail}")
    print(f"  ColorSpace     : {args.color_space} (SOAP: {soap_cs})")
    print()

    # 7. Detect whether a profile already exists for this Key
    existing_prof = None
    for prof in details.get("profiles") or []:
        if (prof.get("gloss_enhancer") == gloss_enhancer
                and prof.get("color_space") == soap_cs):
            existing_prof = prof
            break

    # 8. Ask for confirmation if overwriting
    if existing_prof:
        print(f"{C.YELLOW}⚠️  A profile already exists for this Key (GE={gloss_enhancer}, ColorSpace={soap_cs}):{C.R}")
        prof_type = "custom" if existing_prof.get("custom") else "factory"
        print(f"     Type  : {prof_type}")
        print(f"     Name  : {existing_prof.get('icc_name')}")
        print(f"     Date  : {existing_prof.get('date')}")
        print(f"     UUID  : {C.DIM}{existing_prof.get('uuid')}{C.R}")
        print()

        if not args.yes:
            print(f"  This import will {C.BOLD}overwrite{C.R} the existing profile.")
            reply = input(f"  Continue? [{C.BOLD}y{C.R}/N] ").strip().lower()
            if reply not in ("y", "yes", "o", "oui"):
                err("Cancelled by the user.")
                return 1
            print()

    # 9. Launch the import via SOAP setProfile
    print(f"  Sending to the Z9 (SOAP setProfile) ... ", end="", flush=True)
    try:
        result = client.paper.import_icc(
            ref=paper["id"],
            icc_path=icc_path,
            icc_name=icc_name,
            gloss_enhancer=gloss_enhancer,
            quality=args.quality,
            maximum_detail=args.maximum_detail,
            color_space=args.color_space,
            auto_backup=not args.no_backup,
        )
    except FileNotFoundError as e:
        print()
        err(f"{e}")
        return 1
    except Z9Error as e:
        print()
        err(f"ICC import failed: {e}")
        return 1

    print(f"{C.GREEN}✅{C.R}")
    print()
    ok(f"ICC imported: {result['paper_name']}")
    print(f"  Outcome        : {result['outcome']}")
    print(f"  ICC name       : {result['icc_name']}")
    print(f"  Ticket date    : {result['ticket_date']}")
    print(f"  Source MD5     : {C.DIM}{result['icc_md5']}{C.R}")
    print(f"  Size           : {result['icc_size_bytes']:,} bytes")
    if result['had_existing']:
        print(f"  {C.DIM}Previous profile (UUID={result['existing_uuid']}) overwritten{C.R}")
    # Auto backup
    if result.get("backup_path"):
        print(f"  Auto backup    : {C.DIM}{result['backup_path']}{C.R}")
        print(f"                   {C.DIM}MD5: {result['backup_md5']}{C.R}")
    elif result.get("backup_skipped_reason") and result['had_existing']:
        warn(f"Automatic backup failed: {result['backup_skipped_reason']}")
    print()
    print(f"💡 Check with:  {C.DIM}freeglaz paper show \"{result['paper_name']}\"{C.R}")
    if result.get("backup_path"):
        print(f"💡 Rollback:    {C.DIM}freeglaz paper import-icc {result['paper_name']!r} \\")
        print(f"                              {result['backup_path']} --gloss-enhancer {result['gloss_enhancer']}{C.R}")
    # Sync-on-event (#1): import-icc (set_profile) replaced the slot's profile
    # → the getMediumListVersion gate is blind → we refresh the mirror cache
    # of THIS paper by FORCING. Best-effort (does not fail the import).
    try:
        from lib.z9_client import store as _store
        _store.refetch_paper(client, paper["id"])
        print(f"  {C.DIM}Local mirror refreshed (targeted sync).{C.R}")
    except Exception as _e:  # noqa: BLE001
        warn(f"Mirror not refreshed (targeted sync failed): {_e}")
    return 0


def cmd_paper_restore_icc(args, client):
    """
    Restore the factory profile of a slot of a custom paper.

    Firmware mechanism: the slot's custom profile (GE, ColorSpace) is deleted,
    and the firmware automatically re-exposes the R&D donor factory profile of
    the paper that was stored underneath.

    Usage:
        freeglaz paper restore-icc <paper>
        freeglaz paper restore-icc "Canson Baryta" --gloss-enhancer OFF
        freeglaz paper restore-icc <paper> -y  (skip confirmation)
    """
    # 1. Resolve the paper reference
    paper = resolve_paper_interactive(client, args.id_or_name)
    if not paper:
        return 1
    print()

    # 2. Check that it is indeed a custom paper
    if not paper.get("is_user_custom", False):
        err(f"{paper['name']!r} is a factory paper (HP). "
            f"restore-icc only applies to custom papers.")
        return 1

    # 3. Load the details (capabilities + profile list)
    try:
        details = client.paper.details(paper["id"])
    except Z9Error as e:
        err(f"Cannot read the paper details: {e}")
        return 1

    if details is None:
        err(f"Paper {paper['id']} not found in getMediumList SOAP")
        return 1

    capabilities = (details or {}).get("capabilities") or {}
    ge_supported = capabilities.get("GlossEnhancerSupported") == "1"
    profiles = details.get("profiles") or []

    # 4. List the existing CUSTOM profiles (those that can be restored)
    custom_profiles = [
        p for p in profiles
        if p.get("custom")  # SOAP attribute custom="1" = restorable user-created profile
    ]

    soap_cs = "PRINTER_RGB" if args.color_space == "RGB" else "PRINTER_GRAYSCALE"

    # 5. Resolve the target GE
    gloss_enhancer = args.gloss_enhancer
    if gloss_enhancer is None:
        # Not specified on CLI → auto-detection
        if not ge_supported:
            # Single-slot paper: GE forced to OFF
            gloss_enhancer = "OFF"
        else:
            # Paper that supports GE: we look at the available customs
            # for this ColorSpace
            customs_for_cs = [
                p for p in custom_profiles
                if p.get("color_space") == soap_cs
            ]
            if not customs_for_cs:
                err(f"No custom profile to restore for this paper "
                    f"(ColorSpace={soap_cs}).")
                if profiles:
                    print(f"\n  Existing profiles:", file=sys.stderr)
                    for p in profiles:
                        t = "custom" if p.get("custom") else "factory"
                        print(f"    - [{t}] GE={p.get('gloss_enhancer')} "
                              f"ColorSpace={p.get('color_space')} : "
                              f"{p.get('icc_name')}", file=sys.stderr)
                return 1
            elif len(customs_for_cs) == 1:
                # A single custom slot → obvious choice
                gloss_enhancer = customs_for_cs[0].get("gloss_enhancer")
                print(f"  {C.DIM}A single custom slot available: "
                      f"GE={gloss_enhancer}.{C.R}")
                print()
            else:
                # Multiple custom slots → ask the user
                if not sys.stdin.isatty():
                    err("--gloss-enhancer required: multiple custom slots "
                        "available (values: FULLPAGE | OFF)")
                    return 1
                print(f"{C.BOLD}Which slot to restore?{C.R}")
                for i, p in enumerate(customs_for_cs, 1):
                    ge = p.get("gloss_enhancer")
                    print(f"  {C.GREEN}{i}{C.R}. GE={ge}  "
                          f"{C.DIM}({p.get('icc_name')}){C.R}")
                try:
                    choice = input(f"Choice [1-{len(customs_for_cs)}]: ").strip()
                except EOFError:
                    return 1
                if not choice.isdigit() or not (1 <= int(choice) <= len(customs_for_cs)):
                    err(f"Invalid choice: {choice}")
                    return 1
                gloss_enhancer = customs_for_cs[int(choice) - 1].get("gloss_enhancer")
                print()
    else:
        # GE explicitly specified by the user: validate compatibility
        if gloss_enhancer == "FULLPAGE" and not ge_supported:
            err(f"The paper '{paper['name']}' does not support the Gloss "
                f"Enhancer (GlossEnhancerSupported=0).")
            print(f"  {C.DIM}Use --gloss-enhancer OFF for this paper.{C.R}",
                  file=sys.stderr)
            return 1

    # 6. Find the profile currently in the target slot
    current_prof = None
    for prof in profiles:
        if (prof.get("gloss_enhancer") == gloss_enhancer
                and prof.get("color_space") == soap_cs):
            current_prof = prof
            break

    # 7. Resolve the donor for info
    donor_id = details.get("donor_id") or paper.get("donor_id")
    donor_name = None
    if donor_id:
        try:
            donor = client.paper.get(donor_id)
            donor_name = donor["name"] if donor else None
        except Z9Error:
            pass

    # 8. Visual recap
    print(f"{C.BOLD}🔄 Restore Factory Profile{C.R}")
    print(f"  Paper          : {paper['name']}")
    print(f"  MediumId       : {C.DIM}{paper['id']}{C.R}")
    if donor_id:
        donor_str = f"{donor_id}"
        if donor_name:
            donor_str += f" ({donor_name})"
        print(f"  Donor          : {donor_str}")
    print(f"  Gloss Enhancer : {gloss_enhancer}")
    print(f"  Color Space    : {args.color_space} (SOAP: {soap_cs})")
    print()

    # 9. Warn and ask for confirmation
    if current_prof:
        prof_type = "custom" if current_prof.get("custom") else "factory"
        type_color = C.YELLOW if prof_type == "custom" else C.DIM
        print(f"  Current profile in the slot:")
        print(f"     Type  : {type_color}{prof_type}{C.R}")
        print(f"     Name  : {current_prof.get('icc_name')}")
        print(f"     Date  : {current_prof.get('date')}")
        print(f"     UUID  : {C.DIM}{current_prof.get('uuid')}{C.R}")
        print()

        if prof_type == "factory":
            print(f"  {C.DIM}The slot already contains a factory profile.{C.R}")
            print(f"  The deletion will expose the R&D donor factory profile")
            print(f"  of the HP donor underneath (if it exists).")
        else:
            print(f"  {C.BOLD}The custom profile will be deleted.{C.R}")
            print(f"  The firmware will automatically re-expose the R&D donor")
            print(f"  factory profile stored underneath.")
        print()
    else:
        print(f"  {C.YELLOW}⚠️  No profile is currently exposed in the slot")
        print(f"  (GE={gloss_enhancer}, ColorSpace={soap_cs}).{C.R}")
        print(f"  The operation probably has no effect or will return an error.")
        print()

    if not args.yes:
        reply = input(f"  Continue? [{C.BOLD}y{C.R}/N] ").strip().lower()
        if reply not in ("y", "yes", "o", "oui"):
            err("Cancelled by the user.")
            return 1
        print()

    # 10. SOAP deleteProfile call
    print(f"  SOAP deleteProfile ... ", end="", flush=True)
    try:
        result = client.paper.restore_icc(
            ref=paper["id"],
            gloss_enhancer=gloss_enhancer,
            color_space=args.color_space,
        )
    except Z9Error as e:
        print()
        err(f"Restore ICC failed: {e}")
        return 1

    print(f"{C.GREEN}✅{C.R}")
    print()
    ok(f"Factory profile restored: {result['paper_name']}")
    print(f"  Outcome        : {result['outcome']}")
    print(f"  Slot           : GE={result['gloss_enhancer']}, ColorSpace={result['color_space']}")
    if result.get("deleted_uuid"):
        print(f"  Deleted profile:")
        print(f"     Name : {result['deleted_icc_name']}")
        print(f"     UUID : {C.DIM}{result['deleted_uuid']}{C.R}")
    print()
    print(f"💡 Check with:  {C.DIM}freeglaz paper show \"{result['paper_name']}\"{C.R}")
    return 0


def cmd_paper_donor_export(args, client):
    """
    Extract the R&D donor factory profile of a custom paper and cache it.

    Non-destructive strategy: prefers to extract from a pure factory slot
    if available (any GE). The colorimetric content is identical between the
    GE FULLPAGE and GE OFF slots — a single export per paper is enough.

    Usage:
        freeglaz paper donor-export <paper>
        freeglaz paper donor-export "Canson Baryta"
    """
    from lib.z9_client import cache, store

    # 1. Resolve the paper
    paper = resolve_paper_interactive(client, args.id_or_name)
    if not paper:
        return 1
    print()

    if not paper.get("is_user_custom", False):
        err(f"{paper['name']!r} is a factory paper (HP). "
            f"donor-export only applies to custom papers.")
        return 1

    # 2. Resolve the donor for display
    donor_id = paper.get("donor_id")
    donor_name = None
    if donor_id:
        try:
            d = client.paper.get(donor_id)
            donor_name = d["name"] if d else None
        except Z9Error:
            pass

    serial = store.get_serial(client)
    print(f"{C.BOLD}🔍 R&D donor extraction{C.R}")
    print(f"  Paper  : {paper['name']}")
    if donor_id:
        donor_str = donor_id + (f" ({donor_name})" if donor_name else "")
        print(f"  Donor  : {donor_str}")
    print(f"  Mirror : {cache.donor_path(paper['name'], serial)}")
    print()

    # 3. Process-tracing callback
    def on_step(n, total, label, **details):
        if label == "lecture-profils":
            print(f"  [{n}/{total}] Reading slot profiles (SOAP getMediumList) ...")
        elif label == "selection-slot":
            slot = details.get("slot_chosen")
            uuid = details.get("factory_uuid") or "?"
            icc_name = details.get("factory_icc_name") or "?"
            date = details.get("factory_date") or "?"
            has_custom = details.get("has_custom_other_slot")
            print(f"        Factory slot found: GE={slot}")
            print(f"          UUID : {C.DIM}{uuid}{C.R}")
            print(f"          Name : {icc_name}")
            print(f"          Date : {date}")
            if has_custom:
                cu = details.get("custom_icc_name") or "?"
                print(f"        {C.DIM}Note: a user custom profile exists in the other slot")
                print(f"               ({cu}) — not modified{C.R}")
            print()
            print(f"  [{n}/{total}] Choice: extraction from this factory slot")
            print(f"        {C.DIM}(the colorimetric content is identical between GEs){C.R}")
        elif label == "cache-hit":
            print()
            print(f"  [{n}/{total}] ✓ Cache already up to date for this paper")
            print(f"        File    : {details.get('cache_path')}")
            print(f"        Size    : {details.get('size_bytes'):,} bytes")
            print(f"        MD5     : {C.DIM}{details.get('md5')}{C.R}")
        elif label == "extraction":
            print()
            print(f"  [{n}/{total}] SOAP getProfile export (GE={details.get('gloss_enhancer')}, "
                  f"ColorSpace={details.get('color_space')}) ...")

    # 4. Launch the extraction
    try:
        result = client.paper.donor_export(
            ref=paper["id"],
            color_space=args.color_space,
            on_step=on_step,
        )
    except Z9PaperError as e:
        print()
        err(f"{e}")
        return 1
    except Z9Error as e:
        print()
        err(f"Export failed: {e}")
        return 1

    print()
    if result.get("skipped"):
        ok(f"Donor already in cache (integrity validated)")
    else:
        ok(f"R&D donor extracted successfully")
        size_kb = result["icc_size_bytes"] / 1024
        print(f"  Size        : {result['icc_size_bytes']:,} bytes ({size_kb:.1f} KB)")
        print(f"  MD5         : {C.DIM}{result['icc_md5']}{C.R}")
        print(f"  Source slot : GE={result['gloss_enhancer_extracted_from']}")
    print(f"  File        : {result['icc_path']}")
    print()
    print(f"💡 This donor can be reused for all future profiling sessions")
    print(f"   of the paper {result['paper_name']!r}.")
    return 0


